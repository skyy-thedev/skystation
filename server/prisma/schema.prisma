// SkyStation — banco do servidor (SkyCloud + SkyNetwork).
// Datas sempre em UTC. Depois de mudar este arquivo: npm run db:nova-migracao

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Um console físico (pendrive do SkyStation). O token fica só no console; aqui só o hash.
model Console {
  id             String   @id @default(cuid())
  nome           String
  tokenHash      String   @unique
  criadoEm       DateTime @default(now())
  vistoEm        DateTime?
  // limite de requisições por minuto (janela simples)
  janelaInicio   DateTime @default(now())
  janelaContagem Int      @default(0)

  perfis   Perfil[]
  versoes  SaveVersao[]
  vinculos Vinculo[]
}

/// Um jogador. Nasce num console (p1..p4, do sky-perfis) ou no site (sem console).
/// Com `usuario` e senha vira uma CONTA: entra no site e em qualquer console, e sobrevive à troca
/// ou perda do pendrive (o console some, a conta e os saves ficam).
model Perfil {
  id        String   @id @default(cuid())
  consoleId String?
  console   Console? @relation(fields: [consoleId], references: [id], onDelete: SetNull)
  localId   String?  // "p1", "p2"… o id do perfil dentro do console de origem
  apelido   String
  cor       String   @default("#4fd1ff")
  invisivel Boolean  @default(false)
  codigo    String   @unique // 6 letras/números para adicionar como amigo
  criadoEm  DateTime @default(now())
  // código temporário (15 min) para usar este perfil em outro console; aqui só o hash
  vinculoHash   String?   @unique
  vinculoExpira DateTime?
  // conta pessoal (Fase 10.5)
  usuario       String?   @unique // ID SkyNetwork: 3 a 16 letras minúsculas, números ou _
  senhaHash     String?   // scrypt
  avatar        String    @default("estrela") // um dos ícones do SkyStation (avatares.json)
  bio           String    @default("")
  visibilidade  String    @default("amigos") // publico | amigos | privado (perfil no site)
  falhasLogin   Int       @default(0)
  bloqueadoAte  DateTime?

  saves     Save[]
  presenca  Presenca?
  enviadas  Mensagem[]    @relation("de")
  recebidas Mensagem[]    @relation("para")
  amizadesA Amizade[]     @relation("a")
  amizadesB Amizade[]     @relation("b")
  trofeus   TrofeuGanho[]
  vinculos  Vinculo[]
  sessoes   Sessao[]
  // 13.26: social (jogos jogados, capturas publicadas, curtidas e comentários)
  jogos       JogoJogado[]
  posts       Post[]
  curtidas    Curtida[]
  comentarios Comentario[]

  @@unique([consoleId, localId])
}

/// Sessão do site (cookie). O banco guarda só o hash do token.
model Sessao {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  criadaEm  DateTime @default(now())
  expira    DateTime

  @@index([perfilId])
}

/// "Neste console, o perfil local p2 é o jogador X (que nasceu em outro console)."
/// É o que permite continuar o mesmo save em dois consoles e recuperar tudo num pendrive novo.
model Vinculo {
  id        String   @id @default(cuid())
  consoleId String
  console   Console  @relation(fields: [consoleId], references: [id], onDelete: Cascade)
  localId   String
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([consoleId, localId])
  @@index([perfilId])
}

// ---------------------------------------------------------------- SkyCloud (Fase 9.4)

/// O save de UM jogo de UM perfil (nunca o cartão de memória inteiro).
model Save {
  id           String   @id @default(cuid())
  perfilId     String
  perfil       Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  sistema      String   // ps1, ps2, ps3, x360…
  jogoId       String   // o mesmo id que o sky-run usa
  titulo       String?
  versaoAtual  Int      @default(0) // 0 = ainda não há nada na nuvem
  atualizadoEm DateTime @default(now())

  versoes SaveVersao[]

  @@unique([perfilId, sistema, jogoId])
}

/// Cada envio vira uma versão; as 5 últimas confirmadas ficam guardadas.
model SaveVersao {
  id         String   @id @default(cuid())
  saveId     String
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  numero     Int
  hash       String   // sha256 do conteúdo, calculado no console
  tamanho    Int      // bytes
  chave      String   // caminho do arquivo no armazenamento (S3/R2)
  consoleId  String?
  console    Console? @relation(fields: [consoleId], references: [id], onDelete: SetNull)
  confirmada Boolean  @default(false) // vira true quando o arquivo chegou inteiro
  criadaEm   DateTime @default(now())

  @@unique([saveId, numero])
  @@index([confirmada, criadaEm])
}

// ---------------------------------------------------------------- SkyNetwork (Fase 10)

model Amizade {
  id       String   @id @default(cuid())
  aId      String   // quem pediu
  bId      String   // quem recebeu o pedido
  a        Perfil   @relation("a", fields: [aId], references: [id], onDelete: Cascade)
  b        Perfil   @relation("b", fields: [bId], references: [id], onDelete: Cascade)
  status   String   @default("pendente") // pendente | aceita
  criadaEm DateTime @default(now())

  @@unique([aId, bId])
  @@index([bId])
}

model Presenca {
  perfilId String   @id
  perfil   Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  status   String   // online | jogando | ausente
  jogoId   String?
  jogo     String?
  sistema  String?
  desde    DateTime @default(now()) // quando este status/jogo começou
  vistoEm  DateTime @default(now()) // último sinal; sem sinal há 90 s = offline
}

model Mensagem {
  id        String    @id @default(cuid())
  deId      String
  paraId    String
  de        Perfil    @relation("de", fields: [deId], references: [id], onDelete: Cascade)
  para      Perfil    @relation("para", fields: [paraId], references: [id], onDelete: Cascade)
  tipo      String    @default("texto") // texto | convite | netplay
  texto     String    // até 280 caracteres
  // só nos convites: o jogo para o qual está chamando
  jogoId    String?
  jogo      String?
  sistema   String?
  // só no convite "netplay" (Fase 11.4): a sala do RetroArch no servidor de retransmissão
  // { ip, porta, sessao, senha, crc, core } — quem recebe entra direto, sem digitar nada
  sala      Json?
  enviadaEm DateTime  @default(now())
  lidaEm    DateTime?

  @@index([paraId, enviadaEm])
  @@index([deId, enviadaEm])
}

model TrofeuGanho {
  id       String   @id @default(cuid())
  perfilId String
  perfil   Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  jogoId   String   @default("skystation") // "skystation" = troféus do próprio console
  jogo     String?
  trofeu   String   // id do troféu
  nome     String?  // nome que aparece na tela
  tipo     String   // bronze | prata | ouro | platina
  ganhoEm  DateTime @default(now())
  criadoEm DateTime @default(now())

  @@unique([perfilId, jogoId, trofeu])
  @@index([criadoEm])
}

/// SkyStore (Fase 12): um app, jogo, tema ou emulador que o console pode baixar.
/// Os arquivos ficam no armazenamento (R2); aqui só os dados e a assinatura de cada versão.
model LojaItem {
  id           String       @id @default(cuid())
  slug         String       @unique // sky-tema-noite, objeto-7… (vira o nome da pasta no console)
  tipo         String       // app | jogo | tema | emulador
  nome         String
  resumo       String       @default("") // uma linha, para a vitrine
  descricao    String       @default("")
  autor        String       @default("SkyStation")
  oficial      Boolean      @default(false) // feito pela SkyStation (selo na vitrine)
  capa         String?      // endereço da imagem
  publicado    Boolean      @default(false) // aparece na vitrine
  downloads    Int          @default(0)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  versoes LojaVersao[]
}

/// Uma versão de um item: o pacote assinado com a chave da SkyStore (Ed25519, guardada só no PC do Sky).
model LojaVersao {
  id         String   @id @default(cuid())
  itemId     String
  item       LojaItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versao     String   // 1.0.0
  notas      String   @default("") // o que mudou
  chave      String   // caminho no armazenamento
  tamanho    BigInt
  sha256     String
  assinatura String   // Ed25519 de "skystation-loja-v1\nslug\nversao\nsha256\ntamanho", em base64
  enviada    Boolean  @default(false) // o arquivo chegou ao armazenamento e foi conferido
  publicada  Boolean  @default(false) // os consoles podem baixar
  criadaEm   DateTime @default(now())

  @@unique([itemId, versao])
  @@index([itemId, criadaEm])
}

/// 13.26: os jogos que o perfil já jogou (o console manda o tempo.json): amigos veem "jogou recentemente".
model JogoJogado {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  jogoId    String   // o mesmo id que o sky-run usa (ps2-SLUS21447…)
  titulo    String
  sistema   String?
  segundos  Int      @default(0)
  partidas  Int      @default(0)
  ultimaVez DateTime

  @@unique([perfilId, jogoId])
  @@index([perfilId, ultimaVez])
}

/// 13.26: captura de tela publicada (a imagem fica no armazenamento, como os saves).
model Post {
  id          String       @id @default(cuid())
  perfilId    String
  perfil      Perfil       @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  legenda     String       @default("")
  jogoId      String?
  jogo        String?
  sistema     String?
  chave       String       // caminho da imagem no armazenamento
  tipo        String       @default("image/jpeg")
  tamanho     Int
  confirmado  Boolean      @default(false) // vira true quando a imagem chegou inteira
  criadoEm    DateTime     @default(now())
  curtidas    Curtida[]
  comentarios Comentario[]

  @@index([perfilId, criadoEm])
  @@index([criadoEm])
}

model Curtida {
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  perfilId String
  perfil   Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  criadaEm DateTime @default(now())

  @@id([postId, perfilId])
}

model Comentario {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  perfilId String
  perfil   Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  texto    String   // até 280 caracteres
  criadoEm DateTime @default(now())

  @@index([postId, criadoEm])
}
