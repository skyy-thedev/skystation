{
  "name": "skynetwork",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do SkyStation: SkyCloud (saves na nuvem) e SkyNetwork (amigos, presença, mensagens, troféus).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "tipos": "tsc --noEmit",
    "db:migrar": "prisma migrate deploy",
    "db:nova-migracao": "prisma migrate dev",
    "teste": "node scripts/teste.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
