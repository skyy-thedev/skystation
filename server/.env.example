# Copie para .env (local) ou cadastre na Vercel (Settings → Environment Variables).

# Postgres. Na Vercel, a integração Neon preenche DATABASE_URL e DATABASE_URL_UNPOOLED sozinha.
DATABASE_URL="postgresql://usuario:senha@host/skynetwork?sslmode=require"

# Código de convite: só quem sabe consegue registrar um console. Invente um e passe aos amigos.
SKY_CONVITE="troque-por-um-codigo-seu"
# Quantos consoles podem existir no total (trava de segurança).
SKY_MAX_CONSOLES="8"

# Armazenamento dos saves (qualquer serviço compatível com S3; recomendado: Cloudflare R2).
S3_ENDPOINT="https://<id-da-conta>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="skycloud"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Tamanho máximo de um save, em MB.
SKY_SAVE_MAX_MB="64"

# Protege a rota de limpeza diária (a Vercel envia este valor sozinha nos crons).
CRON_SECRET="troque-por-um-texto-longo-e-aleatorio"
