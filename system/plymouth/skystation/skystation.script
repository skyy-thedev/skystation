# SkyStation: tela de boot (Plymouth, linguagem "script").
# Fundo azul-noite (o mesmo do launcher, para a troca ser imperceptível),
# logo pulsando suavemente e três pontos de "carregando".

Window.SetBackgroundTopColor(0.024, 0.035, 0.094);
Window.SetBackgroundBottomColor(0.063, 0.086, 0.204);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20;
logo.sprite.SetPosition(logo.x, logo.y, 1);

dot.image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot.image);
    dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 - 40 + i * 34,
                        logo.y + logo.image.GetHeight() + 30, 2);
}

t = 0;
fun refresh_callback () {
    t++;
    logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(t / 25));
    for (i = 0; i < 3; i++) {
        dots[i].SetOpacity(0.25 + 0.75 * Math.Max(0, Math.Sin(t / 10 - i * 0.9)));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Sem caixas de senha/mensagem: o SkyStation não usa disco criptografado.
fun message_callback (text) { }
Plymouth.SetMessageFunction(message_callback);
