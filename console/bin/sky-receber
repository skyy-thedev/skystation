#!/usr/bin/env python3
"""SkyStation: Central web (antes "receber jogos pelo Wi-Fi").

Uma página na rede local (porta 8080). Desde a Fase 7.0 ela fica ligada em segundo plano: você
navega no console e joga enquanto envia jogos ou usa o teclado do celular. Liga/desliga em
Sistema → Central web; ligada, volta sozinha a cada boot com o mesmo PIN (6 dígitos).
No PC ou no celular, acesse o endereço que aparece na TV e digite o PIN. Abas:
  Enviar     arraste jogos (.cue + .bin, .chd, .iso…), capas e a BIOS do PS2
  Jogos      biblioteca com capa, tamanho e onde está; mover console ⇄ SKYROMS; apagar
  Capturas   ver e baixar as capturas de tela
  Saves      backup dos saves (cartões de memória) e, se quiser, dos estados salvos (.zip)

Uso:
  sky-receber ligar      liga (PIN novo se estava desligada), sobe o serviço e imprime o estado (JSON)
  sky-receber desligar   desliga e encerra o serviço
  sky-receber estado     {"ligada", "ativa", "ip", "porta", "pin", "qr", "recebendo", "log"}
  sky-receber servir     o serviço em si (aberto pelo sky-shell no início da sessão; sai se desligada)
O serviço mantém $XDG_RUNTIME_DIR/skystation/central.json (a tela do console lê daí) e manda avisos
para events.jsonl (jogo recebido, PIN errado), que aparecem no menu mesmo com a tela fechada.
"""
import base64
import hmac
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8080
PIN = "000000"
HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config/skystation/central.json")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skystation")
STATUS = os.path.join(RUN, "central.json")
EVENTS = os.path.join(RUN, "events.jsonl")
STATE = {"ip": "", "qr": [], "recebendo": "", "log": []}
DESTS = {"interno": os.path.join(HOME, "skystation/roms"), "skyroms": "/mnt/skyroms"}
EXTS = {"ps1": {"cue", "bin", "chd", "pbp", "m3u", "iso", "img", "png", "jpg"},
        "ps2": {"iso", "chd", "cso", "gz", "png", "jpg"},
        "ps3": {"iso", "pkg", "rap", "png", "jpg"}, "ps3fw": {"pup"},
        "psp": {"iso", "cso", "png", "jpg"},
        "snes": {"sfc", "smc", "png", "jpg"}, "n64": {"z64", "n64", "v64", "png", "jpg"},
        "bios": {"bin", "rom0", "rom1", "rom2", "erom", "nvm", "mec"}}
NOVOS = {'gc': ['iso', 'gcm', 'rvz', 'gcz', 'ciso'], 'wii': ['iso', 'wbfs', 'rvz', 'gcz', 'ciso', 'wad'], 'x360': ['iso', 'zar', 'xex'], 'nds': ['nds', 'dsi'], '3ds': ['3ds', 'cci', 'cxi', '3dsx'], 'gba': ['gba'], 'gb': ['gb', 'gbc'], 'nes': ['nes'], 'md': ['md', 'gen', 'smd', 'bin']}   # Fase 7.1
for _s, _e in NOVOS.items():
    EXTS[_s] = set(_e) | {"png", "jpg"}
BIOS_DIR = os.path.join(HOME, "skystation/bios/ps2")
PS3FW_DIR = os.path.join(HOME, "skystation/bios/ps3")
SHOTS = os.path.join(HOME, "skystation/capturas")
SAVES = os.path.join(HOME, "skystation/saves")
STATES = os.path.join(HOME, "skystation/states")
GAME_EXTS = {"ps1": {"cue", "chd", "pbp", "m3u", "iso", "img"}, "ps2": {"iso", "chd", "cso", "gz"},
             "ps3": {"iso"}, "psp": {"iso", "cso"}, "snes": {"sfc", "smc"}, "n64": {"z64", "n64", "v64"}}
for _s, _e in NOVOS.items():
    GAME_EXTS[_s] = set(_e)
BIN = os.path.dirname(os.path.realpath(__file__))
LOCK = threading.Lock()
FAILS = {}          # ip -> [erros seguidos, bloqueado até (relógio monotônico)]


def _jogos_mod():
    import importlib.machinery
    return importlib.machinery.SourceFileLoader("sky_jogos", os.path.join(BIN, "sky-jogos")).load_module()


JOGOS = _jogos_mod()


def _backup_mod():
    import importlib.machinery
    return importlib.machinery.SourceFileLoader("sky_backup", os.path.join(BIN, "sky-backup")).load_module()


BACKUP = _backup_mod()


def _ps3_mod():
    import importlib.machinery
    try:
        return importlib.machinery.SourceFileLoader("sky_ps3", os.path.join(BIN, "sky-ps3")).load_module()
    except (OSError, ImportError, SyntaxError):
        return None


PS3 = _ps3_mod()


def game_id(dest, sys_id, fname):
    return base64.urlsafe_b64encode(f"{dest}|{sys_id}|{fname}".encode()).decode().rstrip("=")


def game_path(gid):
    """id -> caminho do jogo, só se estiver mesmo dentro de uma pasta de jogos."""
    try:
        raw = base64.urlsafe_b64decode(gid + "=" * (-len(gid) % 4)).decode()
        dest, sys_id, fname = raw.split("|", 2)
    except (ValueError, UnicodeDecodeError):
        return None
    if dest not in DESTS or sys_id not in GAME_EXTS or os.path.basename(fname) != fname or fname.startswith("."):
        return None
    path = os.path.join(DESTS[dest], sys_id, fname)
    if sys_id == "ps3" and fname != "covers" and os.path.isdir(path):
        return path
    return path if os.path.isfile(path) else None


def list_games():
    games = []
    for dest, base in DESTS.items():
        if dest == "skyroms" and not skyroms_ok():
            continue
        for sys_id, exts in GAME_EXTS.items():
            folder = os.path.join(base, sys_id)
            try:
                names = sorted(os.listdir(folder), key=str.lower)
            except OSError:
                continue
            lower = {n.lower() for n in names}
            for n in names:
                if sys_id == "ps3":          # PS3: pasta do disco ou .iso; nome e ícone vêm do próprio jogo
                    path = os.path.join(folder, n)
                    info = PS3.game_info(path) if PS3 and not n.startswith(".") and n != "covers" else None
                    if info:
                        files = JOGOS.game_files(path)
                        games.append({"id": game_id(dest, sys_id, n), "sistema": sys_id, "arquivo": n, "nome": info["titulo"],
                                      "onde": dest, "tamanho": sum(os.path.getsize(f) for f in files if os.path.isfile(f)),
                                      "formato": info["formato"], "capa": bool(info["capa"])})
                    continue
                ext = n.rsplit(".", 1)[-1].lower() if "." in n else ""
                if ext not in exts or n.endswith(".parcial"):
                    continue
                if ext == "bin" and (n.rsplit(".", 1)[0] + ".cue").lower() in lower:
                    continue
                path = os.path.join(folder, n)
                files = JOGOS.game_files(path)
                size = sum(os.path.getsize(f) for f in files if not f.lower().endswith((".png", ".jpg")))
                stem = n.rsplit(".", 1)[0]
                games.append({"id": game_id(dest, sys_id, n), "sistema": sys_id, "arquivo": n,
                              "nome": re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", stem).strip() or stem,
                              "onde": dest, "tamanho": size, "formato": ext.upper(),
                              "capa": any(f.lower().endswith((".png", ".jpg")) for f in files)})
    return games


def space():
    out = {}
    for dest, base in DESTS.items():
        if dest == "skyroms" and not skyroms_ok():
            continue
        try:
            u = shutil.disk_usage(base if os.path.isdir(base) else HOME)
            out[dest] = {"livre": u.free, "total": u.total}
        except OSError:
            pass
    return out


def lan_ip():
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))   # não envia nada: só descobre a interface de saída
        return s.getsockname()[0]
    except OSError:
        return ""
    finally:
        s.close()


def qr_rows():
    """QR code do endereço com o PIN embutido (linhas de 0/1), ou [] sem rede/sem a biblioteca."""
    ip = lan_ip()
    if not ip:
        return []
    try:
        import qrcode
        q = qrcode.QRCode(border=0, error_correction=qrcode.constants.ERROR_CORRECT_M)
        q.add_data(f"http://{ip}:{PORT}/?pin={PIN}")
        q.make(fit=True)
        return ["".join("1" if c else "0" for c in row) for row in q.get_matrix()]
    except Exception:
        return []


# Teclado pelo celular (Fase 6.2): o texto é digitado no console pelo wtype (teclado virtual do Wayland).
TECLAS = {"enter": ["-k", "Return"], "apagar": ["-k", "BackSpace"], "tab": ["-k", "Tab"], "esc": ["-k", "Escape"],
          "cima": ["-k", "Up"], "baixo": ["-k", "Down"], "esquerda": ["-k", "Left"], "direita": ["-k", "Right"],
          "ctrl-c": ["-M", "ctrl", "c", "-m", "ctrl"], "ctrl-d": ["-M", "ctrl", "d", "-m", "ctrl"]}


def teclar(q):
    if not shutil.which("wtype"):
        return {"ok": False, "error": "falta o wtype no console: rode a Fase 6.2"}
    if q.get("tecla"):
        args = TECLAS.get(q["tecla"])
        if not args:
            return {"ok": False, "error": "tecla desconhecida"}
    else:
        texto = q.get("texto", "")[:500]
        if not texto:
            return {"ok": False, "error": "nada para digitar"}
        args = ["--", texto]
    try:
        r = subprocess.run(["wtype", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        return {"ok": False, "error": str(e)}
    return {"ok": r.returncode == 0, "error": r.stderr.strip()[:200]}


def acao(texto):
    emit({"evento": "acao", "texto": texto})


def load_cfg():
    try:
        with open(CFG) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_cfg(d):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    fd = os.open(CFG + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(d, f)
    os.replace(CFG + ".tmp", CFG)


def write_status():
    """Estado para a tela do console (arquivo na RAM, troca atômica)."""
    try:
        os.makedirs(RUN, exist_ok=True)
        fd = os.open(STATUS + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(dict(STATE, pid=os.getpid(), porta=PORT, pin=PIN), f, ensure_ascii=False)
        os.replace(STATUS + ".tmp", STATUS)
    except OSError:
        pass


def aviso(kind, text):
    """Aviso no menu do console (mesmo arquivo que o sky-notify usa)."""
    try:
        with open(EVENTS, "a") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, "text": text}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def emit(obj):
    """Registra o que aconteceu: linha no histórico da tela, aviso no menu e central.json."""
    ev = obj.get("evento", "")
    nome = str(obj.get("nome", ""))
    with LOCK:
        line = ""
        if ev == "recebendo":
            STATE["recebendo"] = "%s  %d%%" % (nome, int(float(obj.get("p", 0)) * 100))
            if obj.get("v"):
                STATE["recebendo"] += "  ·  %.1f MB/s" % (obj["v"] / 1e6)
        elif ev == "recebido":
            STATE["recebendo"] = ""
            extra = {"bios": "  → BIOS do PS2 instalada", "ps3fw": "  → firmware do PS3 guardado"}.get(obj.get("sistema", ""), "")
            if obj.get("destino") == "skyroms":
                extra = "  → SKYROMS"
            line = "✓ " + nome + extra
            if not obj.get("silencio"):
                aviso("central", "Recebido: " + nome)
                aviso("jogos", "")
        elif ev == "erro":
            STATE["recebendo"] = ""
            line = "✗ " + nome + ": " + str(obj.get("erro", ""))
        elif ev == "acao":
            line = "✓ " + str(obj.get("texto", ""))
            aviso("jogos", "")
        elif ev == "pin_errado":
            line = "✗ PIN errado digitado em " + str(obj.get("ip", "?"))
            if obj.get("bloqueado"):
                aviso("central", "Central web: PIN errado várias vezes (%s). Acesso pausado." % obj.get("ip", "?"))
        if line:
            STATE["log"] = ([time.strftime("%H:%M  ") + line] + STATE["log"])[:6]
        write_status()


def skyroms_ok():
    try:
        with open("/proc/mounts") as f:
            return any(len(l.split()) > 1 and l.split()[1] == "/mnt/skyroms" for l in f)
    except OSError:
        return False


