</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "SkyStation"

    def log_message(self, *a):
        pass

    def reply(self, code, body, ctype="application/json; charset=utf-8"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def authed(self, q):
        """PIN no cabeçalho X-Pin (páginas) ou em ?pin= (imagens e downloads)."""
        ip = self.client_address[0]
        now = time.monotonic()
        with LOCK:
            f = FAILS.setdefault(ip, [0, 0.0])
            wait = f[1] - now
        if wait > 0:      # freia quem tenta adivinhar o PIN: nem confere enquanto estiver bloqueado
            self.reply(429, json.dumps({"ok": False, "error": "Muitas tentativas. Aguarde %d s." % (int(wait) + 1)}, ensure_ascii=False))
            return False
        got = self.headers.get("X-Pin", "") or q.get("pin", "")
        if not got:
            self.reply(403, json.dumps({"ok": False, "error": "Digite o PIN"}))
            return False
        if hmac.compare_digest(got.encode(), PIN.encode()):
            f[0] = 0
            return True
        with LOCK:
            f[0] += 1
            blocked = f[0] % 5 == 0
            if blocked:   # 5 erros: 1 min; 10: 2 min; 15: 4 min… até 15 min
                f[1] = now + min(900, 60 * 2 ** (f[0] // 5 - 1))
        if f[0] == 1 or blocked:
            emit({"evento": "pin_errado", "ip": ip, "bloqueado": blocked})
        self.reply(403, json.dumps({"ok": False, "error": "PIN errado"}))
        return False

    def send_file(self, path, ctype, download=False):
        try:
            size = os.path.getsize(path)
            f = open(path, "rb")
        except OSError:
            return self.reply(404, json.dumps({"ok": False, "error": "não encontrado"}))
        with f:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(size))
            if download:
                self.send_header("Content-Disposition",
                                 "attachment; filename*=UTF-8''" + urllib.parse.quote(os.path.basename(path)))
            self.end_headers()
            shutil.copyfileobj(f, self.wfile, 1024 * 1024)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        if u.path == "/info":
            return self.reply(200, json.dumps({"skyroms": skyroms_ok()}))
        if u.path == "/":
            return self.reply(200, PAGE, "text/html; charset=utf-8")
        if not self.authed(q):
            return
        if u.path == "/api/jogos":
            return self.reply(200, json.dumps({"ok": True, "jogos": list_games(), "espaco": space(),
                                               "skyroms": skyroms_ok()}, ensure_ascii=False))
        if u.path == "/api/capa":
            path = game_path(q.get("id", ""))
            covers = [f for f in JOGOS.game_files(path) if f.lower().endswith((".png", ".jpg"))] if path else []
            if not covers:
                return self.reply(404, json.dumps({"ok": False}))
            return self.send_file(covers[0], "image/png" if covers[0].lower().endswith(".png") else "image/jpeg")
        if u.path == "/api/capturas":
            items = []
            try:
                for n in sorted(os.listdir(SHOTS), reverse=True):
                    if n.lower().endswith(".png"):
                        items.append({"nome": n, "tamanho": os.path.getsize(os.path.join(SHOTS, n))})
            except OSError:
                pass
            return self.reply(200, json.dumps({"ok": True, "capturas": items}, ensure_ascii=False))
        if u.path == "/captura":
            n = os.path.basename(q.get("nome", ""))
            if not n.lower().endswith(".png") or n.startswith("."):
                return self.reply(404, json.dumps({"ok": False}))
            return self.send_file(os.path.join(SHOTS, n), "image/png", q.get("baixar") == "1")
        if u.path == "/api/copias":
            return self.reply(200, json.dumps({"ok": True, "copias": BACKUP.listar()}, ensure_ascii=False))
        if u.path == "/api/copia":
            n = os.path.basename(q.get("nome", ""))
            if not (n.startswith("saves-") and n.endswith(".zip")):
                return self.reply(404, json.dumps({"ok": False}))
            return self.send_file(os.path.join(BACKUP.DEST, n), "application/zip", True)
        if u.path == "/api/saves.zip":
            return self.send_zip(q.get("tudo") == "1")
        self.reply(404, json.dumps({"ok": False, "error": "não encontrado"}))

    def send_zip(self, everything):
        stamp = time.strftime("%Y-%m-%d")
        name = f"skystation-saves{'-completo' if everything else ''}-{stamp}.zip"
        self.send_response(200)
        self.send_header("Content-Type", "application/zip")
        self.send_header("Content-Disposition", f'attachment; filename="{name}"')
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        roots = [("saves", SAVES)] + ([("states", STATES)] if everything else [])
        n = 0
        try:
            with zipfile.ZipFile(self.wfile, "w", zipfile.ZIP_DEFLATED, compresslevel=5) as z:
                for arc, root in roots:
                    for dirpath, _, files in os.walk(root):
                        for fn in files:
                            full = os.path.join(dirpath, fn)
                            z.write(full, os.path.join(arc, os.path.relpath(full, root)))
                            n += 1
        except (OSError, BrokenPipeError):
            return
        acao(f"Backup dos saves baixado ({n} arquivos)")

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        if not self.authed(q):
            return
        if u.path == "/api/perfil":
            try:
                r = subprocess.run([os.path.join(BIN, "sky-perfis"), "listar"], capture_output=True, text=True, timeout=10)
                d = json.loads(r.stdout)
                nome = q.get("nome", "").strip()
                if nome:
                    r = subprocess.run([os.path.join(BIN, "sky-perfis"), "renomear", d["atual"], nome],
                                       capture_output=True, text=True, timeout=10)
                    d = json.loads(r.stdout)
                    acao("Perfil renomeado para " + nome[:20] + " (aparece ao recarregar os jogos)")
                atual = [p for p in d["perfis"] if p["id"] == d["atual"]]
                return self.reply(200, json.dumps({"ok": True, "nome": atual[0]["nome"] if atual else ""}, ensure_ascii=False))
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
                return self.reply(200, json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
        if u.path == "/api/pasta-fim":
            nome = os.path.basename(q.get("nome", ""))[:80]
            emit({"evento": "recebido", "nome": "pasta " + nome, "destino": q.get("destino", ""), "sistema": "ps3"})
            return self.reply(200, json.dumps({"ok": True}))
        if u.path == "/api/teclar":
            return self.reply(200, json.dumps(teclar(q), ensure_ascii=False))
        if u.path == "/api/restaurar":
            res = BACKUP.restaurar(q.get("nome", ""))
            if res.get("ok"):
                acao(res["message"])
            return self.reply(200, json.dumps(res, ensure_ascii=False))
        path = game_path(q.get("id", ""))
        if u.path not in ("/api/apagar", "/api/mover") or not path:
            return self.reply(404, json.dumps({"ok": False, "error": "jogo não encontrado"}, ensure_ascii=False))
        args = ["apagar", path] if u.path == "/api/apagar" else ["mover", path, q.get("para", "")]
        if args[0] == "mover" and args[2] not in DESTS:
            return self.reply(400, json.dumps({"ok": False, "error": "destino inválido"}, ensure_ascii=False))
        try:
            r = subprocess.run([os.path.join(BIN, "sky-jogos"), *args], capture_output=True, text=True, timeout=3600)
            last = [l for l in r.stdout.splitlines() if l.startswith("{") and '"ok"' in l]
            res = json.loads(last[-1]) if last else {"ok": False, "error": "sem resposta"}
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            res = {"ok": False, "error": str(e)}
        if res.get("ok"):
            acao(f"{os.path.basename(path)}: {res.get('message', 'ok')}")
        self.reply(200, json.dumps(res, ensure_ascii=False))

    def do_PUT(self):
        u = urllib.parse.urlparse(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        fail = lambda c, m: self.reply(c, json.dumps({"ok": False, "error": m}, ensure_ascii=False))
        if u.path != "/enviar":
            return fail(404, "não encontrado")
        if not self.authed(q):
            return
        name = os.path.basename(q.get("nome", "")).strip()
        sys_id, dest = q.get("sistema", ""), q.get("destino", "interno")
        # PS3 em pasta (cópia do disco): "pasta" é o caminho relativo dentro de roms/ps3, conferido pedaço a pedaço.
        pasta = [x for x in q.get("pasta", "").replace("\\", "/").split("/") if x]
        if pasta and (sys_id != "ps3" or len(pasta) > 12 or any(x in (".", "..") or x.startswith(".") or len(x) > 200 for x in pasta)):
            return fail(400, "pasta inválida")
        ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
        if not name or name.startswith(".") or sys_id not in EXTS or (ext not in EXTS[sys_id] and not pasta):
            return fail(400, "tipo de arquivo não aceito")
        if sys_id in ("bios", "ps3fw"):
            dest = "interno"  # BIOS e firmware moram sempre no console
        if dest not in DESTS or (dest == "skyroms" and not skyroms_ok()):
            return fail(400, "destino indisponível")
        size = int(self.headers.get("Content-Length", "0") or 0)
        if sys_id == "bios":
            folder = BIOS_DIR
        elif sys_id == "ps3fw":
            folder, name = PS3FW_DIR, "PS3UPDAT.PUP"
        elif pasta:
            folder = os.path.join(DESTS[dest], "ps3", *pasta)
        else:
            folder = os.path.join(DESTS[dest], sys_id, "covers" if ext in ("png", "jpg") else "")
        os.makedirs(folder, exist_ok=True)
        if size + 50 * 1024 * 1024 > shutil.disk_usage(folder).free:
            return fail(507, "sem espaço no destino")
        target = os.path.join(folder, name)
        if pasta and os.path.isfile(target) and os.path.getsize(target) == size:
            return self.reply(200, json.dumps({"ok": True, "pulado": True}))   # reenvio de pasta: não repete o que já chegou
        tmp = target + ".parcial"
        emit({"evento": "recebendo", "nome": name, "p": 0.0})
        got, last = 0, 0.0
        t0 = time.monotonic()
        try:
            with open(tmp, "wb") as f:
                while got < size:
                    chunk = self.rfile.read(min(4 * 1024 * 1024, size - got))
                    if not chunk:
                        break
                    f.write(chunk)
                    got += len(chunk)
                    if time.monotonic() - last > 0.5:
                        last = time.monotonic()
                        emit({"evento": "recebendo", "nome": name, "p": round(got / max(1, size), 3),
                              "v": got / max(0.2, time.monotonic() - t0)})
                f.flush()
                os.fsync(f.fileno())
            if got != size:
                raise OSError("envio interrompido")
            os.replace(tmp, target)
        except OSError as e:
            try:
                os.remove(tmp)
            except OSError:
                pass
            emit({"evento": "erro", "nome": name, "erro": str(e)})
            return fail(500, str(e))
        emit({"evento": "recebido", "nome": name, "destino": dest, "sistema": sys_id, "silencio": bool(pasta)})
        self.reply(200, json.dumps({"ok": True}))


def running_pid():
    """PID do serviço em pé (pelo central.json), ou 0."""
    try:
        with open(STATUS) as f:
            pid = int(json.load(f).get("pid", 0))
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return pid if b"sky-receber" in f.read() else 0
    except (OSError, ValueError):
        return 0


def stop_running():
    pid = running_pid()
    if pid and pid != os.getpid():
        try:
            os.kill(pid, 15)
        except OSError:
            pass
        for _ in range(30):
            if not os.path.exists(f"/proc/{pid}"):
                break
            time.sleep(0.1)
    try:
        os.remove(STATUS)
    except OSError:
        pass


def vigia(srv):
    """A cada 2 s: sai se a central foi desligada; refaz o QR code se o endereço mudou (Wi-Fi, cabo USB)."""
    while True:
        if not load_cfg().get("ligada"):
            srv.shutdown()
            return
        ip = lan_ip()
        if ip != STATE["ip"]:
            with LOCK:
                STATE["ip"], STATE["qr"] = ip, qr_rows()
            write_status()
        time.sleep(2)


def servir():
    global PIN
    cfg = load_cfg()
    if not cfg.get("ligada"):
        return 0
    PIN = str(cfg.get("pin") or "")
    if not re.fullmatch(r"\d{6}", PIN):
        PIN = "%06d" % secrets.randbelow(10 ** 6)
        save_cfg(dict(cfg, pin=PIN))
    stop_running()
    srv = None
    for _ in range(10):                       # a porta pode demorar a liberar depois de reiniciar a interface
        try:
            srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
            break
        except OSError:
            time.sleep(0.5)
    if srv is None:
        print(f"sky-receber: porta {PORT} ocupada", file=sys.stderr)
        return 1
    srv.daemon_threads = True
    import signal
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=srv.shutdown, daemon=True).start())
    STATE["ip"] = lan_ip()
    STATE["qr"] = qr_rows()
    write_status()
    threading.Thread(target=vigia, args=(srv,), daemon=True).start()
    try:
        srv.serve_forever()
    finally:
        try:
            if running_pid() == os.getpid():
                os.remove(STATUS)
        except OSError:
            pass
    return 0


def estado():
    cfg = load_cfg()
    st = {}
    if running_pid():
        try:
            with open(STATUS) as f:
                st = json.load(f)
        except (OSError, ValueError):
            st = {}
    return dict({"ip": "", "qr": [], "recebendo": "", "log": [], "pin": str(cfg.get("pin", "")), "porta": PORT}, **st,
                ok=True, ligada=bool(cfg.get("ligada")), ativa=bool(st))


def ligar():
    cfg = load_cfg()
    if not cfg.get("ligada") or not re.fullmatch(r"\d{6}", str(cfg.get("pin", ""))):
        save_cfg({"ligada": True, "pin": "%06d" % secrets.randbelow(10 ** 6)})
    if not running_pid():
        log = os.path.join(HOME, ".local/state/skystation/central.log")
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as lf:
            subprocess.Popen([sys.executable, os.path.realpath(__file__), "servir"], stdin=subprocess.DEVNULL,
                             stdout=lf, stderr=lf, start_new_session=True)
        for _ in range(40):
            if running_pid():
                break
            time.sleep(0.1)
    return estado()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "estado"
    if cmd == "servir":
        sys.exit(servir())
    if cmd == "ligar":
        res = ligar()
    elif cmd == "desligar":
        save_cfg(dict(load_cfg(), ligada=False, pin=""))
        stop_running()
        res = estado()
    else:
        res = estado()
    print(json.dumps(res, ensure_ascii=False))


if __name__ == "__main__":
    main()
