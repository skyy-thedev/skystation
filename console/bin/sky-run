#!/bin/bash
# SkyStation: executor de jogos.
# Toda abertura de jogo passa por aqui. Ele:
#   - roda o jogo numa sessão própria (setsid): o botão Home consegue fechar o jogo
#     inteiro (inclusive processos filhos) sem tocar no launcher;
#   - liga o GameMode (CPU em desempenho máximo só durante o jogo);
#   - liga o MangoHud se a medição de FPS estiver ativada no menu;
#   - grava o log do jogo e o código de saída para o launcher mostrar erros.
#
# Uso: sky-run <pasta-do-jogo> <comando> <id> [título]

DIR="$1"
CMD="$2"
ID="${3:-jogo}"
TITLE="${4:-$ID}"

RUN="${XDG_RUNTIME_DIR:-/tmp}/skystation"
STATE="$HOME/.local/state/skystation/games"
CONF="$HOME/.config/skystation"
mkdir -p "$RUN" "$STATE"
rm -f "$RUN/last_exit" "$RUN/last_msg"
echo "$TITLE" >"$RUN/game.title"     # o menu Home mostra o nome do jogo
echo "$ID" >"$RUN/game.id"
case "${ID%%-*}" in ps1|ps2|ps3|psp|snes|n64|gc|wii|x360|nds|3ds|gba|gb|nes|md|ps4|switch|wiiu|vita|xbox|dc|saturn) echo "${ID%%-*}" ;; *) echo "" ;; esac >"$RUN/game.sys"   # salvar estado só no PS1
START=$(date +%s)
echo "$START" >"$RUN/game.start"     # Fase 8.0: troféus da partida em andamento e "NOVO" no Home

export SKY_MSG_FILE="$RUN/last_msg"     # sky-emu escreve aqui mensagens para o jogador
export SKY_PROFILE="$(/opt/skystation/bin/sky-perfil)"

# Fase 7.5: processador em potência máxima enquanto o jogo roda (volta ao normal ao fechar).
potencia() { [ -d /var/lib/skystation/pedidos ] && echo "$1" >/var/lib/skystation/pedidos/potencia 2>/dev/null; }
potencia jogo

PREFIX=""
command -v gamemoderun >/dev/null 2>&1 && PREFIX="gamemoderun"

rm -f "$RUN/game.ajustes"          # 11.7: o sky-emu/sky-ps3 anotam aqui o perfil aplicado (vai para o benchmark)

# Medição de desempenho: mangohud.on = contador na tela + log; bench.on (11.7) = só o log, sem nada
# na tela (para medir sem o contador atrapalhar a imagem nem pesar no jogo).
if { [ -f "$CONF/mangohud.on" ] || [ -f "$CONF/bench.on" ]; } && command -v mangohud >/dev/null 2>&1; then
    BENCH="$HOME/skystation/benchmarks"
    [ -w /mnt/skystation ] && BENCH="/mnt/skystation/benchmarks"   # na VM, vai direto para a pasta compartilhada
    [ -w /mnt/skyroms ] && BENCH="/mnt/skyroms/benchmarks"         # 8.0.3: no HD/pendrive SKYROMS (dá para ler no Windows)
    mkdir -p "$BENCH"
    export MANGOHUD_CONFIG="fps,frametime,frame_timing,cpu_stats,cpu_temp,cpu_mhz,core_load,core_bars,gpu_stats,ram,position=top-left,font_size=20,autostart_log=1,log_duration=0,output_folder=$BENCH"
    [ -f "$CONF/mangohud.on" ] || MANGOHUD_CONFIG="no_display,$MANGOHUD_CONFIG"
    PREFIX="$PREFIX mangohud"
fi

LOG="$STATE/$ID.log"
{
    echo "=== $(date '+%F %T')  $ID"
    echo "pasta:   $DIR"
    echo "comando: $PREFIX $CMD"
    echo "perfil:  $SKY_PROFILE"
} >"$LOG"

# Fase 9.4: saves na nuvem. Antes de abrir, baixa o save se a nuvem tiver um mais novo (outro console
# jogou depois). Espera no máximo 25 s; sem internet ou fora da rede, segue na hora com o save local.
NUVEM=""
if [ -f "$CONF/rede.json" ] && [ -x /opt/skystation/bin/sky-cloud ]; then
    NUVEM=1
    echo "nuvem:   $(timeout 25 /opt/skystation/bin/sky-cloud antes "$ID" "$TITLE" "$CMD" 2>&1 | tail -1)" >>"$LOG"
fi

# setsid: o jogo vira líder do próprio grupo de processos (PGID = PID).
setsid bash -c 'cd -- "$1" || exit 97; eval "exec $2 $3"' sky-game "$DIR" "$PREFIX" "$CMD" >>"$LOG" 2>&1 &
child=$!
echo "$child" >"$RUN/game.pid"

# Fase 8.0: troféus durante o jogo. A cada minuto confere; se ganhou, toca o som do troféu na hora
# (o som sai por cima do jogo) e o troféu aparece como NOVO no menu Home e no aviso ao voltar.
if [ -x /opt/skystation/bin/sky-trofeus ]; then
    ( while sleep 60; do kill -0 "$child" 2>/dev/null || break
          echo "$(date +%s.%N) trofeus" >>"$RUN/eventos.log"
          /opt/skystation/bin/sky-trofeus conferir >/dev/null 2>&1
      done ) &
    TROF_PID=$!
fi

wait "$child"
code=$?
[ -n "${TROF_PID:-}" ] && kill "$TROF_PID" 2>/dev/null

rm -f "$RUN/game.pid"
echo "=== saiu com código $code" >>"$LOG"

# 13.3: deu erro? Copia o log (e o do próprio emulador, quando ele grava um) para SKYROMS/diag, que dá
# para ler no Windows ou mandar para diagnóstico sem precisar do terminal do console.
# 13.7: também quando o jogo fecha sozinho em menos de 2 min com código 0 (o Vita3K volta para a home assim
# quando o jogo trava, sem código de erro).
if { { [ "$code" -ne 0 ] && [ "$code" -ne 143 ]; } || [ $(( $(date +%s) - START )) -lt 120 ]; } && [ -w /mnt/skyroms ]; then
    DIAG=/mnt/skyroms/diag
    mkdir -p "$DIAG" 2>/dev/null && {
        cp -f "$LOG" "$DIAG/$ID.log" 2>/dev/null
        # 13.7: travou de verdade (139 = falha de memória, 134 = abort)? O systemd-coredump guarda a pilha:
        # diz em qual biblioteca foi (driver de vídeo, MangoHud, ffmpeg, o próprio emulador).
        if { [ "$code" -eq 139 ] || [ "$code" -eq 134 ]; } && command -v coredumpctl >/dev/null 2>&1; then
            sleep 2
            timeout 20 coredumpctl info --no-pager --since "@$START" -1 2>&1 | head -120 >"$DIAG/$ID.pilha.txt" || true
        fi
        for extra in "$HOME/.cache/Vita3K/vita3k.log" "$HOME/.config/retroarch/logs/retroarch.log" \
                     "$HOME/.cache/rpcs3/RPCS3.log"; do   # 13.7: o log do RPCS3 (o motivo do erro fica nele)
            [ -f "$extra" ] && [ "$(stat -c %Y "$extra")" -ge "$START" ] && cp -f "$extra" "$DIAG/$ID.$(basename "$extra")" 2>/dev/null
        done
    }
fi

# Tempo de jogo (Fase 5.6): soma o tempo desta partida em ~/skystation/saves/tempo.json.
# Partidas com menos de 10 s (abriu e fechou) não contam.
python3 - "$ID" "$TITLE" "$START" "$(date +%s)" "$HOME/skystation/saves/tempo.json" <<'PY' 2>>"$LOG"
import json, os, sys
gid, title, start, end, path = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
secs = end - start
if secs >= 10:
    try:
        data = json.load(open(path))
    except (OSError, ValueError):
        data = {}
    g = data.get(gid, {"seconds": 0, "plays": 0})
    g.update(seconds=g.get("seconds", 0) + secs, plays=g.get("plays", 0) + 1, last=end, title=title)
    data[gid] = g
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(path + ".tmp", path)
PY
echo "$code" >"$RUN/last_exit"
potencia normal

# Fase 8.2: o log do MangoHud ganha o nome do jogo e uma linha no resumo.csv da pasta de benchmarks.
[ -n "${BENCH:-}" ] && [ -x /opt/skystation/bin/sky-bench ] && \
    /opt/skystation/bin/sky-bench fechar "$BENCH" "$START" "$ID" "$TITLE" 2>>"$LOG"

# Fase 6.3: troféus do perfil (avisa na tela se conquistou algum nesta partida).
[ -x /opt/skystation/bin/sky-trofeus ] && /opt/skystation/bin/sky-trofeus conferir >/dev/null 2>&1

# Fase 9.4: envia o save para a nuvem se mudou (em segundo plano: não segura a volta ao menu).
[ -n "$NUVEM" ] && (timeout 300 /opt/skystation/bin/sky-cloud depois "$ID" "$TITLE" "$CMD" >/dev/null 2>&1 &)

# Fase 6.1: se algum save mudou nesta partida, guarda uma cópia de segurança (em segundo plano).
[ -x /opt/skystation/bin/sky-backup ] && (/opt/skystation/bin/sky-backup auto >/dev/null 2>&1 &)

# Wine deixa um servidor rodando em segundo plano; encerra o do prefixo deste jogo.
if [ -n "${SKY_WINEPREFIX:-}" ] || [ -f "$RUN/wineprefix" ]; then
    WP="${SKY_WINEPREFIX:-$(cat "$RUN/wineprefix" 2>/dev/null)}"
    [ -n "$WP" ] && WINEPREFIX="$WP" wineserver -k >/dev/null 2>&1
    rm -f "$RUN/wineprefix"
fi

# Ponte de diagnóstico na VM.
if [ -w /mnt/skystation ]; then
    mkdir -p /mnt/skystation/logs && cp "$LOG" "/mnt/skystation/logs/$ID.log" 2>/dev/null
fi

exit "$code"
