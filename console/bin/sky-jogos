#!/usr/bin/env python3
"""SkyStation: gerencia jogos (ROMs) entre o armazenamento interno e o pendrive SKYROMS.

  sky-jogos espaco                     -> espaço livre/total do sistema e do SKYROMS (JSON)
  sky-jogos mover <arquivo> <interno|skyroms>
                                       -> move o jogo inteiro (.cue + .bin, .m3u + discos, capa);
                                          imprime {"p": 0.0..1.0} durante a cópia e {"ok": ...} no fim
  sky-jogos apagar <arquivo>           -> apaga o jogo inteiro (mesmos arquivos)
  sky-jogos compactar <arquivo>        -> converte .cue/.iso para .chd (chdman), confere e apaga o original
  sky-jogos copiar-disco <interno|skyroms>
                                       -> copia o disco do leitor (Fase 6.0): PS2 vira .iso;
                                          PS1 vira .bin/.cue (cdrdao, com faixas de áudio) e depois .chd

A cópia é verificada (tamanho) antes de apagar a origem: se faltar espaço ou der erro no
meio, nada é apagado.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
INTERNO = os.path.join(HOME, "skystation/roms")
SKYROMS = "/mnt/skyroms"


def out(obj):
    print(json.dumps(obj, ensure_ascii=False), flush=True)


def mounted(path):
    try:
        with open("/proc/mounts") as f:
            return any(line.split()[1] == path for line in f if len(line.split()) > 1)
    except OSError:
        return False


def space(path):
    try:
        u = shutil.disk_usage(path)
        return {"livre": u.free, "total": u.total}
    except OSError:
        return None


def game_files(path):
    """Todos os arquivos de um jogo: o principal + faixas do .cue/.m3u + capas."""
    files = [path]
    folder = os.path.dirname(path)
    ext = path.rsplit(".", 1)[-1].lower()
    try:
        if ext in ("cue", "m3u"):
            with open(path, errors="replace") as f:
                text = f.read()
            refs = re.findall(r'FILE\s+"([^"]+)"', text) if ext == "cue" else \
                [ln.strip() for ln in text.splitlines() if ln.strip() and not ln.startswith("#")]
            for r in refs:
                p = os.path.join(folder, r)
                if os.path.exists(p) and p not in files:
                    files.append(p)
                    if p.lower().endswith(".cue"):       # m3u -> cue -> bin
                        files += [x for x in game_files(p)[1:] if x not in files and not x.endswith(".png")]
    except OSError:
        pass
    stem = os.path.basename(path).rsplit(".", 1)[0]
    for c in (os.path.join(folder, "covers", stem + ".png"), os.path.join(folder, "covers", stem + ".jpg"),
              os.path.join(folder, stem + ".png")):
        if os.path.exists(c):
            files.append(c)
    return files


def system_of(path):
    parts = os.path.normpath(path).split(os.sep)
    for s in ("ps1", "ps2", "psp", "snes", "n64"):
        if s in parts:
            return s
    return None


def mover(path, dest_kind):
    if not os.path.isfile(path):
        out({"ok": False, "error": "Jogo não encontrado"})
        return
    sys_id = system_of(path)
    if not sys_id:
        out({"ok": False, "error": "Não sei de que sistema é este jogo"})
        return
    if dest_kind == "skyroms":
        if not mounted(SKYROMS):
            out({"ok": False, "error": "Pendrive SKYROMS não está conectado"})
            return
        base = SKYROMS
    else:
        base = INTERNO
    dest_dir = os.path.join(base, sys_id)
    src_dir = os.path.dirname(path)
    if os.path.realpath(src_dir) == os.path.realpath(dest_dir):
        out({"ok": False, "error": "O jogo já está aí"})
        return
    files = game_files(path)
    total = sum(os.path.getsize(f) for f in files)
    os.makedirs(os.path.join(dest_dir, "covers"), exist_ok=True)
    free = shutil.disk_usage(dest_dir).free
    if total + 50 * 1024 * 1024 > free:
        out({"ok": False, "error": f"Falta espaço: o jogo tem {total / 1e9:.1f} GB e há {free / 1e9:.1f} GB livres"})
        return
    done = 0
    copied = []
    try:
        for f in files:
            rel = os.path.relpath(f, src_dir)
            target = os.path.join(dest_dir, rel)
            os.makedirs(os.path.dirname(target), exist_ok=True)
            tmp = target + ".parcial"
            with open(f, "rb") as a, open(tmp, "wb") as b:
                while True:
                    chunk = a.read(4 * 1024 * 1024)
                    if not chunk:
                        break
                    b.write(chunk)
                    done += len(chunk)
                    out({"p": round(done / max(1, total), 3)})
                b.flush()
                os.fsync(b.fileno())      # pendrive: garante que foi gravado de verdade
            if os.path.getsize(tmp) != os.path.getsize(f):
                raise OSError("cópia incompleta")
            os.replace(tmp, target)
            copied.append(target)
    except OSError as e:
        for c in copied:
            try:
                os.remove(c)
            except OSError:
                pass
        out({"ok": False, "error": f"Erro ao copiar: {e}"})
        return
    for f in files:
        try:
            os.remove(f)
        except OSError:
            pass
    out({"ok": True, "message": "Jogo movido para o " + ("pendrive SKYROMS" if dest_kind == "skyroms" else "console")})


def apagar(path):
    if not os.path.isfile(path) or not system_of(path):
        out({"ok": False, "error": "Jogo não encontrado"})
        return
    n = 0
    for f in game_files(path):
        try:
            os.remove(f)
            n += 1
        except OSError:
            pass
    out({"ok": True, "message": "Jogo apagado"})


RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skystation")


def etapa(texto, p=None):
    o = {"etapa": texto}
    if p is not None:
        o["p"] = round(max(0.0, min(1.0, p)), 3)
    out(o)


def chd_cmd(path, sys_id):
    """createcd para CD (PS1, .cue), createdvd para DVD de PS2 (.iso grande)."""
    ext = path.rsplit(".", 1)[-1].lower()
    if ext == "cue" or (ext == "iso" and sys_id == "ps1"):
        return "createcd"
    if ext == "iso" and os.path.getsize(path) < 850 * 1024 * 1024 and sys_id == "ps2":
        return "createcd"     # PS2 em CD (capa azul): imagem pequena
    return "createdvd"


def compactar(path, quiet_ok=False):
    """Converte para CHD. Devolve o caminho do .chd ou None (já avisou o erro)."""
    chdman = shutil.which("chdman")
    if not chdman:
        out({"ok": False, "error": "Compactar precisa do chdman: rode a Fase 6.0"})
        return None
    sys_id = system_of(path)
    ext = path.rsplit(".", 1)[-1].lower()
    if not os.path.isfile(path) or not sys_id or ext not in ("cue", "iso", "img"):
        out({"ok": False, "error": "Só dá para compactar jogos .cue ou .iso"})
        return None
    files = [f for f in game_files(path) if not f.lower().endswith((".png", ".jpg"))]
    total = sum(os.path.getsize(f) for f in files)
    folder = os.path.dirname(path)
    target = os.path.join(folder, os.path.basename(path).rsplit(".", 1)[0] + ".chd")
    if os.path.exists(target):
        out({"ok": False, "error": "Já existe uma versão .chd deste jogo"})
        return None
    if total * 0.9 + 50 * 1024 * 1024 > shutil.disk_usage(folder).free:
        out({"ok": False, "error": f"Falta espaço para compactar (precisa de até {total * 0.9 / 1e9:.1f} GB livres)"})
        return None
    tmp = target + ".parcial.chd"
    etapa("Compactando", 0.0)
    proc = subprocess.Popen([chdman, chd_cmd(path, sys_id), "-i", path, "-o", tmp, "-f"],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    VIGIA["procs"].append(proc)
    VIGIA["lixo"].append(tmp)
    vigiar(0)            # só para o botão B (cancelar); compactar não trava por disco ruim
    buf, last = b"", 0.0
    while True:
        c = proc.stdout.read(64)
        if not c:
            break
        buf = (buf + c)[-200:]
        m = re.findall(rb"(\d+(?:\.\d+)?)% complete", buf)
        if m and time.monotonic() - last > 0.5:
            last = time.monotonic()
            etapa("Compactando", float(m[-1]) / 100)
    if proc.wait() != 0:
        try:
            os.remove(tmp)
        except OSError:
            pass
        out({"ok": False, "error": "O chdman não conseguiu compactar este jogo"})
        return None
    etapa("Conferindo", 1.0)
    if subprocess.run([chdman, "verify", "-i", tmp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        os.remove(tmp)
        out({"ok": False, "error": "A versão compactada não passou na conferência; o original foi mantido"})
        return None
    os.replace(tmp, target)
    VIGIA["lixo"] = [f for f in VIGIA["lixo"] if f != tmp]
    VIGIA["procs"] = [x for x in VIGIA["procs"] if x is not proc]
    for f in files:
        try:
            os.remove(f)
        except OSError:
            pass
    novo = os.path.getsize(target)
    if not quiet_ok:
        out({"ok": True, "message": f"Compactado: {total / 1e9:.2f} GB → {novo / 1e9:.2f} GB"})
    return target


# ---------------------------------------------------------------- vigia (Fase 6.4)
# Trabalhos longos (copiar disco, compactar) têm um vigia: se o progresso parar por tempo demais
# (disco riscado: o leitor fica tentando para sempre) ou se o menu pedir para cancelar (botão B,
# que cria o arquivo "cancelar-job"), o trabalho é encerrado, os pedaços são apagados e o menu avisa.
import threading

CANCEL = os.path.join(RUN, "cancelar-job")
VIGIA = {"t": time.monotonic(), "limite": 0, "procs": [], "lixo": [], "onde": ""}


def pulso(onde=""):
    VIGIA["t"] = time.monotonic()
    if onde:
        VIGIA["onde"] = onde


def _encerrar(msg):
    for pr in VIGIA["procs"]:
        try:
            pr.kill()
        except OSError:
            pass
    for f in VIGIA["lixo"] + [os.path.join(RUN, "disco.ocupado"), CANCEL]:
        try:
            os.remove(f)
        except OSError:
            pass
    out({"ok": False, "error": msg})
    os._exit(1)


def vigiar(limite):
    """Liga o vigia. limite = segundos sem progresso antes de desistir."""
    try:
        os.remove(CANCEL)
    except OSError:
        pass
    VIGIA["limite"] = limite
    pulso()
    if VIGIA.get("ligado"):
        return
    VIGIA["ligado"] = True

    def loop():
        while True:
            time.sleep(1)
            if os.path.exists(CANCEL):
                _encerrar("Cancelado")
            if VIGIA["limite"] and time.monotonic() - VIGIA["t"] > VIGIA["limite"]:
                _encerrar("O leitor parou de ler o disco" + (f" em {VIGIA['onde']}" if VIGIA["onde"] else "") +
                          ". Limpe o disco (pode estar riscado ou sujo) e tente de novo")

    threading.Thread(target=loop, daemon=True).start()


def _disco():
    import importlib.machinery
    return importlib.machinery.SourceFileLoader(
        "sky_disco", os.path.join(os.path.dirname(os.path.realpath(__file__)), "sky-disco")).load_module()


def copiar_disco(dest_kind):
    disco = _disco()
    info = disco.detect(online=True)
    if not info.get("disco") or info.get("sistema") not in ("ps1", "ps2"):
        out({"ok": False, "error": "Não há um jogo de PS1/PS2 no leitor"})
        return
    sys_id, dev = info["sistema"], info["dev"]
    if dest_kind == "skyroms" and not mounted(SKYROMS):
        out({"ok": False, "error": "Pendrive SKYROMS não está conectado"})
        return
    dest_dir = os.path.join(SKYROMS if dest_kind == "skyroms" else INTERNO, sys_id)
    os.makedirs(os.path.join(dest_dir, "covers"), exist_ok=True)
    nome = re.sub(r'[\\/:*?"<>|]', "_", info.get("titulo") or info.get("serial") or "Disco").strip() or "Disco"
    try:
        with open(f"/sys/class/block/{os.path.basename(dev)}/size") as f:
            size = int(f.read()) * 512
    except (OSError, ValueError):
        size = 0
    need = size * (1.2 if sys_id == "ps1" else 1.0)
    free = shutil.disk_usage(dest_dir).free
    if need + 100 * 1024 * 1024 > free:
        out({"ok": False, "error": f"Falta espaço: o disco tem {need / 1e9:.1f} GB e há {free / 1e9:.1f} GB livres"})
        return
    for ext in (".iso", ".cue", ".chd"):
        if os.path.exists(os.path.join(dest_dir, nome + ext)):
            out({"ok": False, "error": "Este jogo já está copiado"})
            return
    os.makedirs(RUN, exist_ok=True)
    lock = os.path.join(RUN, "disco.ocupado")       # o sky-notify não mexe no leitor durante a cópia
    open(lock, "w").close()
    try:
        final = _copiar_ps2(dev, dest_dir, nome, size) if sys_id == "ps2" else _copiar_ps1(dev, dest_dir, nome, size)
    finally:
        try:
            os.remove(lock)
        except OSError:
            pass
    if not final:
        return
    if info.get("capa") and os.path.exists(info["capa"]):
        try:
            shutil.copyfile(info["capa"], os.path.join(dest_dir, "covers", os.path.basename(final).rsplit(".", 1)[0] + ".png"))
        except OSError:
            pass
    if sys_id == "ps1" and shutil.which("chdman"):
        chd = compactar(final, quiet_ok=True)
        if chd:
            final = chd
    onde = "pendrive SKYROMS" if dest_kind == "skyroms" else "console"
    out({"ok": True, "message": f"Disco copiado para o {onde}: {os.path.basename(final)}"})


def _copiar_ps2(dev, dest_dir, nome, size):
    """Copia o DVD setor por setor. Trecho ilegível: tenta de novo em pedaços pequenos e, se não der,
    preenche com zeros (até MAX_RUINS setores). Muitos jogos têm áreas de enchimento no fim do disco
    que nunca são lidas; alguns setores ruins ali não atrapalham."""
    MAX_RUINS = 256
    target = os.path.join(dest_dir, nome + ".iso")
    tmp = target + ".parcial"
    VIGIA["lixo"].append(tmp)
    vigiar(180)
    done, last, ruins = 0, 0.0, 0
    BLOCO = 1024 * 1024
    etapa("Copiando o disco", 0.0)
    try:
        fd = os.open(dev, os.O_RDONLY)
        with open(tmp, "wb") as b:
            while not size or done < size:
                want = min(BLOCO, size - done) if size else BLOCO
                try:
                    os.lseek(fd, done, os.SEEK_SET)
                    chunk = os.read(fd, want)
                    if not chunk:
                        break
                except OSError:
                    chunk = b""
                    for off in range(0, want, 2048):       # o bloco tem defeito: setor por setor
                        n = min(2048, want - off)
                        try:
                            os.lseek(fd, done + off, os.SEEK_SET)
                            sec = os.read(fd, n)
                            if len(sec) != n:
                                raise OSError("leitura curta")
                        except OSError:
                            sec = b"\0" * n
                            ruins += 1
                            if ruins > MAX_RUINS:
                                raise OSError(f"mais de {MAX_RUINS} setores ilegíveis perto de {int(done * 100 / max(1, size))}%")
                        chunk += sec
                        pulso(f"{int((done + off) * 100 / max(1, size))}%")
                b.write(chunk)
                done += len(chunk)
                pulso(f"{int(done * 100 / max(1, size))}%")
                if time.monotonic() - last > 0.5:
                    last = time.monotonic()
                    etapa("Copiando o disco" + (f" ({ruins} trechos ruins)" if ruins else ""), done / max(1, size))
            b.flush()
            os.fsync(b.fileno())
        os.close(fd)
        if size and done != size:
            raise OSError(f"leitura incompleta ({done} de {size} bytes)")
        os.replace(tmp, target)
        VIGIA["lixo"].remove(tmp)
        VIGIA["limite"] = 0
        if ruins:
            etapa(f"Copiado com {ruins} trecho(s) ilegível(is): o jogo pode travar nesses pontos", 1.0)
            time.sleep(3)
        return target
    except OSError as e:
        VIGIA["limite"] = 0
        try:
            os.remove(tmp)
        except OSError:
            pass
        out({"ok": False, "error": f"Não deu para ler o disco (riscado ou sujo?): {e}"})
        return None


def _copiar_ps1(dev, dest_dir, nome, size):
    if not shutil.which("cdrdao"):
        out({"ok": False, "error": "Copiar CD de PS1 precisa do cdrdao: rode a Fase 6.0"})
        return None
    base = os.path.join(dest_dir, nome)
    binf, toc, cue = base + ".bin", base + ".toc", base + ".cue"
    expect = max(1, size // 2048 * 2352)
    etapa("Copiando o CD", 0.0)
    # O cdrdao escreve o andamento sem parar na saída de erro. Num "pipe" que ninguém lê, a saída
    # enche (64 KB) e o cdrdao fica parado para sempre no meio da cópia: por isso vai para um arquivo.
    errpath = os.path.join(RUN, "cdrdao.log")
    errlog = open(errpath, "w")
    proc = subprocess.Popen(["cdrdao", "read-cd", "--read-raw", "--datafile", binf, "--driver", "generic-mmc-raw",
                             "--device", dev, toc], stdout=subprocess.DEVNULL, stderr=errlog)
    VIGIA["procs"].append(proc)
    VIGIA["lixo"] += [binf, toc, cue]
    vigiar(240)
    visto = -1
    while proc.poll() is None:
        time.sleep(0.7)
        try:
            tam = os.path.getsize(binf)
            if tam != visto:
                visto = tam
                pulso(f"{int(min(99, tam * 100 / expect))}%")
            etapa("Copiando o CD", min(0.99, tam / expect))
        except OSError:
            pass
    VIGIA["limite"] = 0
    VIGIA["procs"].remove(proc)
    errlog.close()
    try:
        with open(errpath, errors="replace") as f:
            err = f.read()[-400:]
    except OSError:
        err = ""
    ok = proc.returncode == 0 and os.path.exists(toc)
    if ok:
        ok = subprocess.run(["toc2cue", toc, cue], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if ok:
        # o toc2cue escreve o caminho do .bin; o cue fica na mesma pasta: só o nome do arquivo
        with open(cue, errors="replace") as f:
            txt = f.read()
        txt = re.sub(r'FILE\s+"[^"]*"', f'FILE "{os.path.basename(binf)}"', txt)
        with open(cue, "w") as f:
            f.write(txt)
    VIGIA["lixo"] = [f for f in VIGIA["lixo"] if f not in (binf, toc, cue)]
    for f in ([toc] if ok else [toc, binf, cue]):
        try:
            os.remove(f)
        except OSError:
            pass
    if not ok:
        out({"ok": False, "error": "Não consegui copiar o CD: " + (err.strip().splitlines()[-1] if err.strip() else "erro do cdrdao")})
        return None
    return cue


def conferir(path):
    """Compara a cópia (.iso de PS2) com o registro Redump daquele disco: tamanho + CRC32."""
    import urllib.parse
    import urllib.request
    import zlib
    if not os.path.isfile(path) or system_of(path) != "ps2" or not path.lower().endswith(".iso"):
        out({"ok": False, "error": "A conferência vale para jogos de PS2 em .iso"})
        return
    cache = os.path.join(HOME, ".cache/skystation/discos/crc-ps2.tsv")
    if not os.path.exists(cache):
        etapa("Baixando a lista de discos")
        try:
            url = "https://raw.githubusercontent.com/libretro/libretro-database/master/metadat/redump/" + \
                urllib.parse.quote("Sony - PlayStation 2.dat")
            req = urllib.request.Request(url, headers={"User-Agent": "SkyStation"})
            raw = urllib.request.urlopen(req, timeout=90).read().decode("utf-8", "replace")
            rows = re.findall(r'rom \( name "([^"]+)" size (\d+) crc ([0-9A-Fa-f]{8})', raw)
            if not rows:
                raise ValueError("lista vazia")
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            with open(cache + ".tmp", "w") as f:
                for n, sz, crc in rows:
                    f.write(f"{crc.upper()}\t{sz}\t{n}\n")
            os.replace(cache + ".tmp", cache)
        except Exception as e:
            out({"ok": False, "error": f"Sem a lista de discos (precisa de internet): {e}"})
            return
    vigiar(0)
    total, done, crc, last = os.path.getsize(path), 0, 0, 0.0
    with open(path, "rb") as f:
        while True:
            chunk = f.read(4 * 1024 * 1024)
            if not chunk:
                break
            crc = zlib.crc32(chunk, crc)
            done += len(chunk)
            if time.monotonic() - last > 0.5:
                last = time.monotonic()
                etapa("Conferindo a cópia", done / max(1, total))
    key = f"{crc & 0xFFFFFFFF:08X}"
    achou, mesmo_tam = "", False
    with open(cache) as f:
        for line in f:
            c, sz, n = line.rstrip("\n").split("\t", 2)
            if c == key and int(sz) == total:
                achou = n
                break
            mesmo_tam = mesmo_tam or int(sz) == total
    if achou:
        out({"ok": True, "message": "Cópia perfeita: idêntica ao disco original (" + achou.rsplit(".", 1)[0][:40] + ")"})
    else:
        out({"ok": False, "error": "Não bate com nenhum disco registrado: a cópia pode estar com defeito"
             + ("" if mesmo_tam else " (o tamanho também não confere)") + ", ou é uma edição não catalogada"})


def _du(path):
    total = 0
    for d, _, fs in os.walk(path):
        for f in fs:
            try:
                total += os.lstat(os.path.join(d, f)).st_size
            except OSError:
                pass
    return total


def uso():
    """Quanto cada coisa ocupa (tela Armazenamento, Fase 6.2)."""
    sky = os.path.join(HOME, "skystation")
    u = shutil.disk_usage("/")
    itens = []
    for nome, sub in (("PS1", "roms/ps1"), ("PS2", "roms/ps2"), ("PSP", "roms/psp"), ("SNES", "roms/snes"), ("N64", "roms/n64"),
                      ("Jogos próprios", "games"), ("Saves e estados", "saves"), ("Saves e estados", "states"),
                      ("Capturas e cópias", "capturas"), ("Capturas e cópias", "backups")):
        b = _du(os.path.join(sky, sub))
        if itens and itens[-1][0] == nome:
            itens[-1][1] += b
        else:
            itens.append([nome, b])
    itens = [i for i in itens if i[1] > 0]
    usado = u.total - u.free
    itens.append(["Sistema e emuladores", max(0, usado - sum(i[1] for i in itens))])
    res = {"ok": True, "total": u.total, "livre": u.free, "itens": itens, "skyroms": None}
    if mounted(SKYROMS):
        s = shutil.disk_usage(SKYROMS)
        res["skyroms"] = {"total": s.total, "livre": s.free}
    out(res)


def main():
    a = sys.argv[1:]
    if not a:
        out({"ok": False, "error": "uso: sky-jogos espaco | mover <arquivo> <interno|skyroms> | apagar <arquivo>"})
    elif a[0] == "espaco":
        out({"ok": True, "sistema": space("/"), "skyroms": space(SKYROMS) if mounted(SKYROMS) else None})
    elif a[0] == "conferir" and len(a) == 2:
        conferir(a[1])
    elif a[0] == "uso":
        uso()
    elif a[0] == "mover" and len(a) == 3:
        mover(a[1], a[2])
    elif a[0] == "apagar" and len(a) == 2:
        apagar(a[1])
    elif a[0] == "compactar" and len(a) == 2:
        compactar(a[1])
    elif a[0] == "copiar-disco" and len(a) == 2:
        copiar_disco(a[1])
    else:
        out({"ok": False, "error": "comando inválido"})


if __name__ == "__main__":
    main()
