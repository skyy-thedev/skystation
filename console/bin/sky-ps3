# Fase 8.0.1: sempre garantidas, mesmo em instalações antigas (o .ini já existe e não é recriado)
GUI_FORCAR = {"GSFrame": {"showMouseInFullscreen": "false", "hideMouseOnIdle": "true",
                          "hideMouseOnIdleTime": "500"},
              "Meta": {"checkUpdateStart": "false"}}
CONFIG_YML = """Miscellaneous:
  Exit RPCS3 when process finishes: true
  Start games in fullscreen mode: true
"""


# Ajustes por jogo (o RPCS3 lê custom_configs/config_<código>.yml por cima da config geral).
# Só sobrescrevemos/apagamos arquivos que nós mesmos criamos (primeira linha "# SkyStation").
# Teste 1 (8.1.1), UMA mudança só: blocos maiores na tradução dos coprocessadores (SPU) do Cell.
# Resolução 50%/75% não mudou o FPS no Ryzen 5 5500U: o gargalo é o processador, não o vídeo.
SPU_MEGA = """# SkyStation: teste 1 do God of War III (apague esta linha para editar à mão)
Core:
  SPU Block Size: Mega
"""
GOW3 = """# SkyStation: teste 3 do God of War III (apague esta linha para editar à mão)
Video:
  Frame limit: 30
"""
# 13.7: Assassin's Creed (EUA) fechava 0,1 s depois de achar a GPU (RADV RENOIR, Mesa 26.2.6): "Verification
# failed" em vk::die_with_error, antes de compilar qualquer shader. Os outros jogos de PS3 rodam no Vulkan; este
# vai pelo OpenGL (mais lento, mas não passa por esse caminho do Vulkan). Se não abrir, apague e teste outra coisa.
AC1_GL = """# SkyStation: Assassin's Creed pelo OpenGL (apague esta linha para editar à mão)
Video:
  Renderer: OpenGL
"""
POR_JOGO = {
    "BLUS30089": AC1_GL,  # Assassin's Creed (EUA)
    # 8.3: o SPU "Mega" piorou as lutas (33 FPS vs 45 com o padrão "Safe"); voltou ao padrão.
    # 8.3.2: travado em 30 (as cenas leves não esquentam o processador antes das lutas) e
    # no máximo 4 SPURS por grupo (menos disputa pelos 6 núcleos do Ryzen 5 5500U).
    # 11.7: SPURS de volta ao padrão (6). Com 4, o Kratos morria sem levar dano quando o braço da
    # Gaia volta à posição normal na luta contra o Poseidon: o limite de SPURS é uma gambiarra do
    # RPCS3 e muda quando a física do jogo é calculada. Fica só a trava em 30 FPS.
    "BCUS98111": GOW3,   # God of War III (EUA)
    "BCES00510": GOW3,   # God of War III (Europa)
}


def ajustes_por_jogo():
    d = os.path.join(RP, "custom_configs")
    try:
        nomes = os.listdir(d)
    except OSError:
        nomes = []
    # remove os ajustes automáticos antigos que saíram da lista (só os criados pelo SkyStation)
    for nome in nomes:
        serial = nome[len("config_"):-len(".yml")] if nome.startswith("config_") and nome.endswith(".yml") else ""
        if serial and serial not in POR_JOGO:
            path = os.path.join(d, nome)
            try:
                with open(path) as f:
                    nosso = f.readline().startswith("# SkyStation")
                if nosso:
                    os.remove(path)
            except OSError:
                pass
    for serial, texto in POR_JOGO.items():
        path = os.path.join(d, f"config_{serial}.yml")
        try:
            with open(path) as f:
                if not f.readline().startswith("# SkyStation"):
                    continue          # o usuário editou: não mexe
        except OSError:
            pass
        os.makedirs(d, exist_ok=True)
        with open(path, "w") as f:
            f.write(texto)


def write_if_missing(path, text):
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)


def garantir_ini(path, valores):
    """Ajusta chaves de um .ini do Qt sem apagar o resto (seções e chaves que o RPCS3 gravou)."""
    try:
        with open(path) as f:
            linhas = f.read().splitlines()
    except OSError:
        linhas = []
    for secao, kv in valores.items():
        cab = f"[{secao}]"
        if cab not in linhas:
            linhas += ["", cab] + [f"{k}={v}" for k, v in kv.items()]
            continue
        i = linhas.index(cab) + 1
        fim = i
        while fim < len(linhas) and not linhas[fim].startswith("["):
            fim += 1
        while fim > i and not linhas[fim - 1].strip():   # novas chaves antes da linha em branco
            fim -= 1
        for k, v in kv.items():
            for j in range(i, fim):
                if linhas[j].split("=", 1)[0].strip() == k:
                    linhas[j] = f"{k}={v}"
                    break
            else:
                linhas.insert(fim, f"{k}={v}")
                fim += 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(linhas) + "\n")


# ------------------------------------------------------------------ online do PS3 (RPCN, Fase 11.5)
# O RPCS3 tem um servidor próprio no lugar da PSN, o RPCN (np.rpcs3.net): partidas online, salas,
# lista de amigos e placares dos jogos que usam a PSN. A conta é criada UMA vez pelo RPCS3 com
# interface (Configuração > RPCN): ele pede ID, senha e e-mail, e manda um código de 16 letras
# (o "token") por e-mail. Aqui só guardamos ID, senha e token no rpcn.yml, que o RPCS3 lê ao abrir.
RPCN_HOSTS = "Official RPCN Server|np.rpcs3.net"
RE_NPID = re.compile(r"^[A-Za-z0-9_-]{3,16}$")
RE_TOKEN = re.compile(r"^[0-9A-Z]{16}$")


def _yml_str(v):
    # aspas duplas no estilo JSON também são YAML válido (a senha pode ter : # ' etc.)
    return json.dumps(v)


def _yml_val(v):
    v = v.strip()
    if v[:1] == '"':
        try:
            return json.loads(v)
        except ValueError:
            return v.strip('"')
    if v[:1] == "'":
        return v[1:-1].replace("''", "'")
    return v


def ler_rpcn():
    """rpcn.yml -> {"NPID": …, "Password": …, "Token": …, …} (só chaves de 1º nível)."""
    d = {}
    try:
        with open(os.path.join(RP, "rpcn.yml")) as f:
            for linha in f:
                if linha[:1] not in (" ", "\t", "#") and ":" in linha:
                    k, v = linha.split(":", 1)
                    d[k.strip()] = _yml_val(v)
    except OSError:
        pass
    return d


def tem_rpcn():
    d = ler_rpcn()
    return bool(d.get("NPID") and d.get("Password") and d.get("Token"))


def garantir_yml(path, secao, valores):
    """Ajusta chaves de uma seção do config.yml do RPCS3 sem apagar o resto."""
    try:
        with open(path) as f:
            linhas = f.read().splitlines()
    except OSError:
        linhas = []
    cab = secao + ":"
    novas = [f"  {k}: {v}" for k, v in valores.items()]
    if cab not in linhas:
        linhas += [cab] + novas
    else:
        i = linhas.index(cab) + 1
        fim = i
        while fim < len(linhas) and (linhas[fim].startswith(" ") or not linhas[fim].strip()):
            fim += 1
        for k, v in valores.items():
            for j in range(i, fim):
                if linhas[j].startswith("  ") and not linhas[j].startswith("   ") and \
                        linhas[j].strip().split(":", 1)[0] == k:
                    linhas[j] = f"  {k}: {v}"
                    break
            else:
                linhas.insert(fim, f"  {k}: {v}")
                fim += 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(linhas) + "\n")


def garantir_net():
    """Com conta RPCN: internet e "PSN" ligadas no RPCS3. Sem conta: nunca deixa o RPCS3 tentando
    entrar no RPCN (ele mostraria um erro no meio do jogo)."""
    cfg = os.path.join(RP, "config.yml")
    if tem_rpcn():
        garantir_yml(cfg, "Net", {"Internet enabled": "Connected", "PSN status": "RPCN"})
        return
    try:
        with open(cfg) as f:
            ligado = re.search(r"^  PSN status: RPCN\s*$", f.read(), re.M)
    except OSError:
        ligado = None
    if ligado:
        garantir_yml(cfg, "Net", {"Internet enabled": "Disconnected", "PSN status": "Disconnected"})


def salvar_rpcn(npid, senha, token):
    d = ler_rpcn()
    linhas = ["Version: %s" % (d.get("Version") or 2),
              "Host: " + _yml_str(d.get("Host") or "np.rpcs3.net"),
              "NPID: " + _yml_str(npid),
              "Password: " + _yml_str(senha),
              "Token: " + _yml_str(token),
              "Hosts: " + _yml_str(d.get("Hosts") or RPCN_HOSTS)]
    if "Experimental IPv6 support" in d:
        linhas.append("Experimental IPv6 support: " + (d["Experimental IPv6 support"] or "false"))
    os.makedirs(RP, exist_ok=True)
    path = os.path.join(RP, "rpcn.yml")
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # tem senha: só o dono lê
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(linhas) + "\n")
    os.replace(tmp, path)


def rpcn_estado():
    d = ler_rpcn()
    out({"ok": True, "conta": tem_rpcn(), "npid": d.get("NPID", "") if tem_rpcn() else ""})


def rpcn_entrar(npid, token):
    npid, token = npid.strip(), token.strip().upper().replace(" ", "").replace("-", "")
    senha = os.environ.get("SKY_SENHA", "")
    if not RE_NPID.match(npid):
        return out({"ok": False, "error": "ID do RPCN inválido: 3 a 16 letras, números, - ou _"})
    if not senha:
        return out({"ok": False, "error": "Falta a senha da conta RPCN"})
    if not RE_TOKEN.match(token):
        return out({"ok": False, "error": "Token inválido: são 16 letras maiúsculas ou números (chega por e-mail)"})
    salvar_rpcn(npid, senha, token)
    garantir_net()
    out({"ok": True, "conta": True, "npid": npid, "message": f"Online do PS3 ligado: RPCN como {npid}"})


def rpcn_sair():
    d = ler_rpcn()
    if d:
        salvar_rpcn("", "", "")
    garantir_net()
    out({"ok": True, "conta": False, "npid": "", "message": "Online do PS3 desligado neste console"})


def user_id():
    """Cada perfil do SkyStation vira um usuário do RPCS3 (saves e troféus separados)."""
    try:
        with open(os.path.join(SKY, "perfis/perfis.json")) as f:
            d = json.load(f)
        ids = [p["id"] for p in d["perfis"]]
        return "%08d" % (ids.index(d["atual"]) + 1)
    except (OSError, ValueError, KeyError):
        return "00000001"


def patches(rom):
    """8.3: liga os patches oficiais do RPCS3 que o SkyStation recomenda para este jogo."""
    try:
        info = game_info(rom) if rom else None
        if info and info.get("id"):
            sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
            import skypatches
            return skypatches.aplicar(RP, info["id"])  # título vem da própria base
    except Exception as e:   # um patch nunca pode impedir o jogo de abrir
        sys.stderr.write(f"patches: {e}\n")
    return []


def anotar_ajustes(rom, ligados):
    """11.7: o benchmark da partida registra o perfil usado (config por jogo e patches ligados)."""
    try:
        info = game_info(rom) if rom else None
        serial = (info or {}).get("id", "")
        linhas = []
        if serial in POR_JOGO:
            corpo = [l.strip() for l in POR_JOGO[serial].splitlines()[1:] if l.startswith("  ")]
            linhas.append(f"RPCS3 {serial}: " + ", ".join(corpo))
        if ligados:
            linhas.append("patches: " + ", ".join(str(x) for x in ligados))
        if linhas:
            run = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skystation")
            with open(os.path.join(run, "game.ajustes"), "a", encoding="utf-8") as f:
                f.write("\n".join(linhas) + "\n")
    except Exception as e:   # nunca impede o jogo de abrir
        sys.stderr.write(f"ajustes: {e}\n")


def preparar(rom=""):
    if not os.access(RPCS3, os.X_OK):
        return out({"ok": False, "error": "Emulador de PS3 não instalado. Rode a Fase 7.0 (fase7-0.sh)."})
    n = os.cpu_count() or 1
    if n < MIN_THREADS and not os.path.exists(os.path.join(HOME, ".config/skystation/ps3-forcar")):
        return out({"ok": False, "error": f"PS3 precisa de um processador com {MIN_THREADS}+ threads (este tem {n}). Dê boot com o pendrive num PC mais forte."})
    write_if_missing(os.path.join(RP, "GuiConfigs/CurrentSettings.ini"), GUI_INI)
    garantir_ini(os.path.join(RP, "GuiConfigs/CurrentSettings.ini"), GUI_FORCAR)   # cursor escondido
    ajustes_por_jogo()
    ligados = patches(rom)
    anotar_ajustes(rom, ligados)
    write_if_missing(os.path.join(RP, "config.yml"), CONFIG_YML)
    garantir_net()
    yml, players = input_yaml()
    if not players:
        return out({"ok": False, "error": "Nenhum controle ligado: conecte o controle antes de abrir o jogo de PS3."})
    d = os.path.join(RP, "input_configs/global")
    os.makedirs(d, exist_ok=True)
    # 13.19: o mesmo perfil também como "Default": se uma versão do RPCS3 não aceitar --input-config
    # (aconteceu na atualização de 22/nov: "Unknown options"), o controle continua configurado.
    for nome in ("SkyStation.yml", "Default.yml"):
        with open(os.path.join(d, nome), "w") as f:
            f.write(yml)
    if not fw_ok():
        err = install_fw()
        if err:
            return out({"ok": False, "error": err})
    user = user_id()
    # Saves do PS3 dentro da pasta de saves do perfil: entram nas cópias de segurança e no .zip da Central web.
    sd = os.path.join(RP, "dev_hdd0/home", user, "savedata")
    alvo = os.path.join(os.path.realpath(os.path.join(SKY, "saves")), "ps3")
    try:
        if not os.path.lexists(sd):
            os.makedirs(os.path.dirname(sd), exist_ok=True)
            os.makedirs(alvo, exist_ok=True)
            os.symlink(alvo, sd)
    except OSError:
        pass
    out({"ok": True, "user": user, "patches": ligados, "controles": [f"{h}: {dv}" for h, dv, _ in players]})


def main():
    a = sys.argv[1:]
    if a[:1] == ["listar"]:
        listar()
    elif a[:1] == ["preparar"]:
        preparar(a[1] if len(a) > 1 else "")
    elif a[:1] == ["controles"]:
        yml, players = input_yaml()
        print(yml)
    elif a[:1] == ["rpcn"]:
        rpcn_estado()
    elif a[:1] == ["rpcn-entrar"] and len(a) == 3:
        rpcn_entrar(a[1], a[2])
    elif a[:1] == ["rpcn-sair"]:
        rpcn_sair()
    else:
        out({"ok": False, "error": "uso: sky-ps3 listar | preparar | controles | rpcn | rpcn-entrar ID TOKEN | rpcn-sair"})


if __name__ == "__main__":
    main()
