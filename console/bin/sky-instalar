#!/usr/bin/env python3
"""SkyStation (Fase 13.1): instala jogos que chegaram compactados (.zip, .7z, .rar) no SKYROMS.

  sky-instalar procurar     -> {"pendentes": [{"arquivo", "nome", "sistema", "tamanho"}]}
  sky-instalar rodar        -> instala todos, um por vez (o menu abre em segundo plano)
  sky-instalar estado       -> o que está acontecendo agora (o mesmo de instalando.json)
  sky-instalar falhas       -> {"falhas": [...]} os que não instalaram (e por quê)
  sky-instalar repetir [arq]-> esquece a falha (de um arquivo ou de todos) para tentar de novo

13.6 (21/nov): tudo fica anotado em SKYROMS/diag/instalar.log (cada etapa, com hora e duração) e a lista
do que falhou em SKYROMS/diag/instalar-falhas.txt, para ler no Windows. Antes de qualquer coisa pesada,
um teste rápido do cabeçalho pega .7z/.zip incompletos sem ler GBs; cada arquivo tem no máximo 2
tentativas; e um ISO de PS1/PS2/PS3 que caiu na pasta errada vai para a pasta do console certo.

Como instala:
  1. Extrai em uma pasta escondida ao lado (.nome.instalando), no mesmo disco: no fim é só renomear.
  2. Tira o lixo (leia-me, .nfo, .url) e as pastas "embrulho" (zip com uma pasta só dentro).
  3. Um arquivo só (PS2 .iso, PSP .cso, Dreamcast .cdi) vai direto para a pasta do sistema; jogo com
     várias faixas (.gdi + track01.bin…, .cue + .bin) ganha uma pasta própria, porque as faixas têm o
     mesmo nome em todos os jogos. PS3/PS4/Wii U em pasta continuam pasta.
  0. Antes de tudo, o sky-security confere o compactado: programa escondido ou vírus conhecido = vai
     para SKYROMS/.quarentena e não é instalado.
  4. Só depois de tudo certo apaga o compactado (e as partes .part2.rar / .7z.002).

O que fica de fora: .zip do PS Vita (o Vita3K instala direto dele), downloads pela metade
(.opdownload, .crdownload, .part) e arquivos alterados há menos de 1 minuto (ainda copiando).
O progresso vai para $XDG_RUNTIME_DIR/skystation/instalando.json, que o menu desenha.
"""
import fcntl
import importlib.machinery
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.abspath(__file__))
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skystation")
ESTADO = os.path.join(RUN, "instalando.json")
EVENTS = os.path.join(RUN, "events.jsonl")
TRAVA = os.path.join(RUN, "instalar.lock")
BASES = ["/mnt/skyroms", os.path.join(HOME, "skystation/roms"), "/mnt/skystation/roms"]
JOGOS = importlib.machinery.SourceFileLoader("sky_jogos", os.path.join(BIN, "sky-jogos")).load_module()
try:    # Fase 13.2: confere o compactado antes de extrair (programas escondidos, vírus conhecidos)
    SEG = importlib.machinery.SourceFileLoader("sky_security", os.path.join(BIN, "sky-security")).load_module()
except (OSError, ImportError, SyntaxError):
    SEG = None

NOMES = {"ps1": "PlayStation", "ps2": "PlayStation 2", "ps3": "PlayStation 3", "ps4": "PlayStation 4",
         "psp": "PSP", "vita": "PS Vita", "snes": "Super Nintendo", "n64": "Nintendo 64", "gc": "GameCube",
         "wii": "Nintendo Wii", "wiiu": "Wii U", "switch": "Nintendo Switch", "nds": "Nintendo DS",
         "3ds": "Nintendo 3DS", "gba": "Game Boy Advance", "gb": "Game Boy", "nes": "NES", "md": "Mega Drive",
         "x360": "Xbox 360", "xbox": "Xbox", "dc": "Dreamcast", "saturn": "Sega Saturn"}
PASTA_E_JOGO = {"ps3", "ps4", "wiiu"}      # o jogo pode ser uma pasta inteira
LIXO = JOGOS.LIXO          # leia-me, .nfo, .url… (só no "embrulho", nunca dentro do jogo)
LIXO_NOMES = {"thumbs.db", "desktop.ini", ".ds_store"}
COMPACTADO = re.compile(r"\.(zip|7z|rar)$|\.7z\.001$|\.zip\.001$", re.I)
PARTE_N = re.compile(r"\.part0*(\d+)\.rar$", re.I)
MIN_IDADE = 60          # segundos sem mudar para considerar que terminou de copiar
FALHAS = os.path.join(HOME, ".cache/skystation/instalar-falhas.json")
MAX_TENTATIVAS = 2      # o mesmo arquivo (mesmo tamanho e data) não é tentado mais que isso
_LOG = {"arq": None}


def _base_de(arquivo):
    """A raiz do SKYROMS onde o arquivo está (pai da pasta do sistema)."""
    return os.path.dirname(os.path.dirname(os.path.abspath(arquivo)))


def log(msg, arquivo=None):
    """Diário do instalador em SKYROMS/diag/instalar.log (dá para ler no Windows)."""
    if arquivo:
        _LOG["arq"] = os.path.join(_base_de(arquivo), "diag", "instalar.log")
    linha = f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}"
    sys.stderr.write(linha + "\n")
    if not _LOG["arq"]:
        return
    try:
        os.makedirs(os.path.dirname(_LOG["arq"]), exist_ok=True)
        if os.path.exists(_LOG["arq"]) and os.path.getsize(_LOG["arq"]) > 2_000_000:   # não cresce para sempre
            os.replace(_LOG["arq"], _LOG["arq"][:-4] + "-antigo.log")
        with open(_LOG["arq"], "a", encoding="utf-8") as f:
            f.write(linha + "\n")
    except OSError:
        pass


def _assinatura(arq):
    """Arquivo que já falhou só é tentado de novo se mudar (baixou de novo, outro tamanho/data)."""
    try:
        st = os.stat(arq)
        return f"{st.st_size}:{int(st.st_mtime)}"
    except OSError:
        return ""


def _falhas():
    try:
        with open(FALHAS) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    # 13.10: falha por "só leitura" é do disco/pasta, não do arquivo: não conta tentativa.
    # 13.14: mas também não fica em loop (a tela Instalando abria a cada 2 min): espera 30 min ou outro boot.
    agora, boot = time.time(), time.time() - _uptime()
    return {k: v for k, v in d.items()
            if "só leitura" not in v.get("erro", "")
            or (v.get("quando", 0) > agora - 1800 and v.get("quando", 0) > boot)}


def _uptime():
    try:
        with open("/proc/uptime") as f:
            return float(f.read().split()[0])
    except (OSError, ValueError):
        return 0.0


def _grava_falhas(d):
    os.makedirs(os.path.dirname(FALHAS), exist_ok=True)
    with open(FALHAS + ".tmp", "w") as f:
        json.dump(d, f, ensure_ascii=False)
    os.replace(FALHAS + ".tmp", FALHAS)
    _falhas_txt(d)


def _falhas_txt(d):
    """SKYROMS/diag/instalar-falhas.txt: o mesmo, em português, para quem olha pelo Windows."""
    bases = {}
    for real, v in d.items():
        bases.setdefault(_base_de(real), []).append((real, v))
    for base, itens in bases.items():
        try:
            os.makedirs(os.path.join(base, "diag"), exist_ok=True)
            with open(os.path.join(base, "diag", "instalar-falhas.txt"), "w", encoding="utf-8") as f:
                f.write("Jogos que o SkyStation não conseguiu instalar\n")
                f.write("(baixe de novo: um arquivo novo é tentado sozinho. Atualizado em "
                        f"{time.strftime('%d/%m %H:%M')})\n\n")
                for real, v in sorted(itens):
                    n = v.get("tentativas", 1)
                    f.write(f"- {os.path.relpath(real, base)}\n    {v.get('erro', '?')}\n"
                            f"    tentativas: {n}{' (desisti)' if n >= MAX_TENTATIVAS else ''}\n")
        except OSError:
            pass


def _anota_falha(arq, erro):
    d = _falhas()
    real = os.path.realpath(arq)
    ass = _assinatura(arq)
    antes = d.get(real, {})
    n = antes.get("tentativas", 1) + 1 if antes.get("assinatura") == ass else 1
    if arq.lower().endswith(".iso") and antes.get("extrator") != "iso2":
        n = 1                     # 13.15: tentativas do 7-Zip não contam para o leitor novo
    d[real] = {"assinatura": ass, "erro": erro, "tentativas": n, "quando": time.time(),
               "nome": nome_do_jogo(arq), "extrator": "iso2" if arq.lower().endswith(".iso") else ""}
    _grava_falhas(d)
    return n


def _anota_pausa(arq, erro):
    """13.14: 'só leitura' fica 30 min (ou até o próximo boot) sem tentar, sem gastar tentativa."""
    try:
        with open(FALHAS) as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    d[os.path.realpath(arq)] = {"assinatura": _assinatura(arq), "erro": erro, "tentativas": 0,
                                "quando": time.time(), "nome": nome_do_jogo(arq)}
    _grava_falhas(d)
    return 0


def _desistiu(falhas, real, arq):
    """Já tentou MAX_TENTATIVAS vezes este mesmo arquivo? (outro tamanho/data = arquivo novo)"""
    f = falhas.get(real)
    # 13.7: falha anotada antes da 13.6 não tem "tentativas" e contava como "já desisti": o arquivo nunca era
    # tentado de novo e o motivo não aparecia em lugar nenhum. Agora conta como 1 tentativa (ganha mais uma).
    if f and "só leitura" in f.get("erro", ""):
        return True               # 13.14: em pausa (o _falhas() só devolve as pausas recentes)
    if f and arq.lower().endswith(".iso") and f.get("extrator") != "iso2":
        return False              # 13.15: falhou com o 7-Zip; o leitor de ISO novo ganha tentativas novas
    return bool(f) and f.get("assinatura") == _assinatura(arq) and f.get("tentativas", 1) >= MAX_TENTATIVAS


def _esquece(arquivo=None):
    d = _falhas()
    if arquivo:
        d.pop(os.path.realpath(arquivo), None)
    else:
        d = {}
    _grava_falhas(d)
    return d


def _parte_principal(nome):
    """Só a 1ª parte de um compactado dividido conta; as outras vão junto."""
    m = PARTE_N.search(nome) or re.search(r"\.(?:7z|zip)\.(\d{3})$", nome, re.I)
    return int(m.group(1)) == 1 if m else True


def _partes(arquivo):
    """Todos os pedaços de um compactado (x.part1.rar, x.part2.rar… / x.7z.001, x.7z.002…)."""
    pasta, nome = os.path.split(arquivo)
    m = PARTE_N.search(nome)
    if m:
        raiz = nome[:m.start()]
        pad = re.compile(re.escape(raiz) + r"\.part0*\d+\.rar$", re.I)
    elif re.search(r"\.(7z|zip)\.001$", nome, re.I):
        pad = re.compile(re.escape(nome[:-4]) + r"\.\d{3}$", re.I)
    else:
        return [arquivo]
    return sorted(os.path.join(pasta, n) for n in os.listdir(pasta) if pad.match(n))


def _parado(arq, espera=2.0):
    """O tamanho não muda em alguns segundos? (vale mesmo com o relógio do arquivo errado)"""
    try:
        antes = os.path.getsize(arq)
        time.sleep(espera)
        return os.path.getsize(arq) == antes
    except OSError:
        return False


def nome_do_jogo(arquivo):
    n = os.path.basename(arquivo)
    n = re.sub(r"(\.part0*\d+)?\.(zip|7z|rar|pkg)(\.\d{3})?$", "", n, flags=re.I)
    return n.strip() or "jogo"


# 13.12: PS3 que não roda direto do .iso: vira pasta aqui, com a tela Instalando (antes era na hora de abrir o jogo,
# sem nada na tela, e quem fechava deixava a extração pela metade). Assassin's Creed: pelo .iso o RPCS3 devolve o
# caminho do disco vazio e o jogo fica em tela preta; a série também exige PS3_GAME/USRDIR/ASSASSIN_ISO.
ISO_PARA_PASTA = {"BLUS30089", "BLES00158", "BLJM60052"}
_PS3 = {}


def _ps3_id(iso):
    try:
        chave = (iso, os.path.getsize(iso))
    except OSError:
        return ""
    if chave not in _PS3:
        try:
            mod = importlib.machinery.SourceFileLoader("sky_ps3", os.path.join(BIN, "sky-ps3")).load_module()
            _PS3[chave] = (mod.game_info(iso) or {}).get("id", "")
        except Exception:
            _PS3[chave] = ""
    return _PS3[chave]


def _iso_arvore(iso):
    """13.15: lista os arquivos de um ISO 9660 (Joliet se houver), juntando arquivos em várias partes
    (multi-extent: o DATAPS3_KINGDOM.FORGE do AC tem 2). Devolve [(caminho, [(lba, tamanho), ...])]."""
    with open(iso, "rb") as f:
        def setor(lba, n=2048):
            f.seek(lba * 2048)
            return f.read(n)
        vd, joliet = None, False
        for lba in range(16, 64):
            d = setor(lba)
            if d[1:6] != b"CD001" or d[0] == 255:
                break
            if d[0] == 1 and vd is None:
                vd = d
            elif d[0] == 2 and d[88:91] in (b"%/@", b"%/C", b"%/E"):
                vd, joliet = d, True
        if vd is None:
            raise RuntimeError("não é um ISO de disco (sem descritor de volume)")
        def nome(raw):
            n = raw.decode("utf-16-be", "replace") if joliet else raw.decode("ascii", "replace")
            return n.split(";")[0].rstrip(".") if not joliet else n.split(";")[0]
        saida, vistos = [], set()
        def anda(lba, tam, pasta):
            if lba in vistos:
                return
            vistos.add(lba)
            dados = setor(lba, tam)
            i, partes, atual = 0, [], None
            while i < len(dados):
                ln = dados[i]
                if ln == 0:
                    i = (i // 2048 + 1) * 2048
                    continue
                r = dados[i:i + ln]
                i += ln
                nl = r[32]
                raw = r[33:33 + nl]
                if raw in (b"\x00", b"\x01"):
                    continue
                el, es, fl = int.from_bytes(r[2:6], "little"), int.from_bytes(r[10:14], "little"), r[25]
                n = nome(raw)
                if fl & 0x02:
                    anda(el, es, os.path.join(pasta, n))
                    continue
                if atual is not None and atual[0] == n:
                    atual[1].append((el, es))
                else:
                    atual = (n, [(el, es)])
                    partes.append(atual)
                if not fl & 0x80:          # última parte deste arquivo
                    atual = None
            saida.extend((os.path.join(pasta, n), ext) for n, ext in partes)
            if not partes:
                saida.append((pasta + "/", []))        # pasta vazia (ex.: ASSASSIN_ISO) também existe
        raiz = vd[156:190]
        anda(int.from_bytes(raiz[2:6], "little"), int.from_bytes(raiz[10:14], "little"), "")
        return saida


def extrair_iso(iso, destino, progresso):
    """13.15: extrai um ISO 9660 sem o 7-Zip (que falhava no AC: 'arquivo corrompido' em 2 tentativas, com
    o mesmo .iso que o RPCS3 abre). Lê os setores direto, inclusive arquivos em várias partes."""
    arvore = _iso_arvore(iso)
    total = sum(t for _, ext in arvore for _, t in ext) or 1
    feito = 0
    os.makedirs(destino, exist_ok=True)
    with open(iso, "rb") as f:
        for caminho, ext in arvore:
            alvo = os.path.join(destino, caminho.lstrip("/"))
            if caminho.endswith("/"):
                os.makedirs(alvo, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(alvo), exist_ok=True)
            with open(alvo, "wb") as out:
                for lba, tam in ext:
                    f.seek(lba * 2048)
                    falta = tam
                    while falta:
                        bloco = f.read(min(falta, 8 * 1024 * 1024))
                        if not bloco:
                            raise RuntimeError(f"o .iso acaba antes do fim de {caminho} (arquivo incompleto)")
                        out.write(bloco)
                        falta -= len(bloco)
                        feito += len(bloco)
                        progresso(min(0.99, feito / total))
    return feito


def iso_vira_pasta(arq, sis):
    return (sis == "ps3" and arq.lower().endswith(".iso")
            and not os.path.isdir(os.path.join(os.path.splitext(arq)[0], "PS3_GAME"))
            and _ps3_id(arq) in ISO_PARA_PASTA)


def procurar(com_falhas=False):
    achados, vistos = [], set()
    falhas = {} if com_falhas else _falhas()
    agora = time.time()
    for base in BASES:
        try:
            pastas = os.listdir(base)
        except OSError:
            continue
        for p in pastas:
            sis = JOGOS.sistema_da_pasta(p)
            pasta = os.path.join(base, p)
            if not sis or not os.path.isdir(pasta):
                continue
            try:
                nomes = sorted(os.listdir(pasta), key=str.lower)
            except OSError:
                continue
            for n in nomes:
                arq = os.path.join(pasta, n)
                pkg_solto = sis == "ps4" and n.lower().endswith(".pkg")     # 13.8: .pkg de PS4 sem compactar
                iso_ps3 = not n.startswith(".") and os.path.isfile(arq) and iso_vira_pasta(arq, sis)   # 13.12
                if n.startswith(".") or not (pkg_solto or iso_ps3 or COMPACTADO.search(n)) or not _parte_principal(n) \
                        or not os.path.isfile(arq):
                    continue
                if sis == "vita" and n.lower().endswith(".zip"):
                    continue                         # o .zip É o jogo de Vita
                try:
                    st = os.stat(arq)
                except OSError:
                    continue
                partes = _partes(arq)
                idade = agora - max(os.path.getmtime(x) for x in partes)
                # 13.4: data no FUTURO não é "ainda copiando": é o relógio do Windows adiantado (dual boot:
                # o Linux grava o relógio da placa em UTC e o Windows lê como horário local). Antes, esses
                # jogos sumiam da fila até o relógio de verdade alcançar a data do arquivo.
                if 0 <= idade < MIN_IDADE:
                    continue                         # ainda chegando (cópia, download)
                real = os.path.realpath(arq)
                if real in vistos or _desistiu(falhas, real, arq):
                    continue
                vistos.add(real)
                achados.append({"arquivo": arq, "nome": os.path.splitext(n)[0] if iso_ps3 else nome_do_jogo(arq), "sistema": sis,
                                "tamanho": sum(os.path.getsize(x) for x in partes)})
    return achados


# ---------------------------------------------------------------- conferências rápidas (13.6)

def cabecalho_ok(arquivo):
    """Teste barato (lê poucos KB): o compactado está inteiro? None = ok; senão o motivo.
    .7z: o 7-Zip escreve o cabeçalho de início por último; zerado = compactação ou download interrompido.
    .zip: o diretório central fica no fim; sem ele, o arquivo foi cortado."""
    n = arquivo.lower()
    try:
        tam = os.path.getsize(arquivo)
        with open(arquivo, "rb") as f:
            if n.endswith(".7z"):
                h = f.read(32)
                if h[:6] != b"7z\xbc\xaf\x27\x1c":
                    return "não é um .7z de verdade (baixe de novo)"
                import struct
                off, size = struct.unpack("<QQ", h[12:28])
                if off == 0 and size == 0:
                    return "o .7z não foi terminado (cabeçalho zerado): a compactação ou o download parou no meio. Baixe de novo"
                if 32 + off + size > tam:
                    return "o .7z está cortado (falta o fim do arquivo). Baixe de novo"
            elif n.endswith(".zip"):
                f.seek(max(0, tam - 70000))
                if b"PK\x05\x06" not in f.read() and tam < 0xFFFFFFFF:
                    return "o .zip está cortado (falta o fim do arquivo). Baixe de novo"
    except OSError as e:
        return f"não consegui ler o arquivo ({e.strerror})"
    return None


def _nomes_de_dentro(arquivo):
    """Nomes dos arquivos de dentro (sem extrair). [] se não deu para ler."""
    if arquivo.lower().endswith(".zip"):
        try:
            import zipfile
            with zipfile.ZipFile(arquivo) as z:
                return z.namelist()
        except (OSError, ValueError, RuntimeError, __import__("zipfile").BadZipFile):
            return []
    f = _ferramenta()
    if f and os.path.basename(f[0]).startswith("7z"):
        try:
            r = subprocess.run(f + ["l", "-slt", "-ba", arquivo], capture_output=True, text=True, timeout=120)
            return re.findall(r"^Path = (.+)$", r.stdout, re.M)
        except (OSError, subprocess.SubprocessError):
            pass
    return []


def conteudo_ok(arquivo, sis):
    """13.7: recusa antes de extrair o que o console não sabe abrir. None = ok."""
    nomes = [n.replace("\\", "/") for n in _nomes_de_dentro(arquivo)]
    if sis == "ps4" and nomes:
        base = {os.path.basename(n).lower() for n in nomes}
        if "eboot.bin" not in base and any(n.lower().endswith(".pkg") for n in nomes) and not os.access(ORBIS, os.X_OK):
            return ("é um .pkg de PS4 e o extrator de .pkg ainda não está instalado no console. "
                    "Rode Sistema → Atualizar o SkyStation (com internet) e ele tenta de novo")
    return None


ORBIS = "/opt/orbis/bin/orbis-pkg-util"


def _pkgs_em(caminho):
    """.pkg dentro do que foi extraído (arquivo solto ou pasta), só se não houver já um eboot.bin."""
    if os.path.isfile(caminho):
        return [caminho] if caminho.lower().endswith(".pkg") else []
    achados, tem_eboot = [], False
    for d, _, fs in os.walk(caminho):
        for x in fs:
            if x.lower() == "eboot.bin":
                tem_eboot = True
            elif x.lower().endswith(".pkg"):
                achados.append(os.path.join(d, x))
    return [] if tem_eboot else sorted(achados, key=os.path.getsize, reverse=True)


def pkg_info(pkg):
    """Title ID e tipo do .pkg (orbis-pkg-util info)."""
    try:
        r = subprocess.run([ORBIS, "info", pkg], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return {}
    d = {}
    for ln in r.stdout.splitlines():
        if ":" in ln:
            k, v = ln.split(":", 1)
            d[k.strip().lower()] = v.strip()
    return d


def instalar_pkg(pkg, pasta_sistema, nome, progresso):
    """13.8: .pkg de PS4 -> pasta do jogo (eboot.bin + sce_sys) que o shadPS4 abre. Devolve o caminho final."""
    if not os.access(ORBIS, os.X_OK):
        raise RuntimeError("falta o extrator de .pkg de PS4. Rode Sistema → Atualizar o SkyStation (com internet)")
    info = pkg_info(pkg)
    tid = info.get("title id", "") or nome
    tipo = info.get("content type", "").lower()
    log(f"   .pkg: {tid} · {info.get('content type', '?')} · DRM {info.get('drm type', '?')}")
    if any(x in tipo for x in ("patch", "additional content", "app license")):   # DP, AC, AL (não é o jogo)
        raise RuntimeError(f"este .pkg é atualização ou DLC ({info.get('content type')}), não o jogo. Instale o jogo base primeiro")
    total = os.path.getsize(pkg)
    livre = shutil.disk_usage(pasta_sistema).free
    if total + 200 * 1024 * 1024 > livre:
        raise RuntimeError(f"falta espaço para abrir o .pkg: precisa de {total / 1e9:.1f} GB e há {livre / 1e9:.1f} GB livres")
    tmp = os.path.join(pasta_sistema, f".{tid}.pkg-instalando")
    shutil.rmtree(tmp, ignore_errors=True)
    proc = subprocess.Popen([ORBIS, "extract", pkg, "-o", tmp, "-q", "-f"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    while proc.poll() is None:
        time.sleep(0.5)
        progresso(min(0.99, _du(tmp) / total) if total else 0.5)
    if proc.returncode != 0:
        err = (proc.stderr.read() if proc.stderr else "").strip().splitlines()
        shutil.rmtree(tmp, ignore_errors=True)
        motivo = err[-1] if err else f"código {proc.returncode}"
        log(f"   orbis-pkg-util: {' | '.join(err[-6:])}")
        if any(x in motivo.lower() for x in ("decrypt", "key", "ekpfs", "encrypted")):
            motivo = "o .pkg é criptografado de loja (só .pkg 'fake'/fpkg abre no emulador)"
        raise RuntimeError(f"não consegui abrir o .pkg: {motivo}"[:200])
    jogo = None      # a pasta com eboot.bin mais perto da raiz
    for d, _, fs in os.walk(tmp):
        if any(x.lower() == "eboot.bin" for x in fs):
            if jogo is None or d.count(os.sep) < jogo.count(os.sep):
                jogo = d
    if not jogo:
        shutil.rmtree(tmp, ignore_errors=True)
        raise RuntimeError("o .pkg abriu mas não tem eboot.bin (é atualização, DLC ou tema?)")
    final = _sem_conflito(os.path.join(pasta_sistema, nome))
    os.replace(jogo, final)
    shutil.rmtree(tmp, ignore_errors=True)
    log(f"   .pkg aberto: {final}")
    return final


def _iso_raiz(caminho):
    """Nomes da raiz de um ISO 9660 (PS1/PS2/PS3), em maiúsculas. Vazio se não for ISO."""
    try:
        with open(caminho, "rb") as f:
            f.seek(16 * 2048)
            pvd = f.read(2048)
            if pvd[1:6] != b"CD001":
                return set()
            rec = pvd[156:190]
            lba = int.from_bytes(rec[2:6], "little")
            tam = int.from_bytes(rec[10:14], "little")
            f.seek(lba * 2048)
            dados = f.read(min(tam, 64 * 1024))
    except OSError:
        return set()
    nomes, i = set(), 0
    while i < len(dados):
        ln = dados[i]
        if ln == 0:                       # fim do setor: pula para o próximo
            i = (i // 2048 + 1) * 2048
            continue
        nl = dados[i + 32]
        nome = dados[i + 33:i + 33 + nl].decode("ascii", "replace").split(";")[0].upper()
        if nome not in ("\x00", "\x01"):
            nomes.add(nome)
        i += ln
    return nomes


def sistema_do_iso(caminho):
    """ps3 (PS3_GAME), ps2 (SYSTEM.CNF com BOOT2) ou ps1 (SYSTEM.CNF com BOOT). None = não sei."""
    if not caminho.lower().endswith(".iso"):
        return None
    raiz = _iso_raiz(caminho)
    if "PS3_GAME" in raiz or "PS3_DISC.SFB" in raiz:
        return "ps3"
    if "SYSTEM.CNF" in raiz:
        try:   # o SYSTEM.CNF é pequeno: lê pelo próprio diretório
            with open(caminho, "rb") as f:
                f.seek(16 * 2048)
                pvd = f.read(2048)
                rec = pvd[156:190]
                f.seek(int.from_bytes(rec[2:6], "little") * 2048)
                d = f.read(64 * 1024)
                i = d.find(b"SYSTEM.CNF;1")
                if i > 33:
                    r = i - 33
                    lba = int.from_bytes(d[r + 2:r + 6], "little")
                    f.seek(lba * 2048)
                    cnf = f.read(2048).upper()
                    if b"BOOT2" in cnf:
                        return "ps2"
                    if b"BOOT" in cnf:
                        return "ps1"
        except OSError:
            pass
    return None


def _pasta_do_sistema(pasta_atual, sis):
    """Pasta do sistema 'sis' no mesmo SKYROMS (usa a que já existir, com apelido ou não)."""
    base = os.path.dirname(pasta_atual)
    try:
        for n in sorted(os.listdir(base)):
            if JOGOS.sistema_da_pasta(n) == sis and os.path.isdir(os.path.join(base, n)):
                return os.path.join(base, n)
    except OSError:
        pass
    p = os.path.join(base, sis)
    os.makedirs(p, exist_ok=True)
    return p


# ---------------------------------------------------------------- extração

class Bloqueado(RuntimeError):
    """O sky-security mandou o compactado para a quarentena."""


def _ferramenta():
    for b in ("7z", "7zz", "7za"):
        if shutil.which(b):
            return [shutil.which(b)]
    if shutil.which("bsdtar"):
        return [shutil.which("bsdtar")]
    return None


def tamanho_extraido(arquivo):
    """Soma dos arquivos de dentro (para a barra de progresso e para conferir o espaço)."""
    f = _ferramenta()
    try:
        if f and os.path.basename(f[0]).startswith("7z"):
            r = subprocess.run(f + ["l", "-slt", "-ba", arquivo], capture_output=True, text=True, timeout=120)
            return sum(int(m) for m in re.findall(r"^Size = (\d+)", r.stdout, re.M))
        if f:
            r = subprocess.run(f + ["-tvf", arquivo], capture_output=True, text=True, timeout=120)
            return sum(int(c[4]) for c in (ln.split() for ln in r.stdout.splitlines()) if len(c) > 4 and c[4].isdigit())
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    return 0


def _du(pasta):
    total = 0
    for d, _, fs in os.walk(pasta):
        for x in fs:
            try:
                total += os.lstat(os.path.join(d, x)).st_size
            except OSError:
                pass
    return total


def extrair(arquivo, destino, total, progresso):
    f = _ferramenta()
    if not f:
        raise RuntimeError("Falta o 7-Zip no console. Rode Sistema → Atualizar o SkyStation.")
    if os.path.basename(f[0]).startswith("7z"):
        cmd = f + ["x", "-y", "-bd", "-bso0", "-bsp0", "-p", "-o" + destino, arquivo]   # -p: sem senha (não trava)
    else:
        cmd = f + ["-xf", arquivo, "-C", destino]
    os.makedirs(destino, exist_ok=True)
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    while proc.poll() is None:
        time.sleep(0.5)
        if total:
            progresso(min(0.99, _du(destino) / total))
    if proc.returncode != 0:
        erro = (proc.stderr.read() if proc.stderr else "").strip().splitlines()
        motivo = erro[-1] if erro else f"código {proc.returncode}"
        m = motivo.lower()
        if "password" in m or "senha" in m or "encrypted" in m:
            motivo = "o arquivo tem senha"
        elif any(x in m for x in ("crc", "data error", "unexpected end", "not archive", "can not open",
                                  "cannot open", "headers error", "truncated", "unrecognized")):
            motivo = "arquivo corrompido ou incompleto (baixe de novo)"
        elif "no space" in m or "disk full" in m:
            motivo = "acabou o espaço no disco"
        raise RuntimeError(motivo[:160])


def _limpar(pasta):
    """Desembrulha (zip com uma pasta só dentro vira o conteúdo dela) e tira o lixo de cada camada de
    embrulho. Não entra no jogo: PS3/PS4 têm .png e .txt de verdade dentro das pastas deles."""
    atual = pasta
    while True:
        shutil.rmtree(os.path.join(atual, "__MACOSX"), ignore_errors=True)
        for x in os.listdir(atual):
            c = os.path.join(atual, x)
            if os.path.isfile(c) and (os.path.splitext(x)[1].lower() in LIXO or x.lower() in LIXO_NOMES):
                try:
                    os.remove(c)
                except OSError:
                    pass
        itens = os.listdir(atual)
        if len(itens) == 1 and os.path.isdir(os.path.join(atual, itens[0])):
            atual = os.path.join(atual, itens[0])
            if _parece_jogo_em_pasta(atual):
                return atual        # a pasta É o jogo (PS3/PS4/Wii U): não entra nela
        else:
            return atual


def _parece_jogo_em_pasta(p):
    """PS3 (PS3_GAME), PS4 (eboot.bin + sce_sys), Wii U (code/content/meta): a pasta É o jogo."""
    nomes = {x.lower() for x in os.listdir(p)}
    return bool(nomes & {"ps3_game", "sce_sys", "eboot.bin"}) or {"code", "content", "meta"} <= nomes


def _sem_conflito(caminho):
    if not os.path.exists(caminho):
        return caminho
    raiz, ext = os.path.splitext(caminho)
    for i in range(2, 100):
        c = f"{raiz} ({i}){ext}"
        if not os.path.exists(c):
            return c
    raise RuntimeError("já existe um jogo com esse nome")


def posicionar(conteudo, pasta_sistema, nome, sis):
    """Coloca o que foi extraído no lugar certo. Devolve o caminho final do jogo."""
    if not os.listdir(conteudo):
        raise RuntimeError("o compactado estava vazio")
    arquivos = [os.path.join(d, x) for d, _, fs in os.walk(conteudo) for x in fs]
    if len(arquivos) == 1 and not (sis in PASTA_E_JOGO and _parece_jogo_em_pasta(conteudo)):
        final = _sem_conflito(os.path.join(pasta_sistema, os.path.basename(arquivos[0])))
        os.replace(arquivos[0], final)
        return final
    # várias faixas, ou jogo em pasta: uma pasta só para ele, com o nome do compactado
    final = _sem_conflito(os.path.join(pasta_sistema, nome))
    os.replace(conteudo, final)
    return final


# ---------------------------------------------------------------- estado e avisos

def _grava_estado(d):
    os.makedirs(RUN, exist_ok=True)
    d["t"] = time.time()
    tmp = ESTADO + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, ensure_ascii=False)
    os.replace(tmp, ESTADO)


def _aviso(kind, text=""):
    try:
        with open(EVENTS, "a") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, "text": text}, ensure_ascii=False) + "\n")
    except OSError:
        pass
    if text:
        try:
            sys.path.insert(0, BIN)
            import skyhist
            skyhist.add(kind, text)
        except Exception:
            pass


def rodar():
    os.makedirs(RUN, exist_ok=True)
    trava = open(TRAVA, "w")
    try:
        fcntl.flock(trava, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(json.dumps({"ok": False, "error": "já está instalando"}))
        return
    feitos, erros, total_jogos = [], [], 0
    d = _falhas()
    _falhas_txt(d)                # 13.7: as falhas antigas também aparecem em SKYROMS/diag
    fila = procurar()
    total_jogos = len(fila)
    st = {"ativo": True, "total": total_jogos, "feitos": 0, "erros": [], "fila": [j["nome"] for j in fila]}
    _grava_estado(st)
    while fila:
        jogo = fila.pop(0)
        arq, sis, nome = jogo["arquivo"], jogo["sistema"], jogo["nome"]
        pasta = os.path.dirname(arq)
        st.update({"atual": {"nome": nome, "sistema": sis, "sistema_nome": NOMES.get(sis, sis.upper()),
                             "pct": 0.0, "etapa": "Preparando"},
                   "fila": [j["nome"] for j in fila], "feitos": len(feitos)})
        _grava_estado(st)
        tmp = os.path.join(pasta, "." + nome + ".instalando")
        t0 = time.time()
        log(f"== {nome} ({sis}) <- {os.path.basename(arq)} ({jogo.get('tamanho', 0) / 1e9:.2f} GB)", arq)
        try:
            if not os.path.exists(arq):
                raise RuntimeError("o arquivo sumiu")
            if not _parado(arq):
                jogo["esperas"] = jogo.get("esperas", 0) + 1
                if jogo["esperas"] <= 30:      # ainda crescendo (cópia em andamento): tenta no fim da fila
                    fila.append(jogo)
                    if len(fila) == 1:
                        time.sleep(10)
                    st["total"] = max(st["total"], len(feitos) + len(erros) + len(fila))
                continue                       # desistiu por agora: a próxima procura do menu pega de novo
            if not JOGOS.gravavel(pasta):
                # 13.14: com o disco gravável, o culpado é a própria pasta (criada pelo Windows com uma trava
                # que o Linux não consegue tirar). Foi assim com ps4, wiiu e ps3 em 21/nov.
                disco_ok = JOGOS.gravavel(os.path.dirname(pasta))
                raise RuntimeError(
                    f"a pasta {os.path.basename(pasta)} está só leitura: no Windows, renomeie a pasta, crie uma nova "
                    f"com o nome {os.path.basename(pasta)} e mova os jogos para ela" if disco_ok else
                    "a pasta está só leitura (no Windows, desligue a Inicialização rápida)")
            def progresso(p):
                st["atual"].update({"pct": round(p, 3), "etapa": "Instalando"})
                _grava_estado(st)

            if iso_vira_pasta(arq, sis):                             # 13.12: .iso de PS3 -> pasta
                destino = os.path.splitext(arq)[0]
                parcial = destino + ".parcial"
                shutil.rmtree(parcial, ignore_errors=True)
                total = os.path.getsize(arq)
                if total + 200 * 1024 * 1024 > shutil.disk_usage(pasta).free:
                    raise RuntimeError(f"falta espaço para preparar o jogo: precisa de {total / 1e9:.1f} GB")
                st["atual"]["etapa"] = "Instalando"
                _grava_estado(st)
                t1 = time.time()
                extrair_iso(arq, parcial, progresso)
                if not os.path.isdir(os.path.join(parcial, "PS3_GAME")):
                    shutil.rmtree(parcial, ignore_errors=True)
                    raise RuntimeError("o .iso abriu mas não tem PS3_GAME")
                os.makedirs(os.path.join(parcial, "PS3_GAME", "USRDIR", "ASSASSIN_ISO"), exist_ok=True)
                os.replace(parcial, destino)
                guarda = os.path.join(pasta, ".iso-originais")
                os.makedirs(guarda, exist_ok=True)
                os.replace(arq, os.path.join(guarda, os.path.basename(arq)))
                log(f"   .iso virou pasta em {time.time() - t1:.0f} s: {destino} (original em .iso-originais)", arq)
                feitos.append({"nome": nome, "sistema": sis, "caminho": destino})
                _esquece(arq)
                _aviso("jogos")
                _aviso("jogo", f"{nome} pronto para jogar ({NOMES.get(sis, sis)})")
                st.update({"feitos": len(feitos), "erros": erros})
                continue
            if sis == "ps4" and arq.lower().endswith(".pkg"):        # 13.8: .pkg solto
                st["atual"]["etapa"] = "Instalando"
                _grava_estado(st)
                final = instalar_pkg(arq, pasta, nome, progresso)
                os.remove(arq)
                feitos.append({"nome": nome, "sistema": sis, "caminho": final})
                _esquece(arq)
                log(f"   ok em {time.time() - t0:.0f} s: {final}", arq)
                _aviso("jogos")
                _aviso("jogo", f"{nome} instalado ({NOMES.get(sis, sis)})")
                st.update({"feitos": len(feitos), "erros": erros})
                continue
            ruim = cabecalho_ok(arq)
            if ruim:
                raise RuntimeError(ruim)
            ruim = conteudo_ok(arq, sis)
            if ruim:
                raise RuntimeError(ruim)
            total = tamanho_extraido(arq)
            log(f"   cabeçalho ok; {total / 1e9:.2f} GB depois de extrair", arq)
            livre = shutil.disk_usage(pasta).free
            if total and total + 100 * 1024 * 1024 > livre:
                raise RuntimeError(f"falta espaço: precisa de {total / 1e9:.1f} GB e há {livre / 1e9:.1f} GB livres")
            shutil.rmtree(tmp, ignore_errors=True)     # sobra de uma tentativa interrompida
            if SEG:
                st["atual"]["etapa"] = "Verificando"
                _grava_estado(st)
                t1 = time.time()
                seg = SEG.verificar(arq, partes=_partes(arq), sistema=sis, avisar=False)
                log(f"   sky-security: {'ok' if seg['ok'] else seg.get('motivo')} ({time.time() - t1:.0f} s)", arq)
                if not seg["ok"]:
                    raise Bloqueado(f"bloqueado pelo sky-security: {seg['motivo']}. Está em SKYROMS/.quarentena")

            st["atual"]["etapa"] = "Instalando"
            t1 = time.time()
            extrair(arq, tmp, total, progresso)
            log(f"   extraído em {time.time() - t1:.0f} s", arq)
            st["atual"].update({"pct": 1.0, "etapa": "Finalizando"})
            _grava_estado(st)
            final = posicionar(_limpar(tmp), pasta, nome, sis)
            pkgs = _pkgs_em(final) if sis == "ps4" else []
            if pkgs:                       # 13.8: o compactado trazia um .pkg (ex.: P.T.): abre o maior
                st["atual"].update({"pct": 0.0, "etapa": "Instalando"})
                _grava_estado(st)
                velho = final
                final = instalar_pkg(pkgs[0], pasta, nome + " (pkg)" if os.path.isdir(velho) else nome, progresso)
                if os.path.isdir(velho):
                    shutil.rmtree(velho, ignore_errors=True)
                else:
                    os.remove(velho)
                if final.endswith(" (pkg)"):
                    limpo = _sem_conflito(final[:-6])
                    os.replace(final, limpo)
                    final = limpo
            certo = sistema_do_iso(final) if sis in ("ps1", "ps2", "ps3") and os.path.isfile(final) else None
            if certo and certo != sis:     # ex.: Gran Turismo 3 (PS2) baixado na pasta ps3
                destino = _sem_conflito(os.path.join(_pasta_do_sistema(pasta, certo), os.path.basename(final)))
                os.replace(final, destino)
                log(f"   era jogo de {NOMES.get(certo, certo)}, não de {NOMES.get(sis, sis)}: movido para {os.path.basename(os.path.dirname(destino))}/", arq)
                _aviso("jogo", f"{nome} é de {NOMES.get(certo, certo)}: mudei para a pasta certa")
                final, sis = destino, certo
            shutil.rmtree(tmp, ignore_errors=True)
            for parte in _partes(arq):
                os.remove(parte)
            feitos.append({"nome": nome, "sistema": sis, "caminho": final})
            _esquece(arq)
            log(f"   ok em {time.time() - t0:.0f} s: {final}", arq)
            _aviso("jogos")
            _aviso("jogo", f"{nome} instalado ({NOMES.get(sis, sis)})")
        except (OSError, RuntimeError, subprocess.SubprocessError) as e:
            shutil.rmtree(tmp, ignore_errors=True)
            erros.append({"nome": nome, "erro": str(e)})
            n = 0
            # 13.9: "só leitura" é do disco, não do arquivo: não gasta tentativa (13.14: mas pausa 30 min)
            if not isinstance(e, Bloqueado):
                n = _anota_falha(arq, str(e)) if "só leitura" not in str(e) else _anota_pausa(arq, str(e))
            log(f"   FALHOU (tentativa {n or '-'}, {time.time() - t0:.0f} s): {e}", arq)
            _aviso("jogo", f"Não instalei {nome}: {e}")
        st.update({"feitos": len(feitos), "erros": erros})
        # chegou outro compactado enquanto instalava? entra na fila
        conhecidos = {j["arquivo"] for j in fila} | {f["nome"] for f in feitos} | {x["nome"] for x in erros}
        for novo in procurar():
            if novo["arquivo"] not in conhecidos and novo["nome"] not in conhecidos:
                fila.append(novo)
                st["total"] = st["total"] + 1
    st.update({"ativo": False, "atual": None, "fila": [], "feitos": len(feitos), "erros": erros})
    _grava_estado(st)
    print(json.dumps({"ok": not erros, "instalados": len(feitos), "erros": erros}, ensure_ascii=False))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "procurar"
    if cmd == "procurar":
        print(json.dumps({"pendentes": procurar()}, ensure_ascii=False))
    elif cmd == "rodar":
        rodar()
    elif cmd == "falhas":
        print(json.dumps({"falhas": [dict(v, arquivo=k) for k, v in _falhas().items()]}, ensure_ascii=False))
    elif cmd == "repetir":
        _esquece(sys.argv[2] if len(sys.argv) > 2 else None)
        print(json.dumps({"ok": True}))
    elif cmd == "estado":
        try:
            print(open(ESTADO).read())
        except OSError:
            print(json.dumps({"ativo": False}))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
