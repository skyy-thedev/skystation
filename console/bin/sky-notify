#!/usr/bin/env python3
"""SkyStation: avisos do sistema (Fase 5.6).

Roda a sessão inteira em segundo plano (iniciado pelo sky-shell) e toca um som diferente para
cada coisa que acontece, mesmo com um jogo aberto:

  controle conectado / desconectado      dispositivo USB conectado / removido
  pendrive de jogos (SKYROMS) conectado  jogo novo encontrado
  carregador ligado / desligado          bateria do console em 15 %, 5 % e 3 %
  bateria do controle fraca              temperatura alta
  disco de PS1/PS2 no leitor (Fase 5.8): identifica e escreve $XDG_RUNTIME_DIR/skystation/disco.json
  TV ligada/desligada no HDMI (Fase 6.0): o som vai para a TV e volta sozinho

Cada aviso também vira uma linha em $XDG_RUNTIME_DIR/skystation/events.jsonl, que o launcher
lê para mostrar a notificação na tela. Com a bateria em 3 % (descarregando), o jogo aberto é
fechado do jeito certo (para o emulador gravar o save) e o console desliga sozinho.

Sons em /opt/skystation/sounds (gerados por tools/gerar-sons.py). Para silenciar os avisos:
  touch ~/.config/skystation/avisos.off
"""
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skystation")
EVENTS = os.path.join(RUN, "events.jsonl")
SOUNDS = "/opt/skystation/sounds"
CONF = os.path.expanduser("~/.config/skystation")
HOME = os.path.expanduser("~")
SKYROMS = "/mnt/skyroms"
ROM_EXTS = {"ps1": {"cue", "chd", "pbp", "m3u", "iso", "img"}, "ps2": {"iso", "chd", "cso", "gz"}}
GAME_DIRS = ["/opt/skystation/games", os.path.join(HOME, "skystation/games")]
ROM_BASES = [os.path.join(HOME, "skystation/roms"), SKYROMS, "/mnt/skystation/roms"]

DISCO_JSON = os.path.join(RUN, "disco.json")
EVENT_LOCK = threading.Lock()
try:  # sky-disco (mesma pasta) faz a leitura do disco
    import importlib.machinery
    disco = importlib.machinery.SourceFileLoader(
        "sky_disco", os.path.join(os.path.dirname(os.path.realpath(__file__)), "sky-disco")).load_module()
except Exception:
    disco = None

try:
    import evdev
    from evdev import ecodes as E
except ImportError:
    evdev = None


def log(msg):
    print(time.strftime("%H:%M:%S"), "sky-notify:", msg, flush=True)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


# ------------------------------------------------------------------ som e eventos
PLAYER = next((p for p in ("pw-play", "paplay", "aplay") if shutil.which(p)), None)


def play(name):
    if not name or PLAYER is None or os.path.exists(os.path.join(CONF, "avisos.off")):
        return
    path = os.path.join(SOUNDS, name + ".wav")
    if os.path.exists(path):
        try:
            subprocess.Popen([PLAYER, path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


def event(kind, text, sound=None):
    log(f"{kind}: {text}")
    os.makedirs(RUN, exist_ok=True)
    with EVENT_LOCK:
        _event_write(kind, text)
    play(sound)


def _event_write(kind, text):
    try:
        # o arquivo é pequeno e vive na RAM (XDG_RUNTIME_DIR); limita a 200 linhas
        lines = []
        if os.path.exists(EVENTS) and os.path.getsize(EVENTS) > 40000:
            with open(EVENTS) as f:
                lines = f.readlines()[-100:]
            with open(EVENTS, "w") as f:
                f.writelines(lines)
        with open(EVENTS, "a") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, "text": text}, ensure_ascii=False) + "\n")
    except OSError:
        pass


# ------------------------------------------------------------------ gestos no touchpad do DS4 (Fase 6.2)
# Dois dedos deslizando: metade esquerda = brilho, metade direita = volume (cima aumenta).
# Vale no menu e dentro dos jogos. Desligar: ~/.config/skystation/touchpad.off
class Gesto:
    """Transforma posições de dedos em passos (+1/-1) de brilho ou volume. Sem E/S: fácil de testar."""

    def __init__(self, xmax, ymax, passos=9):
        self.xmax, self.step = xmax, max(1.0, ymax / passos)
        self.slots, self.slot = {}, 0
        self.lado, self.ref = None, 0.0

    def abs(self, code, value):
        if code == "SLOT":
            self.slot = value
        elif code == "ID":
            if value < 0:
                self.slots.pop(self.slot, None)
            else:
                self.slots.setdefault(self.slot, [None, None])
        elif code in ("X", "Y") and self.slot in self.slots:
            self.slots[self.slot][0 if code == "X" else 1] = value

    def sync(self):
        """Chamar a cada SYN_REPORT. Devolve (lado, passos) ou None."""
        pts = [p for p in self.slots.values() if p[0] is not None and p[1] is not None]
        if len(pts) != 2:
            self.lado = None
            return None
        x = (pts[0][0] + pts[1][0]) / 2
        y = (pts[0][1] + pts[1][1]) / 2
        if self.lado is None:
            self.lado, self.ref = ("brilho" if x < self.xmax / 2 else "volume"), y
            return None
        n = int((self.ref - y) / self.step)      # para cima o Y diminui
        if n == 0:
            return None
        self.ref -= n * self.step
        return self.lado, n


def ajustar(lado, n):
    sinal = "+" if n > 0 else "-"
    try:
        if lado == "volume":
            subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{abs(n) * 5}%{sinal}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            r = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=3)
            m = re.search(r"([0-9.]+)", r.stdout)
            return f"Volume {round(float(m.group(1)) * 100)}%" if m else "Volume"
        subprocess.run(["brightnessctl", "-q", "-n", "set", f"{abs(n) * 5}%{sinal}"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        r = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True, timeout=3)
        m = re.search(r",(\d+)%", r.stdout)
        return f"Brilho {m.group(1)}%" if m else "Brilho"
    except (OSError, subprocess.SubprocessError):
        return ""


def touchpad_worker():
    if evdev is None:
        return
    E = evdev.ecodes
    nomes = {E.ABS_MT_SLOT: "SLOT", E.ABS_MT_TRACKING_ID: "ID", E.ABS_MT_POSITION_X: "X", E.ABS_MT_POSITION_Y: "Y"}
    while True:
        dev = None
        for path in evdev.list_devices():
            try:
                d = evdev.InputDevice(path)
                caps = d.capabilities().get(E.EV_ABS, [])
                if "touchpad" in d.name.lower() and any(c[0] == E.ABS_MT_POSITION_X for c in caps):
                    dev = d
                    break
                d.close()
            except OSError:
                continue
        if dev is None:
            time.sleep(5)
            continue
        try:
            g = Gesto(dev.absinfo(E.ABS_MT_POSITION_X).max, dev.absinfo(E.ABS_MT_POSITION_Y).max)
            ultimo = 0.0
            for ev in dev.read_loop():
                if ev.type == E.EV_ABS and ev.code in nomes:
                    g.abs(nomes[ev.code], ev.value)
                elif ev.type == E.EV_SYN and ev.code == E.SYN_REPORT:
                    r = g.sync()
                    if r and not os.path.exists(os.path.join(CONF, "touchpad.off")):
                        txt = ajustar(*r)
                        if txt and time.monotonic() - ultimo > 0.35:
                            ultimo = time.monotonic()
                            event("ajuste", txt, None)
        except OSError:
            pass
        time.sleep(2)


# ------------------------------------------------------------------ Modo TV (Fase 6.0)
SYSFS = os.environ.get("SKY_SYSFS", "")


def tv_output():
    """Saída externa conectada (HDMI/DP/DVI/VGA) ou "". eDP/LVDS = tela do notebook."""
    for p in sorted(glob.glob(SYSFS + "/sys/class/drm/card*-*/status")):
        m = re.match(r"card\d+-((HDMI|DP|DVI|VGA)-.+)$", os.path.basename(os.path.dirname(p)))
        if m and read(p).strip() == "connected":
            return m.group(1)
    return ""


def pactl_json(*args):
    try:
        r = subprocess.run(["pactl", "-f", "json", *args], capture_output=True, text=True, timeout=5)
        return json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def pactl(*args):
    try:
        subprocess.run(["pactl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def default_sink():
    try:
        r = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def audio_tv(on):
    """Liga: ativa o perfil HDMI da placa e põe a saída HDMI como padrão. Desliga: volta a anterior."""
    saved = os.path.join(RUN, "audio-antes-da-tv")
    if os.path.exists(os.path.join(CONF, "tv-som.off")):
        return
    if on:
        for _ in range(4):               # a TV leva alguns segundos para anunciar o áudio (ELD)
            for card in pactl_json("list", "cards"):
                profs = card.get("profiles", {}) or {}
                hdmi = [n for n, p in profs.items() if n.startswith("output:hdmi") and "input" not in n
                        and p.get("available", True) is not False]
                if hdmi and not str(card.get("active_profile", "")).startswith("output:hdmi"):
                    hdmi.sort(key=lambda n: (profs[n].get("priority", 0)), reverse=True)
                    pactl("set-card-profile", card.get("name", ""), hdmi[0])
            time.sleep(1.0)
            sinks = [x.get("name", "") for x in pactl_json("list", "sinks") if "hdmi" in x.get("name", "").lower()]
            if sinks:
                cur = default_sink()
                if cur and "hdmi" not in cur.lower():
                    os.makedirs(RUN, exist_ok=True)
                    with open(saved, "w") as f:
                        f.write(cur)
                pactl("set-default-sink", sinks[0])
                return
            time.sleep(2.0)
    else:
        try:
            with open(saved) as f:
                prev = f.read().strip()
            os.remove(saved)
        except OSError:
            prev = ""
        names = [x.get("name", "") for x in pactl_json("list", "sinks")]
        if prev in names:
            pactl("set-default-sink", prev)
        else:
            other = [n for n in names if "hdmi" not in n.lower()]
            if other:
                pactl("set-default-sink", other[0])


# ------------------------------------------------------------------ disco no leitor (Fase 5.8)
def write_disco(info):
    os.makedirs(RUN, exist_ok=True)
    tmp = DISCO_JSON + ".tmp"
    with open(tmp, "w") as f:
        json.dump(info, f, ensure_ascii=False)
    os.replace(tmp, DISCO_JSON)


def disco_worker(state):
    """Identifica o disco recém-colocado: primeiro sem internet (aviso rápido), depois com nome/capa."""
    try:
        info = disco.detect(online=False)
        if not info.get("disco"):
            return
        write_disco(info)
        nome = {"ps1": "PS1", "ps2": "PS2"}.get(info.get("sistema", ""), "")
        titulo = re.sub(r" *[(][^)]*[)]", "", info.get("titulo", "")).strip()
        if nome and titulo and titulo != info.get("serial"):
            event("disco", f"Disco de {nome}: {titulo}", "disco-on")
        elif nome:
            event("disco", f"Disco de {nome} no leitor", "disco-on")
        else:
            event("disco", "Disco não reconhecido (não é jogo de PS1/PS2)", "disco-on")
        event("jogos", "recarregar")
        if nome and (not info.get("capa") or info.get("titulo") in ("", info.get("serial"))):
            full = disco.detect(online=True)
            if full.get("disco") and full.get("serial") == info.get("serial"):
                write_disco(full)
                event("jogos", "recarregar")
    except Exception as e:
        log(f"disco: {e}")
    finally:
        state["busy"] = False


# ------------------------------------------------------------------ leituras
def friendly(name):
    n = name.lower()
    if "dualsense" in n:
        return "DualSense"
    if "wireless controller" in n or "dualshock 4" in n:
        return "DualShock 4"
    if "xbox" in n or "x-box" in n:
        return "Controle Xbox"
    if "8bitdo" in n:
        return "Controle 8BitDo"
    return name.strip() or "Controle"


def controllers():
    found = {}
    if evdev is None:
        return found
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
            caps = dev.capabilities()
            keys = set(caps.get(E.EV_KEY, []))
            if (E.BTN_SOUTH in keys or E.BTN_GAMEPAD in keys) and E.EV_ABS in caps:
                found[f"{dev.name}|{dev.uniq or dev.phys}"] = friendly(dev.name)
            dev.close()
        except OSError:
            pass
    return found


def usb_devices():
    found = {}
    for d in glob.glob("/sys/bus/usb/devices/*"):
        base = os.path.basename(d)
        if ":" in base or base.startswith("usb"):
            continue  # interfaces e controladores-raiz não contam
        prod = read(os.path.join(d, "product"))
        if prod:
            found[base + "|" + prod] = prod
    return found


def skyroms_mounted():
    for line in read("/proc/mounts").splitlines():
        parts = line.split()
        if len(parts) > 1 and parts[1] == SKYROMS:
            return True
    return False


def game_keys():
    keys = {}
    for base in GAME_DIRS:
        for j in glob.glob(os.path.join(base, "*", "game.json")):
            try:
                with open(j) as f:
                    keys["g:" + os.path.dirname(j)] = json.load(f).get("title") or os.path.basename(os.path.dirname(j))
            except (OSError, ValueError):
                pass
    for base in ROM_BASES:
        for sys_id, exts in ROM_EXTS.items():
            for p in glob.glob(os.path.join(glob.escape(base), sys_id, "*")):
                ext = p.rsplit(".", 1)[-1].lower() if "." in p else ""
                if ext in exts:
                    stem = os.path.basename(p).rsplit(".", 1)[0]
                    keys[f"{sys_id}:{stem.lower()}"] = re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", stem).strip() or stem
    return keys


def power():
    """(bateria do console: (capacidade, status) ou None, carregador ligado: bool ou None, controles: {nome: (cap, status)})"""
    bat, ac, pads = None, None, {}
    for d in glob.glob("/sys/class/power_supply/*"):
        typ = read(os.path.join(d, "type"))
        scope = read(os.path.join(d, "scope"))
        if typ == "Mains":
            ac = read(os.path.join(d, "online")) == "1"
        elif typ == "Battery":
            cap = read(os.path.join(d, "capacity"))
            st = read(os.path.join(d, "status"))
            if not cap.isdigit():
                continue
            if scope == "Device":
                pads[os.path.basename(d)] = (int(cap), st)
            elif bat is None:
                bat = (int(cap), st)
    return bat, ac, pads


def temperature():
    best = None
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if read(os.path.join(z, "type")) in ("x86_pkg_temp", "acpitz", "TCPU", "cpu-thermal"):
            v = read(os.path.join(z, "temp"))
            if v.lstrip("-").isdigit():
                c = int(v) / 1000
                best = c if best is None else max(best, c)
    if best is None:
        for h in glob.glob("/sys/class/hwmon/hwmon*"):
            if read(os.path.join(h, "name")) in ("coretemp", "k10temp"):
                for t in glob.glob(os.path.join(h, "temp*_input")):
                    v = read(t)
                    if v.isdigit():
                        best = max(best or 0, int(v) / 1000)
    return best


def close_game_and_poweroff():
    pid_s = read(os.path.join(RUN, "game.pid"))
    if pid_s.isdigit():
        try:
            os.killpg(int(pid_s), signal.SIGCONT)
            os.killpg(int(pid_s), signal.SIGTERM)  # o emulador grava o save ao sair
        except OSError:
            pass
        for _ in range(16):
            time.sleep(0.5)
            if not os.path.exists(os.path.join(RUN, "game.pid")):
                break
    time.sleep(2)
    subprocess.run(["systemctl", "poweroff"])


# ------------------------------------------------------------------ laço principal
def main():
    log("iniciado")
    threading.Thread(target=touchpad_worker, daemon=True).start()
    pads = controllers()
    usb = usb_devices()
    mounted = skyroms_mounted()
    games = game_keys()
    bat, ac, pad_bat = power()
    warned_bat = set()
    warned_pad = set()
    hot_since, hot_warned = None, 0.0
    pending_usb = []           # avisos de USB esperam 4 s (o controle/pendrive tem prioridade)
    quiet_games_until = 0.0
    critical = False
    tick = 0
    disc = {"ok": False, "busy": False, "warned": False}
    tv = tv_output()
    if tv:
        threading.Thread(target=audio_tv, args=(True,), daemon=True).start()
    try:
        os.remove(DISCO_JSON)
    except OSError:
        pass

    while True:
        time.sleep(1.0)
        tick += 1
        now = time.time()
        special = False

        # controles
        cur = controllers()
        for k in cur.keys() - pads.keys():
            event("controle", f"{cur[k]} conectado", "controle-on")
            special = True
        for k in pads.keys() - cur.keys():
            event("controle", f"{pads[k]} desconectado", "controle-off")
            special = True
        pads = cur

        # pendrive de jogos
        m = skyroms_mounted()
        if m != mounted:
            mounted = m
            if m:
                for sub in ("ps1", "ps2", "ps1/covers", "ps2/covers"):
                    try:
                        os.makedirs(os.path.join(SKYROMS, sub), exist_ok=True)
                    except OSError:
                        pass
            event("pendrive", "Pendrive de jogos conectado" if m else "Pendrive de jogos removido",
                  "pendrive-on" if m else "pendrive-off")
            event("jogos", "recarregar")
            special = True
            quiet_games_until = now + 8   # os jogos do pendrive não tocam "jogo novo" um a um

        # USB (espera 4 s para não tocar dois sons para a mesma coisa)
        cur_usb = usb_devices()
        for k in cur_usb.keys() - usb.keys():
            pending_usb.append((now, "usb-on", f"{cur_usb[k]} conectado"))
        for k in usb.keys() - cur_usb.keys():
            pending_usb.append((now, "usb-off", f"{usb[k]} removido"))
        usb = cur_usb
        if special:
            pending_usb = []
        ready = [p for p in pending_usb if now - p[0] >= 4]
        pending_usb = [p for p in pending_usb if now - p[0] < 4]
        if ready:
            event("usb", ready[-1][2] if len(ready) == 1 else f"{len(ready)} dispositivos USB", ready[-1][1])

        # jogos novos (a cada 5 s)
        if tick % 5 == 0:
            cur_games = game_keys()
            new = [cur_games[k] for k in cur_games.keys() - games.keys()]
            if new and now > quiet_games_until:
                event("jogo", f"Jogo novo: {new[0]}" if len(new) == 1 else f"{len(new)} jogos novos", "jogo-novo")
            if cur_games.keys() != games.keys():
                event("jogos", "recarregar")
            games = cur_games

        # energia (a cada 3 s)
        if tick % 3 == 0:
            nbat, nac, npad = power()
            if nac is not None and ac is not None and nac != ac:
                event("energia", "Carregador conectado" if nac else "Usando a bateria",
                      "carregando" if nac else "descarregando")
                warned_bat.clear()
            ac = nac if nac is not None else ac
            if nbat:
                cap, st = nbat
                discharging = st == "Discharging"
                if discharging:
                    for lim, snd in ((15, "bateria-baixa"), (5, "alerta")):
                        if cap <= lim and lim not in warned_bat:
                            warned_bat.add(lim)
                            event("bateria", f"Bateria do console em {cap}%"
                                  + (": ligue o carregador" if lim == 5 else ""), snd)
                    if cap <= 3 and not critical:
                        critical = True
                        event("bateria", "Bateria esgotada: salvando e desligando…", "alerta")
                        close_game_and_poweroff()
                else:
                    critical = False
            for name, (cap, st) in npad.items():
                if st == "Discharging" and cap <= 15 and name not in warned_pad:
                    warned_pad.add(name)
                    event("bateria", f"Bateria do controle em {cap}%", "bateria-baixa")
                elif st != "Discharging" or cap > 20:
                    warned_pad.discard(name)
            pad_bat = npad

        # disco no leitor (a cada 2 s; com jogo aberto não mexe no leitor)
        if disco and tick % 2 == 0 and not disc["busy"] and not os.path.exists(os.path.join(RUN, "game.pid")) \
                and not os.path.exists(os.path.join(RUN, "disco.ocupado")):
            ds = disco.drives()
            ok = disco.disc_ok(ds[0][0]) if ds else False
            if ok is None:
                if not disc["warned"]:
                    disc["warned"] = True
                    log("leitor sem permissão: rode a Fase 5.8")
                ok = False
            if ok and not disc["ok"]:
                disc["busy"] = True
                threading.Thread(target=disco_worker, args=(disc,), daemon=True).start()
            elif not ok and disc["ok"]:
                try:
                    os.remove(DISCO_JSON)
                except OSError:
                    pass
                event("disco", "Disco removido", "disco-off")
                event("jogos", "recarregar")
            disc["ok"] = ok

        # TV no HDMI (a cada 2 s). A imagem troca sozinha (cage -m last); aqui vai o som e o aviso.
        if tick % 2 == 1:
            cur_tv = tv_output()
            if bool(cur_tv) != bool(tv):
                if cur_tv:
                    event("tv", "TV conectada: imagem e som na TV", "tv-on")
                else:
                    event("tv", "TV desconectada: de volta à tela do console", "tv-off")
                threading.Thread(target=audio_tv, args=(bool(cur_tv),), daemon=True).start()
                special = True
            tv = cur_tv

        # temperatura (a cada 5 s): 90 °C por 15 s seguidos
        if tick % 5 == 0:
            tc = temperature()
            if tc is not None and tc >= 90:
                hot_since = hot_since or now
                if now - hot_since >= 15 and now - hot_warned > 300:
                    hot_warned = now
                    event("calor", f"Temperatura alta: {tc:.0f} °C (verifique a ventilação)", "alerta")
            else:
                hot_since = None


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
