#!/bin/bash
# SkyStation: abre uma ROM/ISO no emulador certo, com configuração otimizada.
# Uso: sky-emu <sistema> <arquivo>
#   ps1  -> RetroArch + core PCSX-ReARMed (dynarec, o mais leve)
#   ps2  -> PCSX2 (perfil leve: OpenGL, resolução nativa | potente: Vulkan, 2x)
#   ps3  -> RPCS3 (Fase 7.0; só em PC forte: 6+ threads). Jogo = pasta do disco ou .iso

SYS="$1"
ROM="$2"
SKY="$HOME/skystation"
MSG="${SKY_MSG_FILE:-/dev/null}"
PROFILE="${SKY_PROFILE:-$(/opt/skystation/bin/sky-perfil)}"

fail() { echo "$1" >"$MSG"; echo "sky-emu: $1" >&2; exit "${2:-3}"; }

# Fase 5.8: "disco" = jogo direto do leitor. O 3º argumento é o código do disco (saves separados).
DISCO=""
if [ "$ROM" = "disco" ]; then
    DEV="$(ls -d /sys/class/block/sr[0-9]* 2>/dev/null | head -1)"
    [ -n "$DEV" ] || fail "Nenhum leitor de CD/DVD encontrado."
    SG="$(basename "$(ls -d "$DEV"/device/scsi_generic/sg* 2>/dev/null | head -1)" 2>/dev/null)"
    DEV="/dev/$(basename "$DEV")"
    [ -r "$DEV" ] || fail "Sem permissão para ler o leitor de disco. Rode a Fase 5.8 e reinicie."
    DISCO="$(printf '%s' "${3:-disco}" | tr -cd 'A-Za-z0-9-')"
else
    [ -f "$ROM" ] || { [ "$SYS" = ps3 ] && [ -d "$ROM" ]; } || fail "Arquivo não encontrado: $(basename "$ROM")"
fi
mkdir -p "$SKY/saves/$SYS" "$SKY/states/$SYS" "$SKY/bios/$SYS"

case "$SYS" in
ps1|snes|n64|psp|gc|wii|nds|3ds|gba|gb|nes|md)
    # Fase 7.1: para cada sistema, o primeiro core instalado da lista (o instalador tenta nessa ordem).
    case "$SYS" in
        ps1)  CORES="pcsx_rearmed" ;;
        snes) CORES="snes9x" ;;
        n64)  CORES="mupen64plus_next" ;;
        psp)  CORES="ppsspp" ;;
        gc|wii) CORES="dolphin" ;;
        nds)  CORES="melondsds melonds desmume" ;;
        3ds)  CORES="azahar citra" ;;
        gba)  CORES="mgba" ;;
        gb)   CORES="gambatte" ;;
        nes)  CORES="nestopia fceumm" ;;
        md)   CORES="genesis_plus_gx" ;;
    esac
    CORE=""
    for c in $CORES; do
        [ -f "/opt/skystation/emu/cores/${c}_libretro.so" ] && { CORE="/opt/skystation/emu/cores/${c}_libretro.so"; break; }
    done
    [ -n "$CORE" ] || fail "Emulador de ${SYS^^} não instalado. Rode a Fase 7.1 (fase7-1.sh)."
    CFG="$HOME/.config/skystation/retroarch.cfg"
    mkdir -p "$(dirname "$CFG")"
    # Configuração base do SkyStation, sempre regenerada (o RetroArch não salva por cima).
    sed -e "s|@SKY@|$SKY|g" /opt/skystation/emu/retroarch.cfg >"$CFG"
    if [ "$SYS" != "ps1" ]; then   # o modelo aponta saves/estados para ps1: troca pela pasta do sistema
        sed -i -e "s|/saves/ps1\"|/saves/$SYS\"|" -e "s|/states/ps1\"|/states/$SYS\"|" "$CFG"
        # PSP: o core procura fontes e arquivos de apoio em <system>/PPSSPP
        [ "$SYS" = psp ] && sed -i -e "s|/bios/ps1\"|/bios/psp\"|" "$CFG"
        # GameCube/Wii: o core procura os arquivos de apoio em <system>/dolphin-emu/Sys
        case "$SYS" in gc|wii) sed -i -e "s|/bios/ps1\"|/bios/dolphin\"|" "$CFG"; mkdir -p "$SKY/bios/dolphin" ;; esac
        case "$SYS" in nds|3ds) sed -i -e "s|/bios/ps1\"|/bios/$SYS\"|" "$CFG" ;; esac
    fi
    if [ -n "$DISCO" ]; then
        # O core de PS1 lê o CD pelo /dev/sgN (comandos SCSI: dados + faixas de áudio).
        [ -n "$SG" ] || fail "O leitor não expõe /dev/sg (módulo sg). Rode a Fase 5.8 e reinicie."
        [ -w "/dev/$SG" ] || fail "Sem permissão no /dev/$SG. Rode a Fase 5.8 e reinicie."
        ROM="cdrom://drive${SG#sg}.cue"
        # Todo disco se chama "drive1" para o RetroArch: saves e estados numa pasta por jogo.
        mkdir -p "$SKY/saves/ps1/disco/$DISCO" "$SKY/states/ps1/disco/$DISCO"
        sed -i -e "s|^savefile_directory = .*|savefile_directory = \"$SKY/saves/ps1/disco/$DISCO\"|" \
               -e "s|^savestate_directory = .*|savestate_directory = \"$SKY/states/ps1/disco/$DISCO\"|" "$CFG"
    fi
    # Canal de comandos só local (Fase 5.6): o menu Home escreve SAVE_STATE / LOAD_STATE aqui.
    # Aberto em leitura+escrita para o RetroArch nunca ver "fim de arquivo" na entrada.
    FIFO="${XDG_RUNTIME_DIR:-/tmp}/skystation/retroarch.cmd"
    mkdir -p "$(dirname "$FIFO")"
    rm -f "$FIFO" && mkfifo -m 600 "$FIFO" && exec 3<>"$FIFO"
    exec retroarch --fullscreen --config "$CFG" -L "$CORE" "$ROM" <&3
    ;;
ps2)
    PCSX2="/opt/pcsx2/AppRun"
    [ -x "$PCSX2" ] || fail "Emulador de PS2 não instalado. Rode a Fase 4 de novo."
    # BIOS do PS2 tem 4 MB; prefere esse tamanho para não pegar outro .bin qualquer.
    acha_bios() {
        find "$@" -maxdepth 1 -type f \( -iname '*.bin' -o -iname '*.rom0' \) -size 4096k 2>/dev/null | sort | head -1
    }
    BIOS="$(acha_bios "$SKY/bios/ps2")"
    if [ -z "$BIOS" ]; then
        # Fase 5.7.1: aceita a BIOS deixada no pendrive SKYROMS (pasta bios/ ou bios/ps2/) e copia para o console.
        ACHADA="$(acha_bios /mnt/skyroms/bios/ps2 /mnt/skyroms/bios /mnt/skyroms)"
        if [ -n "$ACHADA" ]; then
            cp --update=none "$(dirname "$ACHADA")"/"$(basename "${ACHADA%.*}")".* "$SKY/bios/ps2/" 2>/dev/null
            BIOS="$(acha_bios "$SKY/bios/ps2")"
        fi
    fi
    [ -n "$BIOS" ] || fail "Falta a BIOS do PS2. Envie pelo Wi-Fi (Sistema: BIOS do PS2) ou coloque em SKYROMS/bios."
    GAME_ID="$(cat "${XDG_RUNTIME_DIR:-/tmp}/skystation/game.id" 2>/dev/null)"
    # Fase 7.3: no perfil leve (OpenGL), o driver de vídeo trabalha em outra thread do processador,
    # tirando peso da thread que desenha o jogo (a "GS" do contador do PCSX2).
    [ "$PROFILE" = leve ] && export mesa_glthread=true
    python3 /opt/skystation/bin/sky-pcsx2-ini "$PROFILE" "$SKY" "$(basename "$BIOS")" "$GAME_ID" \
        || fail "Não consegui preparar a configuração do PCSX2."
    if [ -n "$DISCO" ]; then
        exec "$PCSX2" -fullscreen -nogui -disc "$DEV"
    fi
    exec "$PCSX2" -fullscreen -nogui -- "$ROM"
    ;;
x360)
    # Xbox 360 (Fase 7.1, experimental): Xenia Canary para Linux. Só em PC forte, como o PS3.
    XENIA=/opt/xenia/xenia_canary
    [ -x "$XENIA" ] || fail "Emulador de Xbox 360 não instalado. Rode a Fase 7.1 (fase7-1.sh)."
    if [ "$(nproc)" -lt 6 ] && [ ! -f "$HOME/.config/skystation/x360-forcar" ]; then
        fail "Xbox 360 precisa de um processador com 6+ threads (este tem $(nproc)). Dê boot com o pendrive num PC mais forte."
    fi
    cd "$(dirname "$XENIA")" || fail "Pasta do Xenia inacessível."
    exec "$XENIA" --fullscreen=true --gpu=vulkan "$ROM"
    ;;
ps3)
    # O sky-ps3 desliga as telas de aviso do RPCS3, configura o controle ligado agora, instala o
    # firmware na primeira vez (demora alguns minutos) e devolve o usuário do perfil em uso.
    PREP="$(python3 /opt/skystation/bin/sky-ps3 preparar 2>/dev/null | tail -1)"
    ERR="$(printf '%s' "$PREP" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("" if d.get("ok") else d.get("error","erro"))' 2>/dev/null || echo "Não consegui preparar o RPCS3.")"
    [ -z "$ERR" ] || fail "$ERR"
    USR="$(printf '%s' "$PREP" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("user","00000001"))')"
    ulimit -n 65536 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null   # o RPCS3 reclama com menos de 4096 arquivos abertos
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
    exec /opt/rpcs3/AppRun --no-gui --fullscreen --input-config SkyStation --user-id "$USR" "$ROM"
    ;;
*)
    fail "Sistema desconhecido: $SYS"
    ;;
esac
