#!/bin/bash
# SkyStation: abre uma ROM/ISO no emulador certo, com configuração otimizada.
# Uso: sky-emu <sistema> <arquivo>
#   ps1  -> RetroArch + core PCSX-ReARMed (dynarec, o mais leve)
#   ps2  -> PCSX2 (perfil leve: OpenGL, resolução nativa | potente: Vulkan, 2x)
#   ps3  -> RPCS3 (Fase 7.0; só em PC forte: 6+ threads). Jogo = pasta do disco ou .iso
#   Fase 13: dc/saturn (RetroArch), wiiu/vita/xbox (core do RetroArch ou Cemu/Vita3K/xemu), ps4 (shadPS4), switch (teste)

SYS="$1"
ROM="$2"
SKY="$HOME/skystation"
MSG="${SKY_MSG_FILE:-/dev/null}"
PROFILE="${SKY_PROFILE:-$(/opt/skystation/bin/sky-perfil)}"

fail() { echo "$1" >"$MSG"; echo "sky-emu: $1" >&2; exit "${2:-3}"; }

# Fase 5.8: "disco" = jogo direto do leitor. O 3º argumento é o código do disco (saves separados).
DISCO=""
if [ "$ROM" = "disco" ]; then
    DEV="$(ls -d /sys/class/block/sr[0-9]* 2>/dev/null | head -1)"
    [ -n "$DEV" ] || fail "Nenhum leitor de CD/DVD encontrado."
    SG="$(basename "$(ls -d "$DEV"/device/scsi_generic/sg* 2>/dev/null | head -1)" 2>/dev/null)"
    DEV="/dev/$(basename "$DEV")"
    [ -r "$DEV" ] || fail "Sem permissão para ler o leitor de disco. Rode a Fase 5.8 e reinicie."
    DISCO="$(printf '%s' "${3:-disco}" | tr -cd 'A-Za-z0-9-')"
else
    # PS3, PS4 e Wii U também aceitam o jogo como pasta (cópia do disco/jogo instalado).
    [ -f "$ROM" ] || { case "$SYS" in ps3|ps4|wiiu) [ -d "$ROM" ] ;; *) false ;; esac; } \
        || fail "Arquivo não encontrado: $(basename "$ROM")"
fi
mkdir -p "$SKY/saves/$SYS" "$SKY/states/$SYS" "$SKY/bios/$SYS"

# Fase 13: BIOS/chaves deixadas em SKYROMS/bios/<sistema>/ são copiadas para o console (sem apagar
# nada que já esteja lá). bios_sync <subpasta>: alguns emuladores procuram dentro de uma subpasta.
bios_sync() {
    local dest="$SKY/bios/$SYS${1:+/$1}" o
    mkdir -p "$dest"
    for o in "/mnt/skyroms/bios/$SYS" "/mnt/skyroms/bios/$SYS${1:+/$1}"; do
        [ -d "$o" ] && find "$o" -maxdepth 1 -type f -exec cp -n {} "$dest/" \; 2>/dev/null
    done
    return 0
}
# copia_como <pasta> <nome exato> <padrões…>: o emulador exige um nome exato; usa o 1º arquivo parecido.
copia_como() {
    local dir="$1" nome="$2" f; shift 2
    [ -f "$dir/$nome" ] && return 0
    for f in "$@"; do
        f="$(find "$dir" -maxdepth 1 -type f -iname "$f" ! -iname "$nome" 2>/dev/null | head -1)"
        [ -n "$f" ] && { cp -n "$f" "$dir/$nome"; return 0; }
    done
    return 1
}
precisa_forte() {   # PS4 e Switch: como o PS3/360, só em processador com 6+ threads
    if [ "$(nproc)" -lt 6 ] && [ ! -f "$HOME/.config/skystation/forcar-pesados" ]; then
        fail "$1 precisa de um processador com 6+ threads (este tem $(nproc)). Dê boot com o pendrive num PC mais forte."
    fi
}
saturn_bios() { [ -f "$SKY/bios/saturn/sega_101.bin" ] || [ -f "$SKY/bios/saturn/mpr-17933.bin" ]; }
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"

# Wii U, Vita e Xbox: pelo RetroArch quando o core existe (controle, menu Home e saves por perfil já
# funcionam); senão pelo programa oficial instalado pela Fase 13 ("<sistema>-solo").
ALVO="$SYS"
case "$SYS" in
    # 13.11: Wii U pelo Cemu oficial sempre que ele existe (o core cemu_libretro, não oficial, dava Erro E1 no .wux).
    wiiu) { [ -x /opt/cemu/AppRun ] || [ ! -f /opt/skystation/emu/cores/cemu_libretro.so ]; } && ALVO=wiiu-solo ;;
    # 13.5: Vita pelo Vita3K oficial sempre que ele existe (o core só como último recurso: sem as pastas data/ e
    # shaders-builtin/ da release dele, que o buildbot não entrega, ele abortava com "double free", E134).
    vita) { [ -x /opt/vita3k/AppRun ] || [ ! -f /opt/skystation/emu/cores/vita3k_libretro.so ]; } && ALVO=vita-solo ;;
    xbox) [ -f /opt/skystation/emu/cores/xemu_libretro.so ] || ALVO=xbox-solo ;;
esac
case "$SYS" in
    dc)     bios_sync dc ;;                      # Flycast: <system>/dc/dc_boot.bin, dc_flash.bin
    saturn) bios_sync ;;
    wiiu)   bios_sync Cemu ;;                    # core Cemu: <system>/Cemu/keys.txt
    vita)   bios_sync vita3k                     # core Vita3K: <system>/vita3k/*.PUP
            # 13.3: sem firmware o Vita3K não carrega muitos jogos (e pode até abortar, E134). São dois
            # arquivos do site da Sony: PSVUPDAT.PUP (sistema) e PSP2UPDAT.PUP (fontes).
            VFW="$SKY/bios/vita/vita3k"
            VPREF="${XDG_DATA_HOME:-$HOME/.local/share}/Vita3K/Vita3K"
            if [ -z "$(find "$VFW" -maxdepth 1 -iname '*.pup' 2>/dev/null | head -1)" ] && [ ! -d "$VPREF/vs0" ]; then
                fail "PS Vita: falta o firmware. Baixe no site da Sony o PSVUPDAT.PUP (sistema) e o PSP2UPDAT.PUP (fontes) e coloque em SKYROMS/bios/vita."
            fi ;;
    xbox)   bios_sync xemu                       # core xemu: nomes exatos em <system>/xemu/
            X="$SKY/bios/xbox/xemu"
            copia_como "$X" mcpx_1.0.bin '*mcpx*.bin'
            copia_como "$X" Complex_4627v1.03.bin 'Complex*.bin' '*4627*.bin' '*bios*.bin'
            copia_como "$X" xbox_hdd.qcow2 '*.qcow2' ;;
esac
# Wii U em pasta (code/ content/ meta/): o emulador abre o .rpx de dentro de code/.
if [ "$SYS" = wiiu ] && [ -d "$ROM" ]; then
    ROM="$(find "$ROM/code" -maxdepth 1 -type f -iname '*.rpx' 2>/dev/null | head -1)"
    [ -n "$ROM" ] || fail "Pasta de Wii U sem code/*.rpx."
fi

case "$ALVO" in
ps1|snes|n64|psp|gc|wii|nds|3ds|gba|gb|nes|md|dc|saturn|wiiu|vita|xbox)
    # Fase 7.1: para cada sistema, o primeiro core instalado da lista (o instalador tenta nessa ordem).
    case "$SYS" in
        ps1)  CORES="pcsx_rearmed" ;;
        snes) CORES="snes9x" ;;
        n64)  CORES="mupen64plus_next" ;;
        psp)  CORES="ppsspp" ;;
        gc|wii) CORES="dolphin" ;;
        nds)  CORES="melondsds melonds desmume" ;;
        3ds)  CORES="azahar citra" ;;
        gba)  CORES="mgba" ;;
        gb)   CORES="gambatte" ;;
        nes)  CORES="nestopia fceumm" ;;
        md)   CORES="genesis_plus_gx" ;;
        # Fase 13
        dc)   CORES="flycast" ;;
        saturn)                     # Beetle Saturn é o mais fiel, mas exige BIOS; sem ela, YabaSanshiro (HLE)
            if saturn_bios; then
                CORES="mednafen_saturn yabasanshiro"
            else
                CORES="yabasanshiro mednafen_saturn"
            fi ;;
        wiiu) CORES="cemu" ;;
        vita) CORES="vita3k" ;;
        xbox) CORES="xemu" ;;
    esac
    CORE=""
    for c in $CORES; do
        [ -f "/opt/skystation/emu/cores/${c}_libretro.so" ] && { CORE="/opt/skystation/emu/cores/${c}_libretro.so"; break; }
    done
    case "$SYS" in dc|saturn|wiiu|vita|xbox) FASE="a Fase 13 (fase13.sh)" ;; *) FASE="a Fase 7.1 (fase7-1.sh)" ;; esac
    echo "sky-emu: $SYS pelo RetroArch (core ${CORE##*/})" >&2
    [ -n "$CORE" ] || fail "Emulador de ${SYS^^} não instalado. Rode $FASE."
    if [ "$SYS" = saturn ] && [ "${CORE##*/}" = mednafen_saturn_libretro.so ] \
        && ! saturn_bios; then
        fail "O Saturn precisa da BIOS (sega_101.bin ou mpr-17933.bin) em SKYROMS/bios/saturn."
    fi
    if [ "$SYS" = xbox ]; then
        for f in mcpx_1.0.bin Complex_4627v1.03.bin xbox_hdd.qcow2; do
            [ -f "$SKY/bios/xbox/xemu/$f" ] || fail "Xbox: falta $f em SKYROMS/bios/xbox (MCPX, BIOS e o HD do xemu)."
        done
    fi
    CFG="$HOME/.config/skystation/retroarch.cfg"
    mkdir -p "$(dirname "$CFG")"
    # Configuração base do SkyStation, sempre regenerada (o RetroArch não salva por cima).
    sed -e "s|@SKY@|$SKY|g" /opt/skystation/emu/retroarch.cfg >"$CFG"
    if [ "$SYS" != "ps1" ]; then   # o modelo aponta saves/estados para ps1: troca pela pasta do sistema
        sed -i -e "s|/saves/ps1\"|/saves/$SYS\"|" -e "s|/states/ps1\"|/states/$SYS\"|" "$CFG"
        # PSP: o core procura fontes e arquivos de apoio em <system>/PPSSPP
        [ "$SYS" = psp ] && sed -i -e "s|/bios/ps1\"|/bios/psp\"|" "$CFG"
        # GameCube/Wii: o core procura os arquivos de apoio em <system>/dolphin-emu/Sys
        case "$SYS" in gc|wii) sed -i -e "s|/bios/ps1\"|/bios/dolphin\"|" "$CFG"; mkdir -p "$SKY/bios/dolphin" ;; esac
        case "$SYS" in nds|3ds|dc|saturn|wiiu|vita|xbox) sed -i -e "s|/bios/ps1\"|/bios/$SYS\"|" "$CFG" ;; esac
    fi
    # Fase 7.4: qualidade por aparelho. No perfil "potente" (Ryzen/Vega 7) os emuladores 3D desenham
    # em resolução maior; no "leve" ficam no original. O arquivo é refeito a cada jogo porque o mesmo
    # pendrive liga nos dois aparelhos.
    OPTS="$HOME/.config/skystation/core-options.cfg"
    if [ "$PROFILE" = potente ]; then
        cat >"$OPTS" <<'EOF'
ppsspp_internal_resolution = "1440x816"
ppsspp_texture_anisotropic_filtering = "8x"
dolphin_efb_scale = "x2 (1280 x 1056)"
dolphin_max_anisotropy = "4x"
mupen64plus-43screensize = "1280x960"
mupen64plus-169screensize = "1920x1080"
citra_resolution_factor = "2x"
azahar_resolution_factor = "2x"
pcsx_rearmed_neon_enhancement_enable = "enabled"
EOF
    else
        : >"$OPTS"
    fi
    printf 'global_core_options = "true"\ncore_options_path = "%s"\n' "$OPTS" >>"$CFG"
    if [ -n "$DISCO" ]; then
        # O core de PS1 lê o CD pelo /dev/sgN (comandos SCSI: dados + faixas de áudio).
        [ -n "$SG" ] || fail "O leitor não expõe /dev/sg (módulo sg). Rode a Fase 5.8 e reinicie."
        [ -w "/dev/$SG" ] || fail "Sem permissão no /dev/$SG. Rode a Fase 5.8 e reinicie."
        ROM="cdrom://drive${SG#sg}.cue"
        # Todo disco se chama "drive1" para o RetroArch: saves e estados numa pasta por jogo.
        mkdir -p "$SKY/saves/ps1/disco/$DISCO" "$SKY/states/ps1/disco/$DISCO"
        sed -i -e "s|^savefile_directory = .*|savefile_directory = \"$SKY/saves/ps1/disco/$DISCO\"|" \
               -e "s|^savestate_directory = .*|savestate_directory = \"$SKY/states/ps1/disco/$DISCO\"|" "$CFG"
    fi
    # Fase 11.4: jogar junto pela SkyNetwork (netplay do RetroArch). Toda partida já sai pronta para
    # abrir uma sala: o menu Home manda NETPLAY_HOST_TOGGLE e o sky-netplay acha a sala no lobby e
    # manda o convite. A sala passa pela retransmissão de São Paulo (sem abrir porta no roteador) e
    # tem senha aleatória: só quem recebeu o convite entra. Quem aceita um convite chega aqui com
    # netplay-entrar.json (gravado pelo launcher) e conecta direto na sala do amigo.
    NP_ARGS=()
    case "$SYS" in ps1|snes|n64|nes|md|gba|gb)
        NPDIR="${XDG_RUNTIME_DIR:-/tmp}/skystation"
        mkdir -p "$NPDIR"
        NP_NICK="SkyStation_$(tr -dc 'a-z0-9' </dev/urandom | head -c 8)"
        NP_SENHA="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 12)"
        NP_MITM=true; NP_ANUNCIO=true
        ENTRAR="$NPDIR/netplay-entrar.json"
        if [ -f "$ENTRAR" ] && [ $(( $(date +%s) - $(stat -c %Y "$ENTRAR") )) -lt 600 ]; then
            SALA="$(python3 - "$ENTRAR" <<'PY'
import json, re, sys
d = json.load(open(sys.argv[1]))
limpo = lambda v, pad: v if re.fullmatch(pad, str(v)) else ""
print(limpo(d.get("ip", ""), r"[A-Za-z0-9.:-]{3,100}"), limpo(d.get("porta", ""), r"\d{1,5}"),
      limpo(d.get("sessao", ""), r"[A-Za-z0-9+/=_-]{0,64}") or "-", limpo(d.get("senha", ""), r"[A-Za-z0-9]{0,32}") or "-")
PY
)"
            rm -f "$ENTRAR"
            read -r NP_IP NP_PORTA NP_SESSAO NP_SENHA_SALA <<<"$SALA"
            if [ -n "$NP_IP" ] && [ -n "$NP_PORTA" ]; then
                NP_ARGS=(-C "$NP_IP" --port "$NP_PORTA")
                [ "$NP_SESSAO" != "-" ] && NP_ARGS+=("--mitm-session=$NP_SESSAO")
                [ "$NP_SENHA_SALA" != "-" ] && NP_SENHA="$NP_SENHA_SALA"
                NP_MITM=false; NP_ANUNCIO=false
            fi
        fi
        cat >>"$CFG" <<EOF
netplay_nickname = "$NP_NICK"
netplay_password = "$NP_SENHA"
netplay_use_mitm_server = "$NP_MITM"
netplay_mitm_server = "saopaulo"
netplay_public_announce = "$NP_ANUNCIO"
netplay_start_as_spectator = "false"
EOF
        (umask 077; printf '{"nick": "%s", "senha": "%s", "sistema": "%s", "convidado": %s}\n' \
            "$NP_NICK" "$NP_SENHA" "$SYS" "$([ ${#NP_ARGS[@]} -gt 0 ] && echo true || echo false)" >"$NPDIR/netplay.json")
        ;;
    esac
    # Canal de comandos só local (Fase 5.6): o menu Home escreve SAVE_STATE / LOAD_STATE aqui.
    # Aberto em leitura+escrita para o RetroArch nunca ver "fim de arquivo" na entrada.
    FIFO="${XDG_RUNTIME_DIR:-/tmp}/skystation/retroarch.cmd"
    mkdir -p "$(dirname "$FIFO")"
    rm -f "$FIFO" && mkfifo -m 600 "$FIFO" && exec 3<>"$FIFO"
    exec retroarch --fullscreen --config "$CFG" "${NP_ARGS[@]}" -L "$CORE" "$ROM" <&3
    ;;
ps2)
    PCSX2="/opt/pcsx2/AppRun"
    [ -x "$PCSX2" ] || fail "Emulador de PS2 não instalado. Rode a Fase 4 de novo."
    # BIOS do PS2 tem 4 MB; prefere esse tamanho para não pegar outro .bin qualquer.
    acha_bios() {
        find "$@" -maxdepth 1 -type f \( -iname '*.bin' -o -iname '*.rom0' \) -size 4096k 2>/dev/null | sort | head -1
    }
    BIOS="$(acha_bios "$SKY/bios/ps2")"
    if [ -z "$BIOS" ]; then
        # Fase 5.7.1: aceita a BIOS deixada no pendrive SKYROMS (pasta bios/ ou bios/ps2/) e copia para o console.
        ACHADA="$(acha_bios /mnt/skyroms/bios/ps2 /mnt/skyroms/bios /mnt/skyroms)"
        if [ -n "$ACHADA" ]; then
            cp --update=none "$(dirname "$ACHADA")"/"$(basename "${ACHADA%.*}")".* "$SKY/bios/ps2/" 2>/dev/null
            BIOS="$(acha_bios "$SKY/bios/ps2")"
        fi
    fi
    [ -n "$BIOS" ] || fail "Falta a BIOS do PS2. Envie pelo Wi-Fi (Sistema: BIOS do PS2) ou coloque em SKYROMS/bios."
    GAME_ID="$(cat "${XDG_RUNTIME_DIR:-/tmp}/skystation/game.id" 2>/dev/null)"
    python3 /opt/skystation/bin/sky-pcsx2-ini "$PROFILE" "$SKY" "$(basename "$BIOS")" "$GAME_ID" \
        || fail "Não consegui preparar a configuração do PCSX2."
    if [ -n "$DISCO" ]; then
        exec "$PCSX2" -fullscreen -nogui -disc "$DEV"
    fi
    exec "$PCSX2" -fullscreen -nogui -- "$ROM"
    ;;
x360)
    # Xbox 360 (Fase 7.1, experimental): Xenia Canary para Linux. Só em PC forte, como o PS3.
    XENIA=/opt/xenia/xenia_canary
    [ -x "$XENIA" ] || fail "Emulador de Xbox 360 não instalado. Rode a Fase 7.1 (fase7-1.sh)."
    # 11.7: alguns jogos vão melhor no Xenia Edge (fork do Canary focado em Vulkan e Linux, em
    # /opt/xenia-edge). Escolha por jogo: ~/.config/skystation/x360-build/<id do jogo> com "edge" ou
    # "canary" (vale mais), senão a lista abaixo. Sem o Edge instalado, fica no Canary.
    GAME_ID="$(cat "${XDG_RUNTIME_DIR:-/tmp}/skystation/game.id" 2>/dev/null)"
    BUILD="$(tr -d '[:space:]' 2>/dev/null <"$HOME/.config/skystation/x360-build/$GAME_ID")"
    if [ -z "$BUILD" ]; then
        case "$GAME_ID" in
            # Dante's Inferno: a imagem congela no começo da luta contra a Morte no Canary (20/11)
            x360-Dante*) BUILD=edge ;;
            *) BUILD=canary ;;
        esac
    fi
    if [ "$BUILD" = edge ]; then
        if [ -x /opt/xenia-edge/xenia_edge ]; then
            XENIA=/opt/xenia-edge/xenia_edge
        else
            echo "sky-emu: $GAME_ID pede o Xenia Edge, que não está instalado; abrindo no Canary" >&2
            BUILD="canary (o Edge não está instalado)"
        fi
    fi
    echo "Xenia: $BUILD" >>"${XDG_RUNTIME_DIR:-/tmp}/skystation/game.ajustes"
    if [ "$(nproc)" -lt 6 ] && [ ! -f "$HOME/.config/skystation/x360-forcar" ]; then
        fail "Xbox 360 precisa de um processador com 6+ threads (este tem $(nproc)). Dê boot com o pendrive num PC mais forte."
    fi
    cd "$(dirname "$XENIA")" || fail "Pasta do Xenia inacessível."
    # Fase 9.4: os saves do Xenia ficam na pasta do perfil (~/skystation/saves/x360), como os dos
    # outros emuladores: cada perfil tem os seus e a nuvem (sky-cloud) os encontra. Na primeira vez,
    # traz o que já existia no lugar padrão do Xenia (só copia: o original continua lá).
    X360="$SKY/saves/x360"
    if [ -z "$(ls -A "$X360" 2>/dev/null)" ]; then
        for velho in "${XDG_DATA_HOME:-$HOME/.local/share}/Xenia/content" "$(dirname "$XENIA")/content"; do
            if [ -d "$velho" ] && [ -n "$(ls -A "$velho" 2>/dev/null)" ]; then
                cp -a "$velho/." "$X360/" && echo "sky-emu: saves do Xenia copiados de $velho" >&2
                break
            fi
        done
    fi
    exec "$XENIA" --fullscreen=true --gpu=vulkan --content_root="$X360" "$ROM"
    ;;
ps3)
    # 13.11: jogos que não rodam direto do .iso: na 1ª vez o .iso vira pasta (PS3_GAME/…) e o original vai para
    # ps3/.iso-originais. Assassin's Creed (BLUS30089): pelo .iso o RPCS3 devolvia o caminho do disco vazio
    # (cellDiscGameGetBootDiscInfo -> sys_fs_opendir("") = ENOENT) e o jogo ficava em tela preta; os AC também
    # exigem a pasta vazia PS3_GAME/USRDIR/ASSASSIN_ISO, que alguns dumps perdem.
    case "${ROM,,}" in *.iso)
        TID="$(python3 -c 'import importlib.machinery as m,sys; p=m.SourceFileLoader("p","/opt/skystation/bin/sky-ps3").load_module(); print((p.game_info(sys.argv[1]) or {}).get("id",""))' "$ROM" 2>/dev/null || true)"
        case " BLUS30089 BLES00158 BLJM60052 " in *" $TID "*)
            DEST="${ROM%.*}"
            # 13.12: a extração agora é do sky-instalar (tela Instalando, em segundo plano no menu).
            [ -d "$DEST/PS3_GAME" ] || fail "PS3: este jogo está sendo preparado (tela Instalando, só na 1ª vez). Espere terminar e abra de novo."
            ROM="$DEST" ;;
        esac ;;
    esac
    # O sky-ps3 desliga as telas de aviso do RPCS3, configura o controle ligado agora, instala o
    # firmware na primeira vez (demora alguns minutos) e devolve o usuário do perfil em uso.
    PREP="$(python3 /opt/skystation/bin/sky-ps3 preparar "$ROM" 2>>"${LOG:-/dev/null}" | tail -1)"
    ERR="$(printf '%s' "$PREP" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("" if d.get("ok") else d.get("error","erro"))' 2>/dev/null || echo "Não consegui preparar o RPCS3.")"
    [ -z "$ERR" ] || fail "$ERR"
    USR="$(printf '%s' "$PREP" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("user","00000001"))')"
    ulimit -n 65536 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null   # o RPCS3 reclama com menos de 4096 arquivos abertos
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
    exec /opt/rpcs3/AppRun --no-gui --fullscreen --input-config SkyStation --user-id "$USR" "$ROM"
    ;;
# ---------------- Fase 13: programas separados (quando não há core do RetroArch) ----------------
wiiu-solo)
    [ -x /opt/cemu/AppRun ] || fail "Emulador de Wii U não instalado. Rode a Fase 13 (fase13.sh)."
    # O Cemu guarda tudo em ~/.local/share/Cemu; as chaves (keys.txt) vão para lá também.
    CEMU="${XDG_DATA_HOME:-$HOME/.local/share}/Cemu"
    mkdir -p "$CEMU"
    # 13.10: aceita o keys.txt também solto em SKYROMS/bios/wiiu (e atualiza se mudou).
    for k in "$SKY/bios/wiiu/keys.txt" "$SKY/bios/wiiu/Cemu/keys.txt"; do
        [ -f "$k" ] && { cmp -s "$k" "$CEMU/keys.txt" || cp -f "$k" "$CEMU/keys.txt"; }
    done
    # .wux/.wud são o disco criptografado: sem a chave do disco no keys.txt o Cemu só mostra erro.
    case "${ROM,,}" in
        *.wux|*.wud)
            [ -s "$CEMU/keys.txt" ] || fail "Wii U: este jogo (.wux/.wud) é o disco criptografado e precisa da chave dele. Coloque o keys.txt (tirado do seu Wii U) em SKYROMS/bios/wiiu, ou use a versão .wua / em pasta, que não precisa." ;;
    esac
    # 13.12: sem settings.xml o Cemu abre o assistente de primeira vez, e escolher a pasta nele travava (139:
    # o seletor de arquivos do GTK quebra dentro do cage). Com este arquivo ele pula o assistente.
    CCONF="${XDG_CONFIG_HOME:-$HOME/.config}/Cemu"
    if [ ! -f "$CCONF/settings.xml" ]; then
        mkdir -p "$CCONF"
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<content>' '    <check_update>false</check_update>' \
            '    <fullscreen>true</fullscreen>' '    <GamePaths>' "        <Entry>$(dirname "$ROM")</Entry>" '    </GamePaths>' \
            '</content>' >"$CCONF/settings.xml"
    fi
    # Sem controle configurado o Cemu não lê o DS4: na 1ª vez abre a tela do Cemu para configurar
    # (Opções → Configurações de entrada → API SDLController → escolher o controle → Salvar).
    if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/Cemu/controllerProfiles/controller0.xml" ] \
        && [ ! -f "$CEMU/controllerProfiles/controller0.xml" ]; then
        echo "Wii U: configure o controle no Cemu (Opções → Configurações de entrada), feche e abra o jogo de novo." >"$MSG"
        exec /opt/cemu/AppRun
    fi
    exec /opt/cemu/AppRun -f -g "$ROM"
    ;;
vita-solo)
    [ -x /opt/vita3k/AppRun ] || fail "Emulador de PS Vita não instalado. Rode a Fase 13 (fase13.sh)."
    echo "sky-emu: PS Vita pelo Vita3K separado (/opt/vita3k)" >&2
    # Sem assistente de primeira vez nem tela de boas-vindas (o console não tem mouse): o jogo abre direto.
    VCONF="${XDG_CONFIG_HOME:-$HOME/.config}/Vita3K/config.yml"
    if [ ! -f "$VCONF" ]; then
        mkdir -p "$(dirname "$VCONF")"
        printf -- '---\ninitial-setup: true\nshow-welcome: false\nshow-gui: false\ndiscord-rich-presence: false\n...\n' >"$VCONF"
    else
        sed -i -e 's/^initial-setup: false/initial-setup: true/' -e 's/^show-welcome: true/show-welcome: false/' "$VCONF"
    fi
    # 13.3: instala cada .PUP uma vez (Vita3K --firmware); a marca fica ao lado, por tamanho do arquivo.
    for pup in "$VFW"/[Pp][Ss][Vv]*.[Pp][Uu][Pp] "$VFW"/*.[Pp][Uu][Pp]; do   # o do sistema (PSV…) primeiro
        [ -f "$pup" ] || continue
        marca="$VPREF/.skystation-$(basename "$pup")-$(stat -c %s "$pup")"
        [ -f "$marca" ] && continue
        echo "sky-emu: instalando o firmware $(basename "$pup")" >&2
        if timeout 600 /opt/vita3k/AppRun --firmware "$pup" </dev/null >&2; then
            mkdir -p "$VPREF" && : >"$marca"
        else
            echo "sky-emu: o Vita3K não aceitou $(basename "$pup") (código $?)" >&2
        fi
    done
    [ -d "$VPREF/vs0" ] || fail "PS Vita: o firmware não foi instalado. Confira se o PSVUPDAT.PUP em SKYROMS/bios/vita é o do site da Sony."
    # Com um .vpk/.zip o Vita3K instala o jogo (só na 1ª vez demora) e já abre.
    # 13.6 (21/nov): antes ele reinstalava do .zip a cada vez que o jogo abria, e quem fechava durante a
    # instalação (a tela fica parada) deixava o jogo pela metade em ux0/app. Agora: instalado e marcado =
    # abre direto pelo ID (-r); pela metade = apaga e instala de novo; a marca só sai quando a pasta do
    # jogo para de crescer com o eboot.bin já lá.
    VPREF="${VPREF:-${XDG_DATA_HOME:-$HOME/.local/share}/Vita3K/Vita3K}"
    TID="$(basename "$ROM" | grep -oE '[A-Z]{4}[0-9]{5}' | tail -1)"
    if [ -n "$TID" ] && [ -f "$ROM" ]; then
        APP="$VPREF/ux0/app/$TID"
        # 13.11: a marca fica FORA da pasta do jogo (o Vita3K recria a pasta no fim da instalação e a apagava)
        # 13.12: marcas antigas (13.6–13.11) saíam antes da hora e o jogo ficava com o eboot.bin ainda
        # criptografado ("Invalid SELF ... still encrypted", 21/nov). Só vale a marca nova, gravada depois
        # do "installed successfully" do Vita3K; as antigas são ignoradas e o jogo reinstala uma vez.
        MARCA="$VPREF/.skystation-instalados/$TID.ok"
        rm -f "$APP/.skystation-instalado" "$VPREF/.skystation-instalados/$TID"
        if [ -f "$MARCA" ] && [ -f "$APP/eboot.bin" ]; then
            echo "sky-emu: PS Vita $TID já instalado: abre direto" >&2
            exec /opt/vita3k/AppRun -r "$TID"
        fi
        if [ -d "$APP" ]; then
            echo "sky-emu: PS Vita $TID ficou pela metade numa vez anterior: instalando de novo" >&2
            rm -rf "$APP"
        fi
        echo "PS Vita: instalando o jogo (só na 1ª vez; pode levar alguns minutos com a tela parada). Não feche." >"$MSG"
        rm -f "$HOME/.cache/Vita3K/vita3k.log"   # o "installed successfully" tem que ser desta vez
        (   antes=-1; parado=0
            while kill -0 $$ 2>/dev/null; do
                sleep 3
                # 13.10: a licença (.rif) é copiada só no FIM da instalação. Antes bastava o eboot.bin com a
                # pasta parada 12 s, mas a pasta fica parada ~3 min enquanto o Vita3K descriptografa (21/nov):
                # a marca saía cedo e quem fechasse ali ficava com o jogo pela metade "instalado".
                # 13.11: só quando o próprio Vita3K diz que terminou (a licença antiga continua lá numa reinstalação)
                grep -q "\[$TID\] installed successfully" "$HOME/.cache/Vita3K/vita3k.log" 2>/dev/null || continue
                [ -f "$APP/eboot.bin" ] || continue
                agora="$(du -sb "$APP" 2>/dev/null | cut -f1)"
                if [ "$agora" = "$antes" ]; then parado=$((parado + 1)); else parado=0; fi
                antes="$agora"
                if [ "$parado" -ge 2 ]; then
                    mkdir -p "${MARCA%/*}" && : >"$MARCA" && echo "sky-emu: PS Vita $TID instalado ($agora bytes)" >&2
                    break
                fi
            done ) &
    fi
    exec /opt/vita3k/AppRun "$ROM"
    ;;
xbox-solo)
    [ -x /opt/xemu/AppRun ] || fail "Emulador de Xbox não instalado. Rode a Fase 13 (fase13.sh)."
    X="$SKY/bios/xbox/xemu"
    for f in mcpx_1.0.bin Complex_4627v1.03.bin xbox_hdd.qcow2; do
        [ -f "$X/$f" ] || fail "Xbox: falta $f em SKYROMS/bios/xbox (MCPX, BIOS e o HD do xemu)."
    done
    # Configuração refeita a cada jogo (o HD fica no perfil: cada perfil tem os seus saves).
    [ -f "$SKY/saves/xbox/xbox_hdd.qcow2" ] || cp "$X/xbox_hdd.qcow2" "$SKY/saves/xbox/xbox_hdd.qcow2"
    TOML="$HOME/.config/skystation/xemu.toml"
    mkdir -p "$(dirname "$TOML")"
    cat >"$TOML" <<EOF
[general]
show_welcome = false

[sys.files]
bootrom_path = '$X/mcpx_1.0.bin'
flashrom_path = '$X/Complex_4627v1.03.bin'
hdd_path = '$SKY/saves/xbox/xbox_hdd.qcow2'
eeprom_path = '$SKY/saves/xbox/eeprom.bin'
EOF
    exec /opt/xemu/AppRun -config_path "$TOML" -full-screen -dvd_path "$ROM"
    ;;
ps4)
    # PS4 (Fase 13, experimental): shadPS4. O jogo é a pasta com eboot.bin (ex.: CUSA00001).
    [ -x /opt/shadps4/AppRun ] || fail "Emulador de PS4 não instalado. Rode a Fase 13 (fase13.sh)."
    precisa_forte "PS4"
    EBOOT="$ROM"
    [ -d "$ROM" ] && EBOOT="$ROM/eboot.bin"
    [ -f "$EBOOT" ] || fail "PS4: a pasta do jogo precisa ter o eboot.bin."
    # 13.13: módulos e fontes do sistema tirados do PS4 do próprio usuário. Coloque em SKYROMS/bios/ps4/sys_modules
    # (os .sprx de /system/common/lib) e SKYROMS/bios/ps4/fonts (as fontes do sistema, como o
    # que o dumper gerar). O shadPS4 procura em ~/.local/share/shadPS4/{sys_modules,fonts}.
    SHAD="${XDG_DATA_HOME:-$HOME/.local/share}/shadPS4"
    for d in sys_modules fonts; do
        [ -d "/mnt/skyroms/bios/ps4/$d" ] || continue
        mkdir -p "$SHAD/$d"
        cp -rn "/mnt/skyroms/bios/ps4/$d/." "$SHAD/$d/" 2>/dev/null || true
    done
    exec /opt/shadps4/AppRun --fullscreen true -g "$EBOOT"
    ;;
switch)
    # Switch 1 (Fase 13, só testes): Eden ou Citron, o AppImage que você deixou em SKYROMS/emuladores.
    [ -x /opt/switch/AppRun ] || fail "Switch: baixe o Eden (ou Citron) no site oficial, ponha em SKYROMS/emuladores e rode a Fase 13."
    precisa_forte "Switch"
    bios_sync
    # Chaves e firmware do SEU console. Os dois emuladores vêm do yuzu e usam o mesmo formato.
    for d in eden citron; do
        DATA="${XDG_DATA_HOME:-$HOME/.local/share}/$d"
        mkdir -p "$DATA/keys"
        for k in prod.keys title.keys; do [ -f "$SKY/bios/switch/$k" ] && cp -n "$SKY/bios/switch/$k" "$DATA/keys/"; done
        FW="$DATA/nand/system/Contents/registered"
        for o in "$SKY/bios/switch/firmware" "/mnt/skyroms/bios/switch/firmware"; do
            if [ -d "$o" ] && [ -z "$(ls -A "$FW" 2>/dev/null)" ]; then
                mkdir -p "$FW" && cp -n "$o"/*.nca "$FW/" 2>/dev/null
            fi
        done
    done
    ls "$SKY/bios/switch"/prod.keys >/dev/null 2>&1 \
        || fail "Switch: falta o prod.keys (do seu Switch) em SKYROMS/bios/switch."
    exec /opt/switch/AppRun -f -g "$ROM"
    ;;
*)
    fail "Sistema desconhecido: $SYS"
    ;;
esac
