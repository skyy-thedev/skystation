#!/bin/bash
# SkyStation: roda DENTRO do cage (por isso tem acesso à tela Wayland).
# Sobe o botão Home em segundo plano e depois o launcher.
# Uso: sky-shell <comando do launcher...>
LOG_DIR="$HOME/.local/state/skystation"
mkdir -p "$LOG_DIR"
export SDL_VIDEODRIVER=wayland

# Resolução escolhida com "skystation-vm resolucao" (menos pixels = mais FPS na VM).
RES="$(tr -d '[:space:]' 2>/dev/null <"$HOME/.config/skystation/resolucao")"
if [ -n "$RES" ] && command -v wlr-randr >/dev/null 2>&1; then
    OUT="$(wlr-randr 2>/dev/null | awk 'NR==1{print $1}')"
    if [ -n "$OUT" ]; then
        wlr-randr --output "$OUT" --mode "$RES" 2>/dev/null \
            || wlr-randr --output "$OUT" --custom-mode "$RES" 2>/dev/null \
            || echo "sky-shell: não consegui aplicar a resolução $RES" >>"$LOG_DIR/home.log"
    fi
fi

python3 /opt/skystation/bin/sky-home.py >"$LOG_DIR/home.log" 2>&1 &
HOME_PID=$!
# Fase 5.6: avisos com som (controle, USB, pendrive, jogo novo, bateria, temperatura)
NOTIFY_PID=""
if [ -f /opt/skystation/bin/sky-notify ]; then
    python3 /opt/skystation/bin/sky-notify >"$LOG_DIR/notify.log" 2>&1 &
    NOTIFY_PID=$!
fi
# Fase 7.0: Central web em segundo plano (só sobe se estiver ligada em Sistema → Central web)
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/skystation"
if [ -f /opt/skystation/bin/sky-receber ]; then
    python3 /opt/skystation/bin/sky-receber servir >>"$LOG_DIR/central.log" 2>&1 &
fi
encerrar() {
    kill "$HOME_PID" $NOTIFY_PID 2>/dev/null
    # a central pode ter sido ligada depois, pelo menu: encerra pelo PID que ela mesma anota
    CPID="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid",""))' "$RUN_DIR/central.json" 2>/dev/null)"
    [ -n "$CPID" ] && kill "$CPID" 2>/dev/null
}
trap encerrar EXIT

"$@"
