#!/usr/bin/env python3
"""SkyStation 13.27: jogos de PC (Steam e Epic) que já estão instalados no HD do Windows.

    sky-pc sincronizar        cria/atualiza os jogos da categoria PC no menu (e ajusta a Steam, se fechada)
    sky-pc jogar steam <appid>     abre o jogo pela Steam (Proton)
    sky-pc jogar epic <AppName>    abre o jogo pelo Heroic (Epic)
    sky-pc steam | heroic     abre o app (entrar na conta, baixar jogos, configurar)
    sky-pc estado             JSON: bibliotecas achadas, apps instalados, jogos

As bibliotecas são achadas e montadas pelo skystation-pcjogos (root), em /mnt/pc/steamN e /mnt/pc/epicN.
Steam e Heroic são os Flatpaks oficiais do Flathub (instalados pela SkyStore). Cada jogo vira uma pasta em
~/skystation/games/pc-steam-<appid> (ou pc-epic-<AppName>) com game.json, como os outros jogos do menu.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
JOGOS = os.path.join(HOME, "skystation/games")
ESTADO = "/run/skystation/pcjogos.json"
STEAM_ID = "com.valvesoftware.Steam"
HEROIC_ID = "com.heroicgameslauncher.hgl"
STEAM_DIR = os.path.join(HOME, ".var/app", STEAM_ID, ".local/share/Steam")
HEROIC_CFG = os.path.join(HOME, ".var/app", HEROIC_ID, "config")
# o Heroic guarda a config do legendary (o "motor" da Epic) dentro da dele, não em ~/.config/legendary
LEGENDARY = os.path.join(HEROIC_CFG, "heroic/legendaryConfig/legendary")
MSG = os.environ.get("SKY_MSG_FILE", "")
SKY_BIN = os.path.dirname(os.path.abspath(__file__))
# O que a Steam instala junto e não é jogo
NAO_JOGO = re.compile(r"proton|steam linux runtime|steamworks|redistributable|steamvr|soundtrack|dedicated server", re.I)


def saida(d):
    print(json.dumps(d, ensure_ascii=False))
    return 0 if d.get("ok", True) else 1


def falha(texto):
    if MSG:
        try:
            with open(MSG, "w") as f:
                f.write(texto)
        except OSError:
            pass
    print(texto, file=sys.stderr)
    return 3


def flatpak_tem(app):
    return bool(shutil.which("flatpak")) and subprocess.run(
        ["flatpak", "info", app], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def rodando(padrao):
    return subprocess.run(["pgrep", "-f", padrao], stdout=subprocess.DEVNULL).returncode == 0


def bibliotecas():
    try:
        return json.load(open(ESTADO))
    except (OSError, ValueError):
        return {"steam": [], "epic": []}


# ---------------------------------------------------------------- VDF (o formato de texto da Steam)

def vdf_ler(texto):
    toks = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', texto)
    pos = 0

    def bloco():
        nonlocal pos
        d = {}
        while pos < len(toks):
            s, ch = toks[pos]
            pos += 1
            if ch == "}":
                return d
            chave = s
            s2, ch2 = toks[pos]
            pos += 1
            d[chave] = bloco() if ch2 == "{" else s2
        return d
    return bloco()


def vdf_escrever(d, nivel=0):
    t = "\t" * nivel
    out = []
    for k, v in d.items():
        if isinstance(v, dict):
            out.append(f'{t}"{k}"\n{t}{{\n{vdf_escrever(v, nivel + 1)}{t}}}\n')
        else:
            out.append(f'{t}"{k}"\t\t"{v}"\n')
    return "".join(out)


def acf(caminho):
    try:
        return vdf_ler(open(caminho, encoding="utf-8", errors="replace").read()).get("AppState", {})
    except (OSError, IndexError, ValueError):
        return {}


# ---------------------------------------------------------------- Steam: bibliotecas e Proton

def ajustar_steam(libs):
    """Põe as bibliotecas do HD na Steam e liga o Proton para todos os jogos. Só com a Steam fechada
    (ela reescreve esses arquivos ao sair). Na 1ª vez a Steam ainda não criou nada: fica para depois."""
    if not os.path.isdir(os.path.join(STEAM_DIR, "steamapps")) or rodando("steamwebhelper|/app/bin/steam|ubuntu12_32/steam"):
        return False
    mudou = False
    lf = os.path.join(STEAM_DIR, "steamapps/libraryfolders.vdf")
    try:
        d = vdf_ler(open(lf).read())
    except (OSError, IndexError, ValueError):
        d = {}
    pastas = d.setdefault("libraryfolders", {})
    tem = {v.get("path") for v in pastas.values() if isinstance(v, dict)}
    for lib in libs:
        if lib["ponto"] not in tem:
            k = str(max([int(x) for x in pastas if x.isdigit()] + [-1]) + 1)
            pastas[k] = {"path": lib["ponto"], "label": "HD do Windows", "contentid": "0", "totalsize": "0", "apps": {}}
            mudou = True
    if mudou:
        with open(lf + ".tmp", "w") as f:
            f.write(vdf_escrever(d))
        os.replace(lf + ".tmp", lf)
    cfg = os.path.join(STEAM_DIR, "config/config.vdf")
    try:
        c = vdf_ler(open(cfg).read())
        steam = c.setdefault("InstallConfigStore", {}).setdefault("Software", {}).setdefault("Valve", {}).setdefault("Steam", {})
        mapa = steam.setdefault("CompatToolMapping", {})
        if "0" not in mapa:      # "Ativar o Steam Play para todos os outros títulos" com o Proton Experimental
            mapa["0"] = {"name": "proton_experimental", "config": "", "priority": "75"}
            with open(cfg + ".tmp", "w") as f:
                f.write(vdf_escrever(c))
            os.replace(cfg + ".tmp", cfg)
            mudou = True
    except (OSError, IndexError, ValueError):
        pass
    return mudou


def capa(destino, urls):
    if os.path.exists(destino):
        return
    for u in urls:
        try:
            req = urllib.request.Request(u, headers={"User-Agent": "SkyStation/13.27"})
            with urllib.request.urlopen(req, timeout=15) as r:
                dados = r.read()
            if dados[:2] == b"\xff\xd8" and len(dados) > 5000:
                with open(destino + ".tmp", "wb") as f:
                    f.write(dados)
                os.replace(destino + ".tmp", destino)
                return
        except OSError:
            continue


def grava_jogo(pasta, dados):
    os.makedirs(pasta, exist_ok=True)
    caminho = os.path.join(pasta, "game.json")
    novo = json.dumps(dados, ensure_ascii=False, indent=1)
    try:
        if open(caminho).read() == novo:
            return
    except OSError:
        pass
    with open(caminho + ".tmp", "w") as f:
        f.write(novo)
    os.replace(caminho + ".tmp", caminho)


def sincronizar():
    est = bibliotecas()
    steam_ok, heroic_ok = flatpak_tem(STEAM_ID), flatpak_tem(HEROIC_ID)
    if steam_ok:
        ajustar_steam(est.get("steam", []))
    vistos = set()
    n = 0
    for lib in est.get("steam", []):
        for m in glob.glob(os.path.join(lib["ponto"], "steamapps/appmanifest_*.acf")):
            a = acf(m)
            appid, nome = str(a.get("appid", "")), str(a.get("name", ""))
            if not appid.isdigit() or not nome or NAO_JOGO.search(nome):
                continue
            if not int(a.get("StateFlags", "4") or 4) & 4:      # 4 = totalmente instalado
                continue
            pasta = os.path.join(JOGOS, f"pc-steam-{appid}")
            vistos.add(os.path.basename(pasta))
            desc = "Steam · roda pelo Proton, direto na placa de vídeo (sem emulação). Do HD do Windows (" + \
                lib.get("origem", "") + ")."
            if not steam_ok:
                desc = "Instale a Steam pela SkyStore (Apps) para jogar. " + desc
            if lib.get("modo") == "ro":
                desc += " O HD está só leitura (Windows hibernado): a Steam pode não abrir o jogo."
            grava_jogo(pasta, {"title": nome, "type": "windows", "exec": f"{SKY_BIN}/sky-pc jogar steam {appid}",
                               "cover": "cover.jpg", "color": "#1b2838", "order": 50, "description": desc})
            cdn = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}"
            capa(os.path.join(pasta, "cover.jpg"), [cdn + "/library_600x900_2x.jpg", cdn + "/library_600x900.jpg",
                                                    cdn + "/header.jpg"])
            n += 1
    epic = est.get("epic", [])
    if heroic_ok and epic:
        ajustar_heroic(epic)
    inst = epic_instalados()
    for jg in epic:
        app = re.sub(r"[^A-Za-z0-9_-]", "", jg.get("appName", ""))
        if not app:
            continue
        if heroic_ok and epic_logado() and app not in inst and jg.get("modo") != "ro" \
                and not rodando("heroic"):
            importar_epic(app, jg["ponto"])
        pasta = os.path.join(JOGOS, f"pc-epic-{app}")
        vistos.add(os.path.basename(pasta))
        desc = "Epic Games · roda pelo Heroic (Wine/Proton), direto na placa de vídeo."
        if not heroic_ok:
            desc = "Instale o Heroic pela SkyStore (Apps) e entre na sua conta Epic para jogar. " + desc
        elif not epic_logado():
            desc = "Abra o Heroic (Apps) e entre na sua conta Epic: depois o jogo aparece lá e abre daqui. " + desc
        if heroic_ok and not rodando("wineserver"):
            for reg in prefixos_epic(app):
                controle_xinput(reg)
        titulo = (epic_instalados().get(app) or {}).get("title") or jg.get("titulo") or app
        grava_jogo(pasta, {"title": titulo, "type": "windows",
                           "exec": f"{SKY_BIN}/sky-pc jogar epic {app}", "cover": "cover.jpg", "color": "#2a2a2a",
                           "order": 51, "description": desc})
        capa(os.path.join(pasta, "cover.jpg"), capas_epic(app))
        n += 1
    # jogo que sumiu do HD (desinstalado no Windows) sai do menu
    for p in glob.glob(os.path.join(JOGOS, "pc-steam-*")) + glob.glob(os.path.join(JOGOS, "pc-epic-*")):
        if os.path.basename(p) not in vistos:
            shutil.rmtree(p, ignore_errors=True)
    return saida({"ok": True, "jogos": n, "steam": steam_ok, "heroic": heroic_ok,
                  "bibliotecas": len(est.get("steam", [])) + len(est.get("epic", []))})


# ---------------------------------------------------------------- jogar

def jogar_steam(appid):
    if not flatpak_tem(STEAM_ID):
        return falha("Instale a Steam pela SkyStore (aba Apps) para jogar os jogos de PC.")
    ajustar_steam(bibliotecas().get("steam", []))
    # -gamepadui: a interface de TV da Steam (a mesma do Steam Deck). Na 1ª vez ela pede o login
    # (dá para entrar pelo QR code com o app da Steam no celular). Para voltar ao SkyStation: Home → Fechar.
    os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-gamepadui", f"steam://rungameid/{appid}"])


def jogar_epic(app):
    if not flatpak_tem(HEROIC_ID):
        return falha("Instale o Heroic pela SkyStore (aba Apps) e entre na sua conta Epic.")
    if not epic_logado():
        # 1ª vez: abre o Heroic para entrar na conta Epic; o SkyStation importa os jogos do HD quando ele fechar
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID])
    if app not in epic_instalados():
        jg = next((j for j in bibliotecas().get("epic", []) if j.get("appName") == app), None)
        if jg and not importar_epic(app, jg["ponto"]):
            return falha("Não consegui importar o jogo do HD no Heroic. Abra o Heroic (Apps) e confira a conta Epic.")
    if not rodando("wineserver"):
        for reg in prefixos_epic(app):
            controle_xinput(reg)
    os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID, "--no-gui", f"heroic://launch?appName={app}&runner=legendary"])


def epic_logado():
    return os.path.exists(os.path.join(LEGENDARY, "user.json"))


def epic_instalados():
    try:
        d = json.load(open(os.path.join(LEGENDARY, "installed.json")))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def capas_epic(app):
    """A capa vertical da loja (DieselGameBoxTall), do metadata que o legendary baixou ao entrar na conta."""
    try:
        imgs = json.load(open(os.path.join(LEGENDARY, "metadata", app + ".json")))["metadata"]["keyImages"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    ordem = ["DieselGameBoxTall", "OfferImageTall", "DieselGameBox"]
    return [i["url"] for t in ordem for i in imgs if i.get("type") == t and i.get("url")]


def ajustar_heroic(epic):
    """Jogo novo instalado pelo Heroic vai para a mesma pasta Epic do HD (com exec) em vez do pendrive."""
    mae = next((j.get("mae") for j in epic if j.get("mae") and j.get("modo") != "ro"), "")
    cfg = os.path.join(HEROIC_CFG, "heroic/config.json")
    if not mae or not os.path.exists(cfg) or rodando("heroic"):
        return
    try:
        c = json.load(open(cfg))
        ds = c.setdefault("defaultSettings", {})
        if ds.get("defaultInstallPath") == mae:
            return
        ds["defaultInstallPath"] = mae
        with open(cfg + ".tmp", "w") as f:
            json.dump(c, f, indent=2)
        os.replace(cfg + ".tmp", cfg)
    except (OSError, ValueError, AttributeError):
        pass


WINEBUS = "System\\\\CurrentControlSet\\\\Services\\\\winebus"
WINEBUS_VALORES = {"DisableHidraw": "dword:00000001", "Enable SDL": "dword:00000001"}


def prefixos_epic(app):
    """Os "Windows de mentira" (prefixos do Wine/Proton) que o Heroic usa para o jogo."""
    cand = []
    try:
        c = json.load(open(os.path.join(HEROIC_CFG, "heroic/GamesConfig", app + ".json")))
        pref = (c.get(app) or {}).get("winePrefix")
        if pref:
            cand.append(pref.replace("~", HOME, 1))
    except (OSError, ValueError, AttributeError):
        pass
    titulo = (epic_instalados().get(app) or {}).get("title", "")
    for base in (os.path.join(HOME, "Games/Heroic/Prefixes/default"), os.path.join(HOME, "Games/Heroic/Prefixes")):
        if titulo:
            cand.append(os.path.join(base, titulo))
    out = []
    for c in cand:
        for reg in (os.path.join(c, "system.reg"), os.path.join(c, "pfx/system.reg")):
            if os.path.isfile(reg) and reg not in out:
                out.append(reg)
    return out


def controle_xinput(reg):
    """DualShock/DualSense como controle de Xbox (XInput) para o jogo.

    Por padrão o Wine passa o controle da Sony "cru" (hidraw): só funciona em jogo que fala direto com o
    DualShock. O resto (ex.: Death Stranding da Epic) não vê botão nenhum, só o touchpad (que vira mouse).
    Com DisableHidraw o Wine usa o SDL, que traduz qualquer controle para XInput, o que todo jogo de PC entende.
    Edita o system.reg (texto) com o jogo fechado."""
    try:
        txt = open(reg, encoding="utf-8", errors="surrogateescape").read()
    except OSError:
        return
    sec = "[" + WINEBUS + "]"
    linhas = txt.split("\n")
    i = next((k for k, l in enumerate(linhas) if l.startswith(sec)), None)
    if i is None:
        bloco = [f"{sec} {int(time.time())}"] + [f'"{k}"={v}' for k, v in WINEBUS_VALORES.items()] + [""]
        linhas = linhas[:-1] + [""] + bloco + linhas[-1:] if linhas and linhas[-1] == "" else linhas + [""] + bloco
    else:
        fim = next((k for k in range(i + 1, len(linhas)) if linhas[k].startswith("[")), len(linhas))
        corpo = [l for l in linhas[i + 1:fim] if not any(l.startswith(f'"{k}"=') for k in WINEBUS_VALORES)]
        while corpo and corpo[-1] == "":
            corpo.pop()
        corpo += [f'"{k}"={v}' for k, v in WINEBUS_VALORES.items()] + [""]
        linhas = linhas[:i + 1] + corpo + linhas[fim:]
    novo = "\n".join(linhas)
    if novo != txt:
        with open(reg + ".tmp", "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(novo)
        os.replace(reg + ".tmp", reg)


def importar_epic(app, pasta):
    """O jogo já está no HD: o legendary (o "motor" da Epic dentro do Heroic) só anota onde ele está.
    Precisa da conta Epic conectada no Heroic (ele confere o jogo na sua biblioteca)."""
    script = ('export LEGENDARY_CONFIG_PATH="$XDG_CONFIG_HOME/heroic/legendaryConfig/legendary"; '
              'L="$(find /app -name legendary -type f -perm -u+x 2>/dev/null | head -1)"; '
              '[ -n "$L" ] && exec "$L" -y import --with-dlcs "$0" "$1"')
    try:
        r = subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--command=sh", HEROIC_ID, "-c", script, app, pasta],
                           capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
        os.makedirs(os.path.join(HOME, ".local/state/skystation"), exist_ok=True)
        with open(os.path.join(HOME, ".local/state/skystation/pc-epic.log"), "a") as f:
            f.write(f"--- import {app} {pasta} rc={r.returncode}\n{r.stdout[-2000:]}{r.stderr[-2000:]}\n")
        return r.returncode == 0 and app in epic_instalados()
    except (OSError, subprocess.SubprocessError):
        return False


def diag():
    """Relatório do controle nos jogos de PC: na tela e num arquivo no HD (dá para ler pelo Windows)."""
    out = []
    p = out.append
    p("== SkyStation: diagnóstico do controle nos jogos de PC (" + time.strftime("%d/%m %H:%M") + ")")
    p("-- controles que o Linux vê")
    try:
        blocos = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        blocos = []
    for b in blocos:
        nome = re.search(r'N: Name="([^"]*)"', b)
        hand = re.search(r"H: Handlers=(.*)", b)
        if nome and re.search(r"controller|gamepad|joystick|wireless|xbox|dualsense|dualshock|8bitdo", nome.group(1), re.I):
            p(f"   {nome.group(1)}  [{hand.group(1).strip() if hand else ''}]")
    for d in sorted(glob.glob("/dev/hidraw*")) + ["/dev/uinput"]:
        p(f"   {d}: {'pode ler' if os.access(d, os.R_OK | os.W_OK) else 'SEM ACESSO'}")
    p("-- dentro do Heroic (Flatpak)")
    if flatpak_tem(HEROIC_ID):
        try:
            r = subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--command=sh", HEROIC_ID, "-c",
                                "ls /dev/input 2>&1 | tr '\\n' ' '; echo; ls -d /run/udev/data 2>&1; "
                                "ls /dev/hidraw* 2>&1 | tr '\\n' ' '"],
                               capture_output=True, text=True, timeout=60)
            for l in (r.stdout + r.stderr).strip().split("\n"):
                p("   " + l[:200])
        except (OSError, subprocess.SubprocessError) as e:
            p(f"   erro: {e}")
        try:
            p("   overrides: " + subprocess.run(["flatpak", "override", "--show", HEROIC_ID], capture_output=True,
                                                 text=True, timeout=20).stdout.replace("\n", " ")[:300])
        except (OSError, subprocess.SubprocessError):
            pass
    else:
        p("   Heroic não instalado")
    p("-- jogos da Epic: prefixo do Wine e o ajuste do controle")
    for app, info in epic_instalados().items():
        regs = prefixos_epic(app)
        p(f"   {info.get('title', app)} ({app}): {len(regs)} prefixo(s)")
        for reg in regs:
            try:
                txt = open(reg, encoding="utf-8", errors="replace").read()
                i = txt.find("[" + WINEBUS + "]")
                sec = txt[i:].split("\n\n")[0].replace("\n", " | ") if i >= 0 else "SEM a seção winebus"
            except OSError as e:
                sec = str(e)
            p(f"     {reg}")
            p(f"       {sec[:300]}")
        try:
            c = json.load(open(os.path.join(HEROIC_CFG, "heroic/GamesConfig", app + ".json"))).get(app, {})
            p(f"     wine: {(c.get('wineVersion') or {}).get('name', '?')}  prefixo: {c.get('winePrefix', '?')}")
        except (OSError, ValueError, AttributeError):
            p("     (sem configuração própria no Heroic)")
    p("-- último log de jogo do Heroic (linhas sobre controle)")
    logs = sorted(glob.glob(os.path.join(HEROIC_CFG, "heroic/**/*.log"), recursive=True), key=os.path.getmtime)
    logs = [l for l in logs if "lastPlay" in l or "/games/" in l] or logs
    if logs:
        p("   " + logs[-1])
        try:
            linhas = open(logs[-1], errors="replace").read().split("\n")
        except OSError:
            linhas = []
        chave = re.compile(r"winebus|hidraw|sdl|xinput|dinput|joystick|controller|gamepad|steam_input|umu|proton|wine version|err:", re.I)
        sel = [l for l in linhas if chave.search(l)][-25:]
        for l in sel:
            p("   " + l.strip()[:200])
    else:
        p("   nenhum log de jogo")
    texto = "\n".join(out) + "\n"
    print(texto)
    for destino in ("/mnt/skyroms/skystation-diag-pc.txt", os.path.join(HOME, "skystation/diag-pc.txt")):
        try:
            with open(destino, "w") as f:
                f.write(texto)
            print("Salvo em " + destino)
        except OSError:
            pass
    return 0


def main():
    # A sessão do SkyStation define QT_QPA_PLATFORM=xcb (para os emuladores feitos em Qt). Um programa
    # Windows feito em Qt, rodando pelo Wine/Proton (ex.: o REDlauncher do The Witcher 3), também lê essa
    # variável, procura um plugin "xcb" que no Windows não existe e fecha com "no Qt platform plugin".
    for v in ("QT_QPA_PLATFORM", "QT_PLUGIN_PATH", "QT_QPA_PLATFORMTHEME", "QT_STYLE_OVERRIDE"):
        os.environ.pop(v, None)
    a = sys.argv[1:]
    cmd = a[0] if a else "estado"
    if cmd == "sincronizar":
        return sincronizar()
    if cmd == "jogar" and len(a) == 3 and a[1] == "steam" and a[2].isdigit():
        return jogar_steam(a[2])
    if cmd == "jogar" and len(a) == 3 and a[1] == "epic" and re.fullmatch(r"[A-Za-z0-9_-]+", a[2]):
        return jogar_epic(a[2])
    if cmd == "steam":
        if not flatpak_tem(STEAM_ID):
            return falha("Instale a Steam pela SkyStore (aba Apps).")
        ajustar_steam(bibliotecas().get("steam", []))
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-gamepadui"])
    if cmd == "heroic":
        if not flatpak_tem(HEROIC_ID):
            return falha("Instale o Heroic pela SkyStore (aba Apps).")
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID])
    if cmd == "diag":
        return diag()
    if cmd == "estado":
        return saida({"ok": True, **bibliotecas(), "steamInstalada": flatpak_tem(STEAM_ID),
                      "heroicInstalado": flatpak_tem(HEROIC_ID), "t": int(time.time())})
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
