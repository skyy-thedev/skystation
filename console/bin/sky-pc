#!/usr/bin/env python3
"""SkyStation 13.27: jogos de PC (Steam e Epic) que já estão instalados no HD do Windows.

    sky-pc sincronizar        cria/atualiza os jogos da categoria PC no menu (e ajusta a Steam, se fechada)
    sky-pc jogar steam <appid>     abre o jogo pela Steam (Proton)
    sky-pc jogar epic <AppName>    abre o jogo pelo Heroic (Epic)
    sky-pc steam | heroic     abre o app (entrar na conta, baixar jogos, configurar)
    sky-pc estado             JSON: bibliotecas achadas, apps instalados, jogos

As bibliotecas são achadas e montadas pelo skystation-pcjogos (root), em /mnt/pc/steamN e /mnt/pc/epicN.
Steam e Heroic são os Flatpaks oficiais do Flathub (instalados pela SkyStore). Cada jogo vira uma pasta em
~/skystation/games/pc-steam-<appid> (ou pc-epic-<AppName>) com game.json, como os outros jogos do menu.
"""
import glob
import json
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
JOGOS = os.path.join(HOME, "skystation/games")
ESTADO = "/run/skystation/pcjogos.json"
STEAM_ID = "com.valvesoftware.Steam"
HEROIC_ID = "com.heroicgameslauncher.hgl"
STEAM_DIR = os.path.join(HOME, ".var/app", STEAM_ID, ".local/share/Steam")
HEROIC_CFG = os.path.join(HOME, ".var/app", HEROIC_ID, "config")
# o Heroic guarda a config do legendary (o "motor" da Epic) dentro da dele, não em ~/.config/legendary
LEGENDARY = os.path.join(HEROIC_CFG, "heroic/legendaryConfig/legendary")
MSG = os.environ.get("SKY_MSG_FILE", "")
SKY_BIN = os.path.dirname(os.path.abspath(__file__))
# O que a Steam instala junto e não é jogo
NAO_JOGO = re.compile(r"proton|steam linux runtime|steamworks|redistributable|steamvr|soundtrack|dedicated server", re.I)


def saida(d):
    print(json.dumps(d, ensure_ascii=False))
    return 0 if d.get("ok", True) else 1


def falha(texto):
    if MSG:
        try:
            with open(MSG, "w") as f:
                f.write(texto)
        except OSError:
            pass
    print(texto, file=sys.stderr)
    return 3


def flatpak_tem(app):
    return bool(shutil.which("flatpak")) and subprocess.run(
        ["flatpak", "info", app], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def rodando(padrao):
    return subprocess.run(["pgrep", "-f", padrao], stdout=subprocess.DEVNULL).returncode == 0


def bibliotecas():
    try:
        return json.load(open(ESTADO))
    except (OSError, ValueError):
        return {"steam": [], "epic": []}


# ---------------------------------------------------------------- VDF (o formato de texto da Steam)

def vdf_ler(texto):
    toks = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', texto)
    pos = 0

    def bloco():
        nonlocal pos
        d = {}
        while pos < len(toks):
            s, ch = toks[pos]
            pos += 1
            if ch == "}":
                return d
            chave = s
            s2, ch2 = toks[pos]
            pos += 1
            d[chave] = bloco() if ch2 == "{" else s2
        return d
    return bloco()


def vdf_escrever(d, nivel=0):
    t = "\t" * nivel
    out = []
    for k, v in d.items():
        if isinstance(v, dict):
            out.append(f'{t}"{k}"\n{t}{{\n{vdf_escrever(v, nivel + 1)}{t}}}\n')
        else:
            out.append(f'{t}"{k}"\t\t"{v}"\n')
    return "".join(out)


def acf(caminho):
    try:
        return vdf_ler(open(caminho, encoding="utf-8", errors="replace").read()).get("AppState", {})
    except (OSError, IndexError, ValueError):
        return {}


# ---------------------------------------------------------------- Steam: bibliotecas e Proton

def ajustar_steam(libs):
    """Põe as bibliotecas do HD na Steam e liga o Proton para todos os jogos. Só com a Steam fechada
    (ela reescreve esses arquivos ao sair). Na 1ª vez a Steam ainda não criou nada: fica para depois."""
    if not os.path.isdir(os.path.join(STEAM_DIR, "steamapps")) or rodando("steamwebhelper|/app/bin/steam|ubuntu12_32/steam"):
        return False
    mudou = False
    lf = os.path.join(STEAM_DIR, "steamapps/libraryfolders.vdf")
    try:
        d = vdf_ler(open(lf).read())
    except (OSError, IndexError, ValueError):
        d = {}
    pastas = d.setdefault("libraryfolders", {})
    tem = {v.get("path") for v in pastas.values() if isinstance(v, dict)}
    for lib in libs:
        if lib["ponto"] not in tem:
            k = str(max([int(x) for x in pastas if x.isdigit()] + [-1]) + 1)
            pastas[k] = {"path": lib["ponto"], "label": "HD do Windows", "contentid": "0", "totalsize": "0", "apps": {}}
            mudou = True
    if mudou:
        with open(lf + ".tmp", "w") as f:
            f.write(vdf_escrever(d))
        os.replace(lf + ".tmp", lf)
    cfg = os.path.join(STEAM_DIR, "config/config.vdf")
    try:
        c = vdf_ler(open(cfg).read())
        steam = c.setdefault("InstallConfigStore", {}).setdefault("Software", {}).setdefault("Valve", {}).setdefault("Steam", {})
        mapa = steam.setdefault("CompatToolMapping", {})
        if "0" not in mapa:      # "Ativar o Steam Play para todos os outros títulos" com o Proton Experimental
            mapa["0"] = {"name": "proton_experimental", "config": "", "priority": "75"}
            with open(cfg + ".tmp", "w") as f:
                f.write(vdf_escrever(c))
            os.replace(cfg + ".tmp", cfg)
            mudou = True
    except (OSError, IndexError, ValueError):
        pass
    return mudou


def capa(destino, urls):
    if os.path.exists(destino):
        return
    for u in urls:
        if not u or not u.startswith("https://"):
            continue
        try:
            req = urllib.request.Request(u, headers={"User-Agent": "SkyStation/13.27"})
            with urllib.request.urlopen(req, timeout=15) as r:
                dados = r.read()
            if dados[:2] == b"\xff\xd8" and len(dados) > 5000:
                with open(destino + ".tmp", "wb") as f:
                    f.write(dados)
                os.replace(destino + ".tmp", destino)
                return
        except OSError:
            continue


def grava_jogo(pasta, dados):
    os.makedirs(pasta, exist_ok=True)
    caminho = os.path.join(pasta, "game.json")
    novo = json.dumps(dados, ensure_ascii=False, indent=1)
    try:
        if open(caminho).read() == novo:
            return
    except OSError:
        pass
    with open(caminho + ".tmp", "w") as f:
        f.write(novo)
    os.replace(caminho + ".tmp", caminho)


def sincronizar():
    est = bibliotecas()
    steam_ok, heroic_ok = flatpak_tem(STEAM_ID), flatpak_tem(HEROIC_ID)
    if steam_ok:
        ajustar_steam(est.get("steam", []))
    vistos = set()
    n = 0
    for lib in est.get("steam", []):
        for m in glob.glob(os.path.join(lib["ponto"], "steamapps/appmanifest_*.acf")):
            a = acf(m)
            appid, nome = str(a.get("appid", "")), str(a.get("name", ""))
            if not appid.isdigit() or not nome or NAO_JOGO.search(nome):
                continue
            if not int(a.get("StateFlags", "4") or 4) & 4:      # 4 = totalmente instalado
                continue
            pasta = os.path.join(JOGOS, f"pc-steam-{appid}")
            vistos.add(os.path.basename(pasta))
            desc = "Steam · roda pelo Proton, direto na placa de vídeo (sem emulação). Do HD do Windows (" + \
                lib.get("origem", "") + ")."
            if not steam_ok:
                desc = "Instale a Steam pela SkyStore (Apps) para jogar. " + desc
            if lib.get("modo") == "ro":
                desc += " O HD está só leitura (Windows hibernado): a Steam pode não abrir o jogo."
            grava_jogo(pasta, {"title": nome, "type": "windows", "exec": f"{SKY_BIN}/sky-pc jogar steam {appid}",
                               "cover": "cover.jpg", "color": "#1b2838", "order": 50, "description": desc})
            cdn = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}"
            capa(os.path.join(pasta, "cover.jpg"), [cdn + "/library_600x900_2x.jpg", cdn + "/library_600x900.jpg",
                                                    cdn + "/header.jpg"])
            n += 1
    epic = est.get("epic", [])
    if heroic_ok and epic:
        ajustar_heroic(epic)
    if heroic_ok:
        controle_xinput_todos()
        restaurar_proton()
    inst = epic_instalados()
    for jg in epic:
        app = re.sub(r"[^A-Za-z0-9_-]", "", jg.get("appName", ""))
        if not app:
            continue
        if heroic_ok and epic_logado() and app not in inst and jg.get("modo") != "ro" \
                and not rodando("heroic"):
            importar_epic(app, jg["ponto"])
        pasta = os.path.join(JOGOS, f"pc-epic-{app}")
        vistos.add(os.path.basename(pasta))
        desc = "Epic Games · roda pelo Heroic (Wine/Proton), direto na placa de vídeo."
        if not heroic_ok:
            desc = "Instale o Heroic pela SkyStore (Apps) e entre na sua conta Epic para jogar. " + desc
        elif not epic_logado():
            desc = "Abra o Heroic (Apps) e entre na sua conta Epic: depois o jogo aparece lá e abre daqui. " + desc
        if heroic_ok and not rodando("wineserver"):
            for reg in prefixos_epic(app):
                controle_xinput(reg)
        titulo = (epic_instalados().get(app) or {}).get("title") or jg.get("titulo") or app
        grava_jogo(pasta, {"title": titulo, "type": "windows",
                           "exec": f"{SKY_BIN}/sky-pc jogar epic {app}", "cover": "cover.jpg", "color": "#2a2a2a",
                           "order": 51, "description": desc})
        lib = next((g for g in biblioteca_heroic("epic") if g.get("app_name") == app), {}) if heroic_ok else {}
        capa(os.path.join(pasta, "cover.jpg"), capas_epic(app) + [lib.get("art_square", ""), lib.get("art_cover", "")])
        n += 1
    # 13.32: jogos instalados pelo Heroic (pela SkyStore ou pelo próprio Heroic) que não vieram do Windows
    if heroic_ok:
        epic_lib = {g.get("app_name"): g for g in biblioteca_heroic("epic")}
        for app, info in epic_instalados().items():
            if f"pc-epic-{app}" in vistos or info.get("is_dlc") or not re.fullmatch(r"[A-Za-z0-9_-]+", app):
                continue
            pasta = os.path.join(JOGOS, f"pc-epic-{app}")
            vistos.add(os.path.basename(pasta))
            grava_jogo(pasta, {"title": info.get("title") or app, "type": "windows",
                               "exec": f"{SKY_BIN}/sky-pc jogar epic {app}", "cover": "cover.jpg", "color": "#2a2a2a",
                               "order": 51, "description": "Epic Games · instalado pelo Heroic, roda pelo Wine/Proton."})
            capa(os.path.join(pasta, "cover.jpg"), capas_epic(app) + [(epic_lib.get(app) or {}).get("art_square", "")])
            n += 1
        gog_lib = {str(g.get("app_name")): g for g in biblioteca_heroic("gog")}
        for info in gog_instalados():
            app = str(info.get("appName", ""))
            if info.get("is_dlc") or not app.isdigit():
                continue
            g = gog_lib.get(app) or {}
            pasta = os.path.join(JOGOS, f"pc-gog-{app}")
            vistos.add(os.path.basename(pasta))
            grava_jogo(pasta, {"title": g.get("title") or app, "type": "windows",
                               "exec": f"{SKY_BIN}/sky-pc jogar gog {app}", "cover": "cover.jpg", "color": "#5c2d91",
                               "order": 52, "description": "GOG · instalado pelo Heroic, roda pelo Wine/Proton."})
            capa(os.path.join(pasta, "cover.jpg"), [g.get("art_square", ""), g.get("art_cover", "")])
            if not rodando("wineserver"):
                for reg in prefixos_epic(app, g.get("title", "")):
                    controle_xinput(reg)
            n += 1
    apps_com_icone(steam_ok, heroic_ok)
    if fg_ler():
        try:
            gerar_conf_lsfg()
        except OSError:
            pass
    # jogo que sumiu (desinstalado no Windows ou no Heroic) sai do menu
    for p in glob.glob(os.path.join(JOGOS, "pc-steam-*")) + glob.glob(os.path.join(JOGOS, "pc-epic-*")) + \
            glob.glob(os.path.join(JOGOS, "pc-gog-*")):
        if os.path.basename(p) not in vistos:
            shutil.rmtree(p, ignore_errors=True)
    return saida({"ok": True, "jogos": n, "steam": steam_ok, "heroic": heroic_ok,
                  "bibliotecas": len(est.get("steam", [])) + len(est.get("epic", []))})


# ---------------------------------------------------------------- jogar

# ---------------------------------------------------------------- 13.32: biblioteca na SkyStore

GOG_INSTALADOS = os.path.join(HEROIC_CFG, "heroic/gog_store/installed.json")
CACHE_CAPAS = os.path.join(HOME, ".cache/skystation/loja-pc")
ICONES = "/var/lib/flatpak/exports/share/icons/hicolor"


def biblioteca_heroic(loja):
    """O que o Heroic já baixou da sua conta (store_cache): Epic em legendary_library.json, GOG em gog_library.json."""
    arq, chave = {"epic": ("legendary_library.json", "library"), "gog": ("gog_library.json", "games")}[loja]
    try:
        d = json.load(open(os.path.join(HEROIC_CFG, "heroic/store_cache", arq)))
        lista = d.get(chave) or []
        return [g for g in lista if isinstance(g, dict) and g.get("app_name")]
    except (OSError, ValueError, AttributeError):
        return []


def gog_instalados():
    try:
        d = json.load(open(GOG_INSTALADOS)).get("installed") or []
        return [g for g in d if isinstance(g, dict)]
    except (OSError, ValueError, AttributeError):
        return []


def pasta_epic_hd():
    """Onde instalar jogo novo: a pasta Epic Games do HD do Windows (já liberada para executar), se der para gravar."""
    for j in bibliotecas().get("epic", []):
        if j.get("mae") and j.get("modo") != "ro" and os.access(j["mae"], os.W_OK):
            return j["mae"]
    return ""


def _arq_capa(url):
    import hashlib
    return os.path.join(CACHE_CAPAS, hashlib.sha1(url.encode()).hexdigest()[:20] + ".jpg")


def baixar_capas(urls):
    """Roda separado (sky-pc capas): baixa as capas que faltam, uma por vez, sem segurar a loja."""
    os.makedirs(CACHE_CAPAS, exist_ok=True)
    trava = os.path.join(CACHE_CAPAS, ".baixando")
    try:
        if time.time() - os.path.getmtime(trava) < 600:
            return 0
    except OSError:
        pass
    open(trava, "w").close()
    try:
        for u in urls:
            dest = _arq_capa(u)
            if os.path.exists(dest):
                continue
            # capa pequena (a da Epic aceita ?h=, a da GOG já vem no tamanho de lista)
            capa(dest, [u + ("&" if "?" in u else "?") + "h=480&resize=1&w=360" if "epicgames" in u else u, u])
            os.utime(trava)
    finally:
        try:
            os.remove(trava)
        except OSError:
            pass
    return 0


# ---------------------------------------------------------------- 13.42: biblioteca da Steam

def _kv_binario(buf, pos, chaves):
    """KeyValues binário da Steam. chaves = tabela de strings (appinfo v29) ou None (chave inline)."""
    d = {}
    n = len(buf)
    while pos < n:
        t = buf[pos]
        pos += 1
        if t in (0x08, 0x0B):
            return d, pos
        if chaves is not None:
            k = chaves[struct.unpack_from("<i", buf, pos)[0]]
            pos += 4
        else:
            fim = buf.index(b"\0", pos)
            k = buf[pos:fim].decode("utf-8", "replace")
            pos = fim + 1
        if t == 0x00:
            v, pos = _kv_binario(buf, pos, chaves)
        elif t == 0x01:
            fim = buf.index(b"\0", pos)
            v = buf[pos:fim].decode("utf-8", "replace")
            pos = fim + 1
        elif t in (0x02, 0x04, 0x06):
            v = struct.unpack_from("<i", buf, pos)[0]
            pos += 4
        elif t == 0x03:
            v = struct.unpack_from("<f", buf, pos)[0]
            pos += 4
        elif t in (0x07, 0x0A):
            v = struct.unpack_from("<q", buf, pos)[0]
            pos += 8
        else:
            raise ValueError(f"tipo {t}")
        d[k] = v
    return d, pos


def appinfo_jogos(caminho, queremos=None):
    """{appid: {"nome", "tipo"}} do appinfo.vdf da Steam (versões 27, 28 e 29 do formato).
    queremos = conjunto de appids para ler só esses (o arquivo tem dezenas de milhares de apps)."""
    try:
        buf = open(caminho, "rb").read()
    except OSError:
        return {}
    if len(buf) < 8:
        return {}
    magic = struct.unpack_from("<I", buf, 0)[0]
    if magic not in (0x07564427, 0x07564428, 0x07564429):
        return {}
    pos, chaves = 8, None
    if magic == 0x07564429:
        off = struct.unpack_from("<q", buf, 8)[0]
        pos = 16
        qtd = struct.unpack_from("<I", buf, off)[0]
        chaves, p = [], off + 4
        for _ in range(qtd):
            fim = buf.index(b"\0", p)
            chaves.append(buf[p:fim].decode("utf-8", "replace"))
            p = fim + 1
    cab = 4 + 4 + 8 + 20 + 4 + (0 if magic == 0x07564427 else 20)
    out = {}
    while pos + 8 <= len(buf):
        appid, tam = struct.unpack_from("<II", buf, pos)
        if appid == 0:
            break
        ini = pos + 8
        pos = ini + tam
        if queremos is not None and appid not in queremos:
            continue
        try:
            kv, _ = _kv_binario(buf, ini + cab, chaves)
        except (ValueError, IndexError, struct.error):
            continue
        comum = (kv.get("appinfo") or {}).get("common") or {}
        if comum.get("name"):
            out[appid] = {"nome": comum["name"], "tipo": str(comum.get("type", "")).lower()}
    return out


def steam_capa_local(appid):
    base = os.path.join(STEAM_DIR, "appcache/librarycache")
    for padrao in (f"{appid}/library_600x900*.jpg", f"{appid}/*/library_600x900*.jpg", f"{appid}_library_600x900*.jpg"):
        achados = glob.glob(os.path.join(base, padrao))
        if achados:
            return sorted(achados)[0]
    return ""


def steam_biblioteca():
    """Os jogos da sua conta Steam: os que a Steam guardou na librarycache (biblioteca) + os instalados,
    com nome e tipo pelo appinfo.vdf. Precisa ter aberto a Steam logado ao menos uma vez."""
    ids = set()
    base = os.path.join(STEAM_DIR, "appcache/librarycache")
    for n in os.listdir(base) if os.path.isdir(base) else []:
        m = re.match(r"^(\d+)", n)
        if m:
            ids.add(int(m.group(1)))
    inst = {}
    for lib in bibliotecas().get("steam", []) + [{"ponto": STEAM_DIR}]:
        for mf in glob.glob(os.path.join(lib["ponto"], "steamapps/appmanifest_*.acf")):
            a = acf(mf)
            if str(a.get("appid", "")).isdigit():
                inst[int(a["appid"])] = a.get("name", "")
                ids.add(int(a["appid"]))
    info = appinfo_jogos(os.path.join(STEAM_DIR, "appcache/appinfo.vdf"), ids)
    jogos = []
    for i in sorted(ids):
        dado = info.get(i, {})
        nome = dado.get("nome") or inst.get(i, "")
        tipo = dado.get("tipo", "game" if i in inst else "")
        if not nome or (tipo and tipo not in ("game", "demo")) or NAO_JOGO.search(nome):
            continue
        if not tipo and i not in inst:
            continue
        jogos.append({"appid": i, "nome": nome, "instalado": i in inst, "capa": steam_capa_local(i)})
    return jogos


def loja():
    """Itens da SkyStore (aba PC): sua biblioteca da Epic e da GOG (pelo Heroic) e os jogos da Steam no HD."""
    itens, faltam = [], []
    heroic_ok, steam_ok = flatpak_tem(HEROIC_ID), flatpak_tem(STEAM_ID)
    inst_epic = epic_instalados()
    inst_gog = {str(g.get("appName")) for g in gog_instalados() if not g.get("is_dlc")}
    no_menu = {os.path.basename(p) for p in glob.glob(os.path.join(JOGOS, "pc-*"))}
    destino = pasta_epic_hd()

    def item(loja_, app, titulo, url, instalado, acoes, resumo, extra=""):
        local = _arq_capa(url) if url else ""
        if url and not os.path.exists(local):
            faltam.append(url)
            local = ""
        return {"slug": f"pc-{loja_}-{app}", "nome": titulo, "tipo": "pc", "loja_pc": loja_, "resumo": resumo,
                "descricao": resumo + extra, "autor": {"epic": "Epic Games", "gog": "GOG", "steam": "Steam"}[loja_],
                "oficial": False, "sistema": True, "instalavel": True, "instalado": "sim" if instalado else None,
                "atualizar": False, "versao": {"versao": "", "tamanho": 0}, "capa_local": local, "acoes": acoes,
                "pasta_jogo": os.path.join(JOGOS, f"pc-{loja_}-{app}") if f"pc-{loja_}-{app}" in no_menu else ""}

    for g in biblioteca_heroic("epic"):
        app = str(g["app_name"])
        if not re.fullmatch(r"[A-Za-z0-9_-]+", app) or (g.get("install") or {}).get("is_dlc"):
            continue
        tem = app in inst_epic or f"pc-epic-{app}" in no_menu
        terceiro = g.get("thirdPartyManagedApp") or ("EA app" if g.get("isEAManaged") else "")
        if tem:
            acoes = [["Jogar", "abrir"]]
        elif terceiro:
            acoes = [["Instalar pelo Heroic", "baixar"]]
        else:
            acoes = [["Instalar no HD", "baixar"]]
        extra = ""
        if not tem and not terceiro:
            extra = ("\n\nVai para " + destino.replace("/mnt/pc/", "a pasta Epic Games do HD (") + ")."
                     if destino else "\n\nSem pasta da Epic com gravação no HD: vai para a pasta padrão do Heroic.")
        if terceiro:
            extra = f"\n\nEste jogo precisa do {terceiro}: o Heroic abre para você confirmar a instalação."
        itens.append(item("epic", app, g.get("title") or app, g.get("art_square") or g.get("art_cover", ""), tem,
                          acoes, "Na sua biblioteca da Epic Games.", extra))
    for g in biblioteca_heroic("gog"):
        app = str(g["app_name"])
        if not app.isdigit() or (g.get("install") or {}).get("is_dlc"):
            continue
        tem = app in inst_gog
        acoes = [["Jogar", "abrir"]] if tem else [["Instalar pelo Heroic", "baixar"]]
        itens.append(item("gog", app, g.get("title") or app, g.get("art_square") or g.get("art_cover", ""), tem, acoes,
                          "Na sua biblioteca da GOG.",
                          "" if tem else "\n\nO Heroic abre direto na instalação deste jogo: confirme a pasta lá."))
    vistos_steam = set()
    for jg in steam_biblioteca() if steam_ok else []:
        appid = str(jg["appid"])
        vistos_steam.add(appid)
        tem = jg["instalado"] or f"pc-steam-{appid}" in no_menu
        cdn = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}/library_600x900.jpg"
        it = item("steam", appid, jg["nome"], "" if jg["capa"] else cdn, tem,
                  [["Jogar", "abrir"]] if tem else [["Instalar pela Steam", "baixar"]],
                  "Na sua biblioteca da Steam." if not tem else "Instalado na sua biblioteca da Steam.",
                  "" if tem else "\n\nA Steam abre a tela de instalação: escolha a biblioteca do HD (Windows) para "
                                 "o jogo também aparecer lá.")
        if jg["capa"]:
            it["capa_local"] = jg["capa"]
        itens.append(it)
    for p in sorted(glob.glob(os.path.join(JOGOS, "pc-steam-*"))):   # instalados que a biblioteca não listou
        appid = os.path.basename(p)[len("pc-steam-"):]
        if appid in vistos_steam:
            continue
        try:
            titulo = json.load(open(os.path.join(p, "game.json"))).get("title", appid)
        except (OSError, ValueError):
            titulo = appid
        it = item("steam", appid, titulo, "", True, [["Jogar", "abrir"]], "Instalado na sua biblioteca da Steam.")
        it["capa_local"] = os.path.join(p, "cover.jpg") if os.path.exists(os.path.join(p, "cover.jpg")) else ""
        itens.append(it)
    if faltam:
        subprocess.Popen([os.path.abspath(__file__), "capas"] + faltam[:400], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    aviso = ""
    if steam_ok and not any(i["loja_pc"] == "steam" for i in itens):
        aviso = "Abra a Steam pelo menu e entre na sua conta: a biblioteca aparece aqui depois."
    if not heroic_ok and not steam_ok:
        aviso = "Instale a Steam ou o Heroic (aba Apps) para ver sua biblioteca de PC aqui."
    elif not itens:
        aviso = "Abra o Heroic, entre nas contas Epic e GOG e espere a biblioteca carregar: ela aparece aqui."
    return {"ok": True, "itens": itens, "aviso": aviso, "steam": steam_ok, "heroic": heroic_ok}


def _linha(d):
    print(json.dumps(d, ensure_ascii=False), flush=True)


def instalar_loja(loja_, app):
    """SkyStore → instala. Epic: o legendary do Heroic baixa direto no HD (com progresso na loja).
    GOG e Epic de terceiros (EA/Ubisoft): o Heroic abre na tela de instalação do jogo (um clique para confirmar)."""
    if loja_ == "steam":
        if not flatpak_tem(STEAM_ID):
            return {"ok": False, "error": "Instale a Steam pela SkyStore (aba Apps)."}
        ajustar_steam(bibliotecas().get("steam", []))
        subprocess.Popen(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-gamepadui",
                          f"steam://install/{app}"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return {"ok": True, "message": "A Steam abriu na instalação: confirme lá. Quando terminar, o jogo aparece em PC."}
    if not flatpak_tem(HEROIC_ID):
        return {"ok": False, "error": "Instale o Heroic pela SkyStore (aba Apps)."}
    g = next((x for x in biblioteca_heroic(loja_) if str(x.get("app_name")) == app), None)
    if g is None:
        return {"ok": False, "error": "Esse jogo não está na biblioteca que o Heroic baixou. Abra o Heroic e atualize."}
    terceiro = g.get("thirdPartyManagedApp") or g.get("isEAManaged")
    if loja_ == "gog" or terceiro:
        runner = "gog" if loja_ == "gog" else "legendary"
        subprocess.Popen(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID,
                          f"heroic://launch?appName={app}&runner={runner}"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return {"ok": True, "message": "O Heroic abriu: confirme a instalação lá. Quando terminar, o jogo aparece em PC."}
    if not epic_logado():
        return {"ok": False, "error": "Entre na conta Epic no Heroic (aba Apps) primeiro."}
    if rodando("legendary"):
        return {"ok": False, "error": "Já tem um download da Epic em andamento. Espere terminar."}
    destino = pasta_epic_hd()
    if not destino:
        try:
            destino = json.load(open(os.path.join(HEROIC_CFG, "heroic/config.json")))["defaultSettings"]["defaultInstallPath"]
        except (OSError, ValueError, KeyError, TypeError):
            destino = os.path.join(HOME, "Games/Heroic")
    _linha({"etapa": "Preparando o download"})
    script = ('export LEGENDARY_CONFIG_PATH="$XDG_CONFIG_HOME/heroic/legendaryConfig/legendary"; '
              'L="$(find /app -name legendary -type f -perm -u+x 2>/dev/null | head -1)"; '
              '[ -n "$L" ] || { echo "legendary não encontrado" >&2; exit 9; }; '
              'exec "$L" -y install "$0" --base-path "$1" --platform Windows --skip-sdl')
    os.makedirs(os.path.join(HOME, ".local/state/skystation"), exist_ok=True)
    log = open(os.path.join(HOME, ".local/state/skystation/pc-epic.log"), "a")
    log.write(f"--- instalar {app} em {destino} {time.ctime()}\n")
    proc = subprocess.Popen(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--command=sh", HEROIC_ID, "-c", script,
                             app, destino], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, bufsize=1)
    pr = re.compile(r"Progress:\s*([\d.]+)%.*?ETA:\s*([\d:]+)")
    tam = re.compile(r"Download size:\s*([\d.]+ \w+)")
    ult, total = -1.0, ""
    for l in proc.stdout:
        log.write(l)
        m = tam.search(l)
        if m:
            total = m.group(1)
        m = pr.search(l)
        if m:
            p = float(m.group(1))
            if p - ult >= 0.5:
                ult = p
                _linha({"etapa": f"Baixando {total}  ·  falta {m.group(2)}".strip(), "p": round(p / 100, 3)})
        elif "Verifying" in l or "verif" in l.lower():
            _linha({"etapa": "Conferindo os arquivos"})
    rc = proc.wait()
    log.close()
    if rc != 0 or app not in epic_instalados():
        return {"ok": False, "error": "O download parou. Veja se o HD tem espaço e se a internet está ok; dá para "
                                      "tentar de novo que ele continua de onde parou."}
    sincronizar_silencioso()
    return {"ok": True, "message": f"{g.get('title', app)} instalado! Está na categoria PC."}


def sincronizar_silencioso():
    import io
    import contextlib
    with contextlib.redirect_stdout(io.StringIO()):
        sincronizar()


def apps_com_icone(steam_ok, heroic_ok):
    """Steam e Heroic no menu com o ícone oficial de cada app (o que o próprio Flatpak instala), por cima
    da capa genérica que vem com o sistema. Sem o app instalado, fica a capa genérica."""
    for ident, pasta_id, ok, cor in ((STEAM_ID, "steam", steam_ok, "0x1b2838"), (HEROIC_ID, "heroic", heroic_ok, "0x1d1d2b")):
        destino = os.path.join(JOGOS, pasta_id)
        base = os.path.join("/opt/skystation/games", pasta_id, "game.json")
        if not ok or not os.path.exists(base) or not shutil.which("ffmpeg"):
            if not ok and os.path.isdir(destino):
                shutil.rmtree(destino, ignore_errors=True)
            continue
        icone = next((p for t in ("512x512", "256x256", "128x128")
                      for p in [os.path.join(ICONES, t, "apps", ident + ".png")] if os.path.exists(p)), "")
        if not icone:
            continue
        os.makedirs(destino, exist_ok=True)
        capa_ = os.path.join(destino, "cover.png")
        if not os.path.exists(capa_) or os.path.getmtime(capa_) < os.path.getmtime(icone):
            subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", icone, "-vf",
                            f"scale=320:320,pad=600:900:(ow-iw)/2:(oh-ih)/2:color={cor}", capa_],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            d = json.load(open(base))
        except (OSError, ValueError):
            continue
        d["cover"] = "cover.png"
        grava_jogo(destino, d)


def fechar_steam():
    """A Steam aberta (mesmo minimizada) assume o DualShock pelo Steam Input: no jogo do Heroic sobra só
    o touchpad como mouse. Antes de um jogo da Epic/GOG, a Steam é fechada do jeito certo (-shutdown)."""
    if not rodando("steamwebhelper|ubuntu12_32/steam|/app/bin/steam"):
        return
    subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-shutdown"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    for _ in range(20):
        if not rodando("steamwebhelper|ubuntu12_32/steam"):
            return
        time.sleep(1)
    subprocess.run(["flatpak", "kill", STEAM_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def protons_ge():
    base = os.path.join(HEROIC_CFG, "heroic/tools/proton")
    achados = [d for d in glob.glob(os.path.join(base, "GE-Proton*")) if os.path.isfile(os.path.join(d, "proton"))]
    def chave(d):
        return [int(x) for x in re.findall(r"\d+", os.path.basename(d))]
    return sorted(achados, key=chave)


def trocar_cachyos():
    """Proton-CachyOS quebra o controle em jogo (relatos de 2025-2026); o GE-Proton e o da Valve não.
    Se houver um GE-Proton baixado pelo Heroic (Gerenciador de Wine), ele passa a ser o padrão no lugar
    do CachyOS, na config global e nos jogos que estavam com o CachyOS. Só com o Heroic fechado."""
    ge = protons_ge()
    if not ge or rodando("heroic"):
        return ""
    novo = {"bin": os.path.join(ge[-1], "proton"), "name": "Proton - " + os.path.basename(ge[-1]), "type": "proton"}

    def ruim(v):
        return isinstance(v, dict) and "cachyos" in str(v.get("name", "")).lower()
    cfg = os.path.join(HEROIC_CFG, "heroic/config.json")
    try:
        c = json.load(open(cfg))
        ds = c.setdefault("defaultSettings", {})
        if ruim(ds.get("wineVersion")) or not ds.get("wineVersion"):
            ds["wineVersion"] = novo
            with open(cfg + ".tmp", "w") as f:
                json.dump(c, f, indent=2)
            os.replace(cfg + ".tmp", cfg)
    except (OSError, ValueError, AttributeError):
        pass
    for f in glob.glob(os.path.join(HEROIC_CFG, "heroic/GamesConfig/*.json")):
        try:
            c = json.load(open(f))
            mudou = False
            for v in c.values():
                if isinstance(v, dict) and ruim(v.get("wineVersion")):
                    v["wineVersion"] = novo
                    mudou = True
            if mudou:
                with open(f + ".tmp", "w") as fh:
                    json.dump(c, fh, indent=2)
                os.replace(f + ".tmp", f)
        except (OSError, ValueError, AttributeError):
            continue
    return novo["name"]


def restaurar_proton():
    """13.37: desfaz a troca da 13.34. Com o GE-Proton no lugar do CachyOS os jogos ficaram presos no
    "carregando" do Heroic (o prefixo 'shared' foi criado pelo CachyOS). Volta, uma vez só, para o Proton
    CachyOS que o Heroic tem baixado, no padrão e nos jogos; depois disso a escolha no Heroic é respeitada."""
    marca = os.path.join(HOME, ".local/state/skystation/proton-restaurado")
    if os.path.exists(marca) or rodando("heroic"):
        return ""
    bases = [os.path.join(HEROIC_CFG, "heroic/tools/proton"),
             os.path.join(HOME, ".var/app", STEAM_ID, ".local/share/Steam/compatibilitytools.d"),
             os.path.join(HOME, ".local/share/Steam/compatibilitytools.d"), os.path.join(HOME, ".steam/root/compatibilitytools.d"),
             "/usr/share/steam/compatibilitytools.d"]
    cachy = sorted(d for b in bases for d in glob.glob(os.path.join(b, "*"))
                   if "cachy" in os.path.basename(d).lower() and os.path.isfile(os.path.join(d, "proton")))
    if not cachy:
        return ""
    # o "latest" tem preferência (é o que estava configurado antes)
    escolhido = next((d for d in cachy if "latest" in os.path.basename(d).lower()), cachy[-1])
    volta = {"bin": os.path.join(escolhido, "proton"), "name": "Proton - " + os.path.basename(escolhido), "type": "proton"}

    def foi_trocado(v):
        return isinstance(v, dict) and str(v.get("name", "")).startswith("Proton - GE-Proton")
    cfg = os.path.join(HEROIC_CFG, "heroic/config.json")
    try:
        c = json.load(open(cfg))
        ds = c.setdefault("defaultSettings", {})
        if foi_trocado(ds.get("wineVersion")):
            ds["wineVersion"] = volta
            with open(cfg + ".tmp", "w") as f:
                json.dump(c, f, indent=2)
            os.replace(cfg + ".tmp", cfg)
    except (OSError, ValueError, AttributeError):
        return ""
    for f in glob.glob(os.path.join(HEROIC_CFG, "heroic/GamesConfig/*.json")):
        try:
            c = json.load(open(f))
            mudou = False
            for v in c.values():
                if isinstance(v, dict) and foi_trocado(v.get("wineVersion")):
                    v["wineVersion"] = volta
                    mudou = True
            if mudou:
                with open(f + ".tmp", "w") as fh:
                    json.dump(c, fh, indent=2)
                os.replace(f + ".tmp", f)
        except (OSError, ValueError, AttributeError):
            continue
    os.makedirs(os.path.dirname(marca), exist_ok=True)
    open(marca, "w").write(volta["name"] + "\n")
    return volta["name"]


def antes_do_jogo_heroic():
    fechar_steam()
    # Heroic aberto regravaria a config por cima: fecha antes (se não estiver baixando nada)
    if rodando("/app/bin/heroic|heroic/heroic ") and not rodando("legendary|gogdl"):
        subprocess.run(["flatpak", "kill", HEROIC_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2)
    restaurar_proton()
    controle_xinput_todos()


def rodar_heroic_com_xpad(url):
    """13.35: o jogo do Heroic recebe um controle de Xbox 360 virtual (sky-xpad) no lugar do DualShock,
    que fica escondido do jogo (SDL_GAMECONTROLLER_IGNORE_DEVICES). O espelho vive enquanto o jogo roda."""
    xpad = os.path.join(SKY_BIN, "sky-xpad")
    env_args = []
    proc_x = None
    if os.access("/dev/uinput", os.W_OK) and os.path.exists(xpad):
        ign = subprocess.run([xpad, "ignorar"], capture_output=True, text=True).stdout.strip()
        os.makedirs(os.path.join(HOME, ".local/state/skystation"), exist_ok=True)
        log = open(os.path.join(HOME, ".local/state/skystation/sky-xpad.log"), "a")
        proc_x = subprocess.Popen([xpad], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                                  env={**os.environ, "SKY_XPAD_PAI": str(os.getpid())})
        # "Fechar jogo" no menu Home manda SIGTERM: sai pelo finally e desliga o espelho
        signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
        if ign:
            env_args = [f"--env=SDL_GAMECONTROLLER_IGNORE_DEVICES={ign}", "--env=SDL_JOYSTICK_HIDAPI=0"]
    # Heroic já aberto não pegaria as variáveis novas: fecha (se não estiver baixando nada)
    if rodando("/app/bin/heroic|heroic/heroic ") and not rodando("legendary|gogdl"):
        subprocess.run(["flatpak", "kill", HEROIC_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2)
    inicio = time.time()
    try:
        r = subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--unset-env=SDL_VIDEODRIVER"] + env_args +
                           [HEROIC_ID, "--no-gui", url])
        # o Heroic pode devolver antes do jogo acabar: espera o Wine terminar
        while time.time() - inicio < 60 or rodando("wineserver"):
            if time.time() - inicio >= 60 and not rodando("wineserver"):
                break
            time.sleep(2)
        return r.returncode
    finally:
        if proc_x:
            proc_x.terminate()
            try:
                proc_x.wait(5)
            except subprocess.TimeoutExpired:
                proc_x.kill()


def jogar_gog(app):
    if not flatpak_tem(HEROIC_ID):
        return falha("Instale o Heroic pela SkyStore (aba Apps).")
    antes_do_jogo_heroic()
    return rodar_heroic_com_xpad(f"heroic://launch?appName={app}&runner=gog&gui=false")


def jogar_steam(appid):
    if not flatpak_tem(STEAM_ID):
        return falha("Instale a Steam pela SkyStore (aba Apps) para jogar os jogos de PC.")
    ajustar_steam(bibliotecas().get("steam", []))
    # -gamepadui: a interface de TV da Steam (a mesma do Steam Deck). Na 1ª vez ela pede o login
    # (dá para entrar pelo QR code com o app da Steam no celular). Para voltar ao SkyStation: Home → Fechar.
    os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-gamepadui", f"steam://rungameid/{appid}"])


def jogar_epic(app):
    if not flatpak_tem(HEROIC_ID):
        return falha("Instale o Heroic pela SkyStore (aba Apps) e entre na sua conta Epic.")
    if not epic_logado():
        # 1ª vez: abre o Heroic para entrar na conta Epic; o SkyStation importa os jogos do HD quando ele fechar
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID])
    if app not in epic_instalados():
        jg = next((j for j in bibliotecas().get("epic", []) if j.get("appName") == app), None)
        if jg and not importar_epic(app, jg["ponto"]):
            return falha("Não consegui importar o jogo do HD no Heroic. Abra o Heroic (Apps) e confira a conta Epic.")
    antes_do_jogo_heroic()
    return rodar_heroic_com_xpad(f"heroic://launch?appName={app}&runner=legendary&gui=false")


def epic_logado():
    return os.path.exists(os.path.join(LEGENDARY, "user.json"))


def epic_instalados():
    try:
        d = json.load(open(os.path.join(LEGENDARY, "installed.json")))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def capas_epic(app):
    """A capa vertical da loja (DieselGameBoxTall), do metadata que o legendary baixou ao entrar na conta."""
    try:
        imgs = json.load(open(os.path.join(LEGENDARY, "metadata", app + ".json")))["metadata"]["keyImages"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    ordem = ["DieselGameBoxTall", "OfferImageTall", "DieselGameBox"]
    return [i["url"] for t in ordem for i in imgs if i.get("type") == t and i.get("url")]


def ajustar_heroic(epic):
    """Jogo novo instalado pelo Heroic vai para a mesma pasta Epic do HD (com exec) em vez do pendrive."""
    mae = next((j.get("mae") for j in epic if j.get("mae") and j.get("modo") != "ro"), "")
    cfg = os.path.join(HEROIC_CFG, "heroic/config.json")
    if not mae or not os.path.exists(cfg) or rodando("heroic"):
        return
    try:
        c = json.load(open(cfg))
        ds = c.setdefault("defaultSettings", {})
        if ds.get("defaultInstallPath") == mae:
            return
        ds["defaultInstallPath"] = mae
        with open(cfg + ".tmp", "w") as f:
            json.dump(c, f, indent=2)
        os.replace(cfg + ".tmp", cfg)
    except (OSError, ValueError, AttributeError):
        pass


WINEBUS = "System\\\\CurrentControlSet\\\\Services\\\\winebus"
WINEBUS_VALORES = {"DisableHidraw": "dword:00000001", "Enable SDL": "dword:00000001"}


def prefixos_epic(app, titulo=""):
    """Os "Windows de mentira" (prefixos do Wine/Proton) que o Heroic usa para o jogo (Epic ou GOG)."""
    cand = []
    try:
        c = json.load(open(os.path.join(HEROIC_CFG, "heroic/GamesConfig", app + ".json")))
        pref = (c.get(app) or {}).get("winePrefix")
        if pref:
            cand.append(pref.replace("~", HOME, 1))
    except (OSError, ValueError, AttributeError):
        pass
    titulo = titulo or (epic_instalados().get(app) or {}).get("title", "")
    for base in (os.path.join(HOME, "Games/Heroic/Prefixes/default"), os.path.join(HOME, "Games/Heroic/Prefixes")):
        if titulo:
            cand.append(os.path.join(base, titulo))
    out = []
    for c in cand:
        for reg in (os.path.join(c, "system.reg"), os.path.join(c, "pfx/system.reg")):
            if os.path.isfile(reg) and reg not in out:
                out.append(reg)
    return out


def prefixos_heroic():
    """13.33: todos os prefixos do Heroic (Epic e GOG), sem depender do nome do jogo. O Heroic dá à pasta o
    título da loja dele ("Death Stranding (Boga)", com ou sem a subpasta default/), que não bate com o do
    legendary. Junta: o winePrefix de cada GamesConfig/*.json, a pasta padrão da config global e
    ~/Games/Heroic/Prefixes, procurando system.reg (Wine) ou pfx/system.reg (Proton) até 3 níveis abaixo."""
    bases = {os.path.join(HOME, "Games/Heroic/Prefixes")}
    diretos = set()
    try:
        ds = json.load(open(os.path.join(HEROIC_CFG, "heroic/config.json"))).get("defaultSettings", {})
        for k in ("defaultWinePrefix", "winePrefix"):
            if ds.get(k):
                bases.add(str(ds[k]).replace("~", HOME, 1))
    except (OSError, ValueError, AttributeError):
        pass
    for f in glob.glob(os.path.join(HEROIC_CFG, "heroic/GamesConfig/*.json")):
        try:
            for v in json.load(open(f)).values():
                if isinstance(v, dict) and v.get("winePrefix"):
                    diretos.add(str(v["winePrefix"]).replace("~", HOME, 1))
        except (OSError, ValueError, AttributeError):
            continue
    regs = set()
    for d in diretos:
        for r in (os.path.join(d, "system.reg"), os.path.join(d, "pfx/system.reg")):
            if os.path.isfile(r):
                regs.add(r)
    for b in bases:
        if not os.path.isdir(b):
            continue
        for raiz, pastas, arqs in os.walk(b):
            nivel = raiz[len(b):].count(os.sep)
            if "system.reg" in arqs:
                regs.add(os.path.join(raiz, "system.reg"))
            if nivel >= 3 or "drive_c" in pastas:
                pastas[:] = [x for x in pastas if x == "pfx"] if nivel < 3 else []
    return sorted(regs)


def controle_xinput_todos():
    if rodando("wineserver"):
        return 0
    n = 0
    for reg in prefixos_heroic():
        controle_xinput(reg)
        n += 1
    return n


def controle_xinput(reg):
    """DualShock/DualSense como controle de Xbox (XInput) para o jogo.

    Por padrão o Wine passa o controle da Sony "cru" (hidraw): só funciona em jogo que fala direto com o
    DualShock. O resto (ex.: Death Stranding da Epic) não vê botão nenhum, só o touchpad (que vira mouse).
    Com DisableHidraw o Wine usa o SDL, que traduz qualquer controle para XInput, o que todo jogo de PC entende.
    Edita o system.reg (texto) com o jogo fechado."""
    try:
        txt = open(reg, encoding="utf-8", errors="surrogateescape").read()
    except OSError:
        return
    sec = "[" + WINEBUS + "]"
    linhas = txt.split("\n")
    i = next((k for k, l in enumerate(linhas) if l.startswith(sec)), None)
    if i is None:
        bloco = [f"{sec} {int(time.time())}"] + [f'"{k}"={v}' for k, v in WINEBUS_VALORES.items()] + [""]
        linhas = linhas[:-1] + [""] + bloco + linhas[-1:] if linhas and linhas[-1] == "" else linhas + [""] + bloco
    else:
        fim = next((k for k in range(i + 1, len(linhas)) if linhas[k].startswith("[")), len(linhas))
        corpo = [l for l in linhas[i + 1:fim] if not any(l.startswith(f'"{k}"=') for k in WINEBUS_VALORES)]
        while corpo and corpo[-1] == "":
            corpo.pop()
        corpo += [f'"{k}"={v}' for k, v in WINEBUS_VALORES.items()] + [""]
        linhas = linhas[:i + 1] + corpo + linhas[fim:]
    novo = "\n".join(linhas)
    if novo != txt:
        with open(reg + ".tmp", "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(novo)
        os.replace(reg + ".tmp", reg)


def importar_epic(app, pasta):
    """O jogo já está no HD: o legendary (o "motor" da Epic dentro do Heroic) só anota onde ele está.
    Precisa da conta Epic conectada no Heroic (ele confere o jogo na sua biblioteca)."""
    script = ('export LEGENDARY_CONFIG_PATH="$XDG_CONFIG_HOME/heroic/legendaryConfig/legendary"; '
              'L="$(find /app -name legendary -type f -perm -u+x 2>/dev/null | head -1)"; '
              '[ -n "$L" ] && exec "$L" -y import --with-dlcs "$0" "$1"')
    try:
        r = subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--command=sh", HEROIC_ID, "-c", script, app, pasta],
                           capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
        os.makedirs(os.path.join(HOME, ".local/state/skystation"), exist_ok=True)
        with open(os.path.join(HOME, ".local/state/skystation/pc-epic.log"), "a") as f:
            f.write(f"--- import {app} {pasta} rc={r.returncode}\n{r.stdout[-2000:]}{r.stderr[-2000:]}\n")
        return r.returncode == 0 and app in epic_instalados()
    except (OSError, subprocess.SubprocessError):
        return False


def diag():
    """Relatório do controle nos jogos de PC: na tela e num arquivo no HD (dá para ler pelo Windows)."""
    out = []
    p = out.append
    p("== SkyStation: diagnóstico do controle nos jogos de PC (" + time.strftime("%d/%m %H:%M") + ")")
    p("-- controles que o Linux vê")
    try:
        blocos = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        blocos = []
    for b in blocos:
        nome = re.search(r'N: Name="([^"]*)"', b)
        hand = re.search(r"H: Handlers=(.*)", b)
        if nome and re.search(r"controller|gamepad|joystick|wireless|xbox|dualsense|dualshock|8bitdo", nome.group(1), re.I):
            p(f"   {nome.group(1)}  [{hand.group(1).strip() if hand else ''}]")
    for d in sorted(glob.glob("/dev/hidraw*")) + ["/dev/uinput"]:
        p(f"   {d}: {'pode ler' if os.access(d, os.R_OK | os.W_OK) else 'SEM ACESSO'}")
    p("-- dentro do Heroic (Flatpak)")
    if flatpak_tem(HEROIC_ID):
        try:
            r = subprocess.run(["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", "--command=sh", HEROIC_ID, "-c",
                                "ls /dev/input 2>&1 | tr '\\n' ' '; echo; ls -d /run/udev/data 2>&1; "
                                "ls /dev/hidraw* 2>&1 | tr '\\n' ' '"],
                               capture_output=True, text=True, timeout=60)
            for l in (r.stdout + r.stderr).strip().split("\n"):
                if not re.search(r"gamemode|D-Bus|dbus|backtrace|^\s*$", l, re.I):
                    p("   " + l[:200])
        except (OSError, subprocess.SubprocessError) as e:
            p(f"   erro: {e}")
        try:
            p("   overrides: " + subprocess.run(["flatpak", "override", "--show", HEROIC_ID], capture_output=True,
                                                 text=True, timeout=20).stdout.replace("\n", " ")[:300])
        except (OSError, subprocess.SubprocessError):
            pass
    else:
        p("   Heroic não instalado")
    p("-- Proton do Heroic e Steam")
    try:
        wv = json.load(open(os.path.join(HEROIC_CFG, "heroic/config.json"))).get("defaultSettings", {}).get("wineVersion", {})
        p(f"   padrão do Heroic: {wv.get('name', '?')}" + ("   <- CachyOS quebra o controle" if "cachyos" in str(wv).lower() else ""))
    except (OSError, ValueError, AttributeError):
        p("   padrão do Heroic: ?")
    ge = protons_ge()
    p("   GE-Proton baixado: " + (", ".join(os.path.basename(x) for x in ge) if ge else "nenhum (baixe no Gerenciador de Wine do Heroic)"))
    p("   Steam aberta agora: " + ("SIM (assume o controle; o SkyStation fecha antes do jogo)" if rodando("steamwebhelper|ubuntu12_32/steam") else "não"))
    p("-- prefixos do Heroic e o ajuste do controle (DisableHidraw=1 é o certo)")
    for reg in prefixos_heroic():
        try:
            txt = open(reg, encoding="utf-8", errors="replace").read()
            i = txt.find("[" + WINEBUS + "]")
            sec = txt[i:].split("\n\n")[0].split("\n", 1)[-1].replace("\n", " ") if i >= 0 else "SEM a seção winebus"
        except OSError as e:
            sec = str(e)
        p(f"   {reg.replace(HOME, '~')}")
        p(f"     {sec[:200]}")
    p("-- jogos da Epic")
    for app, info in epic_instalados().items():
        regs = prefixos_epic(app)
        p(f"   {info.get('title', app)} ({app}): {len(regs)} prefixo(s)")
        for reg in regs:
            try:
                txt = open(reg, encoding="utf-8", errors="replace").read()
                i = txt.find("[" + WINEBUS + "]")
                sec = txt[i:].split("\n\n")[0].replace("\n", " | ") if i >= 0 else "SEM a seção winebus"
            except OSError as e:
                sec = str(e)
            p(f"     {reg}")
            p(f"       {sec[:300]}")
        try:
            c = json.load(open(os.path.join(HEROIC_CFG, "heroic/GamesConfig", app + ".json"))).get(app, {})
            p(f"     wine: {(c.get('wineVersion') or {}).get('name', '?')}  prefixo: {c.get('winePrefix', '?')}")
        except (OSError, ValueError, AttributeError):
            p("     (sem configuração própria no Heroic)")
    p("-- geração de quadros (lsfg-vk / Lossless Scaling)")
    p("   camada instalada: " + ("sim" if lsfg_instalado() else "não (SkyStore, aba Apps)"))
    p("   Lossless.dll: " + (lossless_dll() or "não achado (baixe o Lossless Scaling na Steam)"))
    for gid, c in sorted(fg_ler().items()):
        p(f"   {c.get('titulo', gid)}: {c.get('mult')}x  exes: {', '.join(exes_do_jogo(gid)[:5]) or 'NENHUM'}")
    p("-- controle de Xbox 360 virtual (sky-xpad)")
    try:
        ign = subprocess.run([os.path.join(SKY_BIN, "sky-xpad"), "ignorar"], capture_output=True, text=True,
                             timeout=10).stdout.strip()
        p("   controles que viram Xbox 360 no jogo: " + (ign or "nenhum"))
    except (OSError, subprocess.SubprocessError):
        p("   sky-xpad não encontrado")
    try:
        p("   " + " | ".join(open(os.path.join(HOME, ".local/state/skystation/sky-xpad.log")).read().strip().split("\n")[-3:]))
    except OSError:
        p("   (ainda não rodou: abra um jogo da Epic/GOG pelo menu)")
    p("-- último log de jogo do Heroic (linhas sobre controle)")
    estado = os.path.join(HOME, ".var/app", HEROIC_ID, ".local/state/Heroic/logs/games")
    logs = glob.glob(os.path.join(estado, "*/launch*.log")) + glob.glob(os.path.join(HEROIC_CFG, "heroic/GamesConfig/*lastPlay*.log"))
    logs = sorted(logs, key=os.path.getmtime)
    if logs:
        p("   " + logs[-1])
        try:
            linhas = open(logs[-1], errors="replace").read().split("\n")
        except OSError:
            linhas = []
        chave = re.compile(r"winebus|hidraw|sdl|xinput|dinput|joystick|controller|gamepad|steam_input|umu|wine version|"
                           r"launch command|err:|fixme:hid|IGNORE_DEVICES", re.I)
        sel = [l for l in linhas if chave.search(l)][-25:]
        for l in sel:
            p("   " + l.strip()[:200])
    else:
        p("   nenhum log de jogo")
    texto = "\n".join(out) + "\n"
    print(texto)
    if logs:   # no arquivo vai o fim inteiro do log do jogo (para ler pelo Windows)
        try:
            ult = open(logs[-1], errors="replace").read().split("\n")[-250:]
            texto += "\n== fim do log do jogo: " + logs[-1] + "\n" + "\n".join(ult) + "\n"
        except OSError:
            pass
    try:
        texto += "\n== sky-xpad.log\n" + "\n".join(
            open(os.path.join(HOME, ".local/state/skystation/sky-xpad.log")).read().split("\n")[-30:]) + "\n"
    except OSError:
        pass
    for destino in ("/mnt/skyroms/skystation-diag-pc.txt", os.path.join(HOME, "skystation/diag-pc.txt")):
        try:
            with open(destino, "w") as f:
                f.write(texto)
            print("Salvo em " + destino)
        except OSError:
            pass
    return 0


# ---------------------------------------------------------------- 13.38: geração de quadros (Lossless Scaling)

FG_JSON = os.path.join(HOME, ".config/skystation/geracao-quadros.json")
LSFG_CONF = os.path.join(HOME, ".config/lsfg-vk/conf.toml")
LSFG_ID = "org.freedesktop.Platform.VulkanLayer.lsfgvk"
FG_PREFIXO = "SkyStation: "
NAO_EXE = re.compile(r"unins|redist|vcredist|directx|dxsetup|crashhandler|crashreport|unitycrash|"
                     r"easyanticheat|eac_|battleye|be_service|setup|installer|dotnet|ue4prereq|prereq|"
                     r"cefprocess|webhelper|launcherhelper|eossdk", re.I)


def lossless_dll():
    """O Lossless.dll do seu Lossless Scaling (comprado e baixado pela Steam): na pasta da Steam do
    Flatpak ou numa biblioteca do HD do Windows."""
    cands = [os.path.join(STEAM_DIR, "steamapps/common/Lossless Scaling/Lossless.dll")]
    for lib in bibliotecas().get("steam", []):
        cands.append(os.path.join(lib["ponto"], "steamapps/common/Lossless Scaling/Lossless.dll"))
    return next((c for c in cands if os.path.isfile(c)), "")


def lsfg_instalado():
    return bool(shutil.which("flatpak")) and subprocess.run(
        ["flatpak", "info", LSFG_ID + "//25.08"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def fg_ler():
    try:
        d = json.load(open(FG_JSON))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def exes_do_jogo(gid):
    """Os .exe do jogo (o lsfg-vk liga o perfil quando um deles abre). Exclui instaladores, anti-cheat etc."""
    pastas = []
    if gid.startswith("pc-steam-"):
        appid = gid[len("pc-steam-"):]
        for lib in bibliotecas().get("steam", []) + [{"ponto": STEAM_DIR.rsplit("/steamapps", 1)[0]}]:
            a = acf(os.path.join(lib["ponto"], "steamapps", f"appmanifest_{appid}.acf"))
            if a.get("installdir"):
                pastas.append(os.path.join(lib["ponto"], "steamapps/common", a["installdir"]))
    elif gid.startswith("pc-epic-"):
        info = epic_instalados().get(gid[len("pc-epic-"):]) or {}
        if info.get("install_path"):
            pastas.append(info["install_path"])
        if info.get("executable"):
            pastas.append(("exe", os.path.basename(info["executable"].replace("\\", "/"))))
    elif gid.startswith("pc-gog-"):
        for g in gog_instalados():
            if str(g.get("appName")) == gid[len("pc-gog-"):] and g.get("install_path"):
                pastas.append(g["install_path"])
    nomes = []
    for p in pastas:
        if isinstance(p, tuple):
            nomes.append(p[1])
            continue
        base = p.rstrip("/").count("/")
        for raiz, dirs, arqs in os.walk(p):
            if raiz.count("/") - base >= 4:
                dirs[:] = []
            dirs[:] = [d for d in dirs if not NAO_EXE.search(d) and d.lower() not in ("_commonredist", "redist")]
            for a in arqs:
                if a.lower().endswith(".exe") and not NAO_EXE.search(a):
                    nomes.append(a)
    vistos = []
    for n in nomes:
        if n and n not in vistos:
            vistos.append(n)
    return vistos[:24]


def _toml_str(v):
    return "'" + str(v).replace("'", "") + "'"


def gerar_conf_lsfg():
    """Reescreve ~/.config/lsfg-vk/conf.toml (versão 2): perfis do SkyStation (um por jogo com geração de
    quadros ligada) + os perfis que você criou à mão, que ficam como estavam."""
    outros, global_ = [], {}
    try:
        import tomllib
        with open(LSFG_CONF, "rb") as f:
            atual = tomllib.load(f)
        global_ = atual.get("global", {}) or {}
        outros = [pf for pf in atual.get("profile", []) if not str(pf.get("name", "")).startswith(FG_PREFIXO)]
    except (OSError, ValueError, ImportError):
        pass
    dll = lossless_dll() or global_.get("dll", "")
    linhas = ["# Gerado pelo SkyStation (perfis 'SkyStation: ...'). Perfis com outro nome são mantidos.",
              "version = 2", "", "[global]"]
    if dll:
        linhas.append(f"dll = {_toml_str(dll)}")
    linhas.append(f"allow_fp16 = {'false' if global_.get('allow_fp16') is False else 'true'}")
    perfis = []
    for gid, cfg in sorted(fg_ler().items()):
        mult = int(cfg.get("mult", 0) or 0)
        if mult < 2:
            continue
        exes = exes_do_jogo(gid)
        if not exes:
            continue
        perfis.append({"name": FG_PREFIXO + str(cfg.get("titulo") or gid), "active_in": exes, "multiplier": mult,
                       "flow_scale": float(cfg.get("flow", 0.8)), "performance_mode": bool(cfg.get("perf", True)),
                       "pacing": "none"})
    for pf in perfis + outros:
        linhas += ["", "[[profile]]"]
        for k, v in pf.items():
            if isinstance(v, bool):
                linhas.append(f"{k} = {'true' if v else 'false'}")
            elif isinstance(v, (int, float)):
                linhas.append(f"{k} = {v}")
            elif isinstance(v, list):
                linhas.append(f"{k} = [" + ", ".join(_toml_str(x) for x in v) + "]")
            else:
                linhas.append(f"{k} = {_toml_str(v)}")
    os.makedirs(os.path.dirname(LSFG_CONF), exist_ok=True)
    with open(LSFG_CONF + ".tmp", "w") as f:
        f.write("\n".join(linhas) + "\n")
    os.replace(LSFG_CONF + ".tmp", LSFG_CONF)
    return len(perfis), dll


def fg(gid, mult):
    """Liga (2x, 3x, 4x) ou desliga (0) a geração de quadros de um jogo de PC."""
    d = fg_ler()
    titulo = gid
    try:
        titulo = json.load(open(os.path.join(JOGOS, gid, "game.json"))).get("title", gid)
    except (OSError, ValueError):
        pass
    if mult >= 2:
        d[gid] = {**d.get(gid, {}), "mult": mult, "titulo": titulo}
    else:
        d.pop(gid, None)
    os.makedirs(os.path.dirname(FG_JSON), exist_ok=True)
    with open(FG_JSON + ".tmp", "w") as f:
        json.dump(d, f, ensure_ascii=False, indent=1)
    os.replace(FG_JSON + ".tmp", FG_JSON)
    n, dll = gerar_conf_lsfg()
    aviso = ""
    if mult >= 2:
        if not lsfg_instalado():
            aviso = "Instale a Geração de quadros (Lossless Scaling) na SkyStore, aba Apps."
        elif not dll:
            aviso = "Baixe o Lossless Scaling na Steam (não precisa abrir): o SkyStation usa o arquivo dele."
        elif not exes_do_jogo(gid):
            aviso = "Não achei o executável deste jogo: confira se ele está instalado."
    return {"ok": True, "jogo": gid, "mult": mult, "perfis": n, "dll": dll, "aviso": aviso}


def main():
    # A sessão do SkyStation define QT_QPA_PLATFORM=xcb (para os emuladores feitos em Qt). Um programa
    # Windows feito em Qt, rodando pelo Wine/Proton (ex.: o REDlauncher do The Witcher 3), também lê essa
    # variável, procura um plugin "xcb" que no Windows não existe e fecha com "no Qt platform plugin".
    for v in ("QT_QPA_PLATFORM", "QT_PLUGIN_PATH", "QT_QPA_PLATFORMTHEME", "QT_STYLE_OVERRIDE"):
        os.environ.pop(v, None)
    a = sys.argv[1:]
    cmd = a[0] if a else "estado"
    if cmd == "sincronizar":
        return sincronizar()
    if cmd == "jogar" and len(a) == 3 and a[1] == "steam" and a[2].isdigit():
        return jogar_steam(a[2])
    if cmd == "jogar" and len(a) == 3 and a[1] == "epic" and re.fullmatch(r"[A-Za-z0-9_-]+", a[2]):
        return jogar_epic(a[2])
    if cmd == "steam":
        if not flatpak_tem(STEAM_ID):
            return falha("Instale a Steam pela SkyStore (aba Apps).")
        ajustar_steam(bibliotecas().get("steam", []))
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", STEAM_ID, "-gamepadui"])
    if cmd == "heroic":
        if not flatpak_tem(HEROIC_ID):
            return falha("Instale o Heroic pela SkyStore (aba Apps).")
        os.execvp("flatpak", ["flatpak", "run", "--unset-env=QT_QPA_PLATFORM", HEROIC_ID])
    if cmd == "loja":
        return saida(loja())
    if cmd == "capas":
        return baixar_capas(a[1:])
    if cmd == "instalar" and len(a) == 3 and (a[1] in ("epic", "gog") and re.fullmatch(r"[A-Za-z0-9_-]+", a[2])
                                              or a[1] == "steam" and a[2].isdigit()):
        r = instalar_loja(a[1], a[2])
        _linha(r)
        return 0 if r.get("ok") else 1
    if cmd == "jogar" and len(a) == 3 and a[1] == "gog" and a[2].isdigit():
        return jogar_gog(a[2])
    if cmd == "fg" and len(a) == 3 and re.fullmatch(r"pc-(steam|epic|gog)-[A-Za-z0-9_-]+", a[1]) and a[2] in ("0", "2", "3", "4"):
        return saida(fg(a[1], int(a[2])))
    if cmd == "fg-estado" and len(a) == 2:
        c = fg_ler().get(a[1], {})
        return saida({"ok": True, "mult": int(c.get("mult", 0) or 0), "lsfg": lsfg_instalado(), "dll": lossless_dll()})
    if cmd == "diag":
        return diag()
    if cmd == "estado":
        return saida({"ok": True, **bibliotecas(), "steamInstalada": flatpak_tem(STEAM_ID),
                      "heroicInstalado": flatpak_tem(HEROIC_ID), "t": int(time.time())})
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
