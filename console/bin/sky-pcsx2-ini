#!/usr/bin/env python3
"""SkyStation: aplica o perfil de desempenho no PCSX2.ini antes de cada jogo de PS2.

Só altera as chaves do SkyStation; o resto do arquivo (ajustes que o próprio PCSX2 grava)
é preservado.

Uso: sky-pcsx2-ini <leve|potente> <pasta-skystation> <arquivo-bios> [id-do-jogo]

Fase 5.9: desempenho por jogo (menu Y do jogo), guardado em ~/.config/skystation/ps2-desempenho.json:
  normal  -> PS2 na velocidade real
  rapido  -> EE Cycle Rate -1 + MTVU (o processador do PS2 emulado roda um pouco mais devagar)
  maximo  -> EE Cycle Rate -2 + EE Cycle Skip 1 + MTVU (mais FPS; alguns jogos engasgam ou falham)
"""
import json
import configparser
import os
import sys

profile, sky, bios = sys.argv[1], sys.argv[2], sys.argv[3]
game_id = sys.argv[4] if len(sys.argv) > 4 else ""

# Desempenho por jogo.
SPEED = {
    "normal": {"EECycleRate": "0", "EECycleSkip": "0"},
    "rapido": {"EECycleRate": "-1", "EECycleSkip": "0"},
    "maximo": {"EECycleRate": "-2", "EECycleSkip": "1"},
}
try:
    with open(os.path.expanduser("~/.config/skystation/ps2-desempenho.json")) as f:
        speed = json.load(f).get(game_id, "auto")
except (OSError, ValueError, AttributeError):
    speed = "auto"
# Fase 6.5 — "Automático": jogos conhecidos por exigir muito do PS2 já abrem em Rápido.
PESADOS = ("need for speed", "gran turismo", "god of war", "shadow of the colossus", "burnout", "metal gear solid",
           "ratchet", "jak ", "jak and", "black", "midnight club", "tekken 5", "soulcalibur", "final fantasy xii",
           "ace combat", "killzone", "driv3r", "true crime", "the getaway", "mercenaries", "juiced", "test drive", "guitar hero", "rock band")
if speed == "auto":
    nome = game_id.lower()
    speed = "rapido" if any(p in nome for p in PESADOS) else "normal"

# Renderer do PCSX2: 12 = OpenGL, 14 = Vulkan.
# HD 4400 (notebook): OpenGL é o driver maduro; o Vulkan dessa geração é incompleto.
# Ryzen (potente): Vulkan via RADV é o melhor caminho.
PROFILES = {
    # Fase 6.1: mistura de cores no mínimo e sem pontilhado: menos trabalho para a HD 4400
    # Fase 7.3 testou texturas parciais, sem mipmap, leitura sem espera e mesa_glthread no Guitar Hero 3:
    # a velocidade não mudou (54-58%) e a thread GS ficou mais ocupada (75% -> 96%). Desfeito: padrões do PCSX2.
    "leve": {"Renderer": "12", "upscale_multiplier": "1", "accurate_blending_unit": "0", "dithering_ps2": "0",
             "texture_preloading": "2", "hw_mipmap": "true"},
    "potente": {"Renderer": "14", "upscale_multiplier": "2", "texture_preloading": "2", "hw_mipmap": "true"},
}

ini_dir = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "PCSX2", "inis")
os.makedirs(ini_dir, exist_ok=True)
path = os.path.join(ini_dir, "PCSX2.ini")

cp = configparser.ConfigParser(interpolation=None, strict=False)
cp.optionxform = str  # o PCSX2 diferencia maiúsculas nas chaves
if os.path.exists(path):
    cp.read(path, encoding="utf-8")


def put(section, key, value):
    if not cp.has_section(section):
        cp.add_section(section)
    cp.set(section, key, value)


put("UI", "SetupWizardIncomplete", "false")
put("UI", "StartFullscreen", "true")
put("UI", "ConfirmShutdown", "false")
put("UI", "HideMouseCursor", "true")
put("Folders", "Bios", os.path.join(sky, "bios", "ps2"))
put("Folders", "MemoryCards", os.path.join(sky, "saves", "ps2"))
put("Folders", "Savestates", os.path.join(sky, "states", "ps2"))
put("Filenames", "BIOS", bios)
for k, v in PROFILES.get(profile, PROFILES["leve"]).items():
    put("EmuCore/GS", k, v)
for k, v in SPEED.get(speed, SPEED["normal"]).items():
    put("EmuCore/Speedhacks", k, v)
# MTVU (VU1 numa thread própria): padrão do PCSX2 é desligado; nos modos rápido/máximo liga se
# houver 4 threads (o i5-4200U tem 2 núcleos + hyperthreading).
# Medição de FPS ligada no menu: o PCSX2 mostra velocidade e uso de EE/GS/VU e da placa de vídeo
# no canto da tela. É o que diz onde está o gargalo de cada jogo.
medir = os.path.exists(os.path.expanduser("~/.config/skystation/mangohud.on"))
for k in ("OsdShowSpeed", "OsdShowFPS", "OsdShowCPU", "OsdShowGPU", "OsdShowResolution"):
    put("EmuCore/GS", k, "true" if medir else "false")
# Leitura de volta da placa de vídeo no padrão (o teste com "sem esperar" não ajudou; ver acima).
put("EmuCore/GS", "HWDownloadMode", "0")
# Thread separada para a VU (cálculo 3D): no notebook antigo só nos modos Rápido/Máximo;
# com 8+ threads (Ryzen) fica sempre ligada — medido no Lenovo: Normal sem ela 84%, Rápido com ela 99%.
ncpu = os.cpu_count() or 1
put("EmuCore/Speedhacks", "vuThread", "true" if ncpu >= 8 or (speed != "normal" and ncpu >= 4) else "false")

# Controle: o PCSX2 lê controles pelo SDL. Se o Jogador 1 ainda não tem controle mapeado,
# aplica o mapeamento padrão de "controle de videogame" do SDL (DS4, DualSense, Xbox, 8BitDo...).
# Se o usuário remapear pelo PCSX2, as escolhas dele ficam (só mexemos quando não há SDL nenhum).
put("InputSources", "SDL", "true")
SDL_PAD = {
    "Type": "DualShock2",
    "Up": "SDL-0/DPadUp", "Down": "SDL-0/DPadDown", "Left": "SDL-0/DPadLeft", "Right": "SDL-0/DPadRight",
    "Cross": "SDL-0/FaceSouth", "Circle": "SDL-0/FaceEast", "Square": "SDL-0/FaceWest", "Triangle": "SDL-0/FaceNorth",
    "L1": "SDL-0/LeftShoulder", "R1": "SDL-0/RightShoulder",
    "L2": "SDL-0/+LeftTrigger", "R2": "SDL-0/+RightTrigger",
    "L3": "SDL-0/LeftStick", "R3": "SDL-0/RightStick",
    "Select": "SDL-0/Back", "Start": "SDL-0/Start",
    "LUp": "SDL-0/-LeftY", "LDown": "SDL-0/+LeftY", "LLeft": "SDL-0/-LeftX", "LRight": "SDL-0/+LeftX",
    "RUp": "SDL-0/-RightY", "RDown": "SDL-0/+RightY", "RLeft": "SDL-0/-RightX", "RRight": "SDL-0/+RightX",
    "SmallMotor": "SDL-0/SmallMotor", "LargeMotor": "SDL-0/LargeMotor",
}
pad = dict(cp.items("Pad1")) if cp.has_section("Pad1") else {}
if not any(str(v).startswith("SDL-") for v in pad.values()):
    for k, v in SDL_PAD.items():
        put("Pad1", k, v)

tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    cp.write(f, space_around_delimiters=True)
os.replace(tmp, path)  # troca atômica: um desligamento no meio não corrompe a config
