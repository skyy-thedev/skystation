#!/usr/bin/env python3
"""SkyStation: aplica o perfil de desempenho no PCSX2.ini antes de cada jogo de PS2.

Só altera as chaves do SkyStation; o resto do arquivo (ajustes que o próprio PCSX2 grava)
é preservado.

Uso: sky-pcsx2-ini <leve|potente> <pasta-skystation> <arquivo-bios>
"""
import configparser
import os
import sys

profile, sky, bios = sys.argv[1], sys.argv[2], sys.argv[3]

# Renderer do PCSX2: 12 = OpenGL, 14 = Vulkan.
# HD 4400 (notebook): OpenGL é o driver maduro; o Vulkan dessa geração é incompleto.
# Ryzen (potente): Vulkan via RADV é o melhor caminho.
PROFILES = {
    "leve": {"Renderer": "12", "upscale_multiplier": "1"},
    "potente": {"Renderer": "14", "upscale_multiplier": "2"},
}

ini_dir = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "PCSX2", "inis")
os.makedirs(ini_dir, exist_ok=True)
path = os.path.join(ini_dir, "PCSX2.ini")

cp = configparser.ConfigParser(interpolation=None, strict=False)
cp.optionxform = str  # o PCSX2 diferencia maiúsculas nas chaves
if os.path.exists(path):
    cp.read(path, encoding="utf-8")


def put(section, key, value):
    if not cp.has_section(section):
        cp.add_section(section)
    cp.set(section, key, value)


put("UI", "SetupWizardIncomplete", "false")
put("UI", "StartFullscreen", "true")
put("UI", "ConfirmShutdown", "false")
put("UI", "HideMouseCursor", "true")
put("Folders", "Bios", os.path.join(sky, "bios", "ps2"))
put("Folders", "MemoryCards", os.path.join(sky, "saves", "ps2"))
put("Folders", "Savestates", os.path.join(sky, "states", "ps2"))
put("Filenames", "BIOS", bios)
for k, v in PROFILES.get(profile, PROFILES["leve"]).items():
    put("EmuCore/GS", k, v)

# Controle: o PCSX2 lê controles pelo SDL. Se o Jogador 1 ainda não tem controle mapeado,
# aplica o mapeamento padrão de "controle de videogame" do SDL (DS4, DualSense, Xbox, 8BitDo...).
# Se o usuário remapear pelo PCSX2, as escolhas dele ficam (só mexemos quando não há SDL nenhum).
put("InputSources", "SDL", "true")
SDL_PAD = {
    "Type": "DualShock2",
    "Up": "SDL-0/DPadUp", "Down": "SDL-0/DPadDown", "Left": "SDL-0/DPadLeft", "Right": "SDL-0/DPadRight",
    "Cross": "SDL-0/FaceSouth", "Circle": "SDL-0/FaceEast", "Square": "SDL-0/FaceWest", "Triangle": "SDL-0/FaceNorth",
    "L1": "SDL-0/LeftShoulder", "R1": "SDL-0/RightShoulder",
    "L2": "SDL-0/+LeftTrigger", "R2": "SDL-0/+RightTrigger",
    "L3": "SDL-0/LeftStick", "R3": "SDL-0/RightStick",
    "Select": "SDL-0/Back", "Start": "SDL-0/Start",
    "LUp": "SDL-0/-LeftY", "LDown": "SDL-0/+LeftY", "LLeft": "SDL-0/-LeftX", "LRight": "SDL-0/+LeftX",
    "RUp": "SDL-0/-RightY", "RDown": "SDL-0/+RightY", "RLeft": "SDL-0/-RightX", "RRight": "SDL-0/+RightX",
    "SmallMotor": "SDL-0/SmallMotor", "LargeMotor": "SDL-0/LargeMotor",
}
pad = dict(cp.items("Pad1")) if cp.has_section("Pad1") else {}
if not any(str(v).startswith("SDL-") for v in pad.values()):
    for k, v in SDL_PAD.items():
        put("Pad1", k, v)

tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    cp.write(f, space_around_delimiters=True)
os.replace(tmp, path)  # troca atômica: um desligamento no meio não corrompe a config
